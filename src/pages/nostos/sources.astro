---
// Nostos, sources (tasks/nostos.md, step 5): the talks and writings everything in Nostos is drawn
// from, as two lists (src/components/WorkList.astro, shared with the main Work & Press page), each item
// linked to the ideas it holds on the map. Not in the sitemap and noindex until launch.
import Base from '../../layouts/Base.astro';
import NostosNav from '../../components/nostos/NostosNav.astro';
import { nostosUi } from '../../data/nostos/ui';
import WorkList from '../../components/WorkList.astro';
import { getLocale, mainLocale } from '../../lib/locale';

const t = nostosUi[mainLocale(getLocale(Astro.url))].sources;
---

<Base title={`${t.metaTitle} | ATHENOA`} description={t.metaDescription} noindex>
  <NostosNav />
  {/* (its title and introduction are no longer shown, at the client's request: the title is kept for
      screen readers) */}
  <h1 class="visually-hidden">{t.title}</h1>

  <WorkList ideas />
</Base>
