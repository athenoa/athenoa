---
// Membership of the Academy: the old athenoa.academy/melos (whose address leads here). Athena's
// questions, what membership offers, then the two ways to pay for a year on a blue arch, drawn by the
// same component as a course's (TuitionTiers.astro), each with its Stripe Payment Links.
// The same file renders /membership/ (Greek), /en/membership/ and /grc/membership/: the copy follows
// the address. All its words are in src/data/membership.ts and src/data/el/membership.ts.
import Base from '../layouts/Base.astro';
import Illustration from '../components/Illustration.astro';
import Media from '../components/Media.astro';
import Bees from '../components/membership/Bees.astro';
import bannerDay from '../assets/media/membership-banner-day.jpg';
import TuitionTiers from '../components/courses/TuitionTiers.astro';
import { content } from '../data';
import { membershipFor } from '../data/membership';
import { getLocale } from '../lib/locale';

const locale = getLocale(Astro.url);
const { site, coursesPage } = content(locale);
// the words of the two ways of paying, the same as a course's
const { tuition } = coursesPage.ui;
const m = membershipFor(locale);
const reg = m.registration;
const discount = reg.upfrontDiscount ?? 0;
// The Academy's membership banner (Maria, 22 November 2026): crème by day, navy by night; only the one
// for the current theme is shown, and a hidden lazy picture is never fetched.
const bannerAlt = {
  en: 'Banner: “Φιλόσοφος γίνου” (Become a philosopher). Become an annual Member of the Academy',
  el: 'Αφίσα: «Φιλόσοφος γίνου». Γίνε ετήσιο Μέλος της Ακαδημίας',
  grc: 'Αφίσα: «Φιλόσοφος γίνου». Γίνε ετήσιο Μέλος της Ακαδημίας',
}[locale];
---

<Base title={`${m.title} | ${site.name}`} description={m.description} image={bannerDay} imageAlt={bannerAlt}>
  <section class="mem section">
    <div class="wrap">
      <header class="mem__head">
        {/* the banner's motto as an eyebrow over the title; the banner itself is gone from the page
            (it repeated the page), and is kept only as the link preview (Maria, 23 November 2026) */}
        <p class="mem__eyebrow" lang="el">“Φιλόσοφος γίνου”</p>
        <h1 class="t-hero" data-split>{m.title}</h1>
        {/* Bees over a light blue pebble, in place of the tetractys (Maria, 22 November 2026); now and then
            one crosses the window or settles on the page for a while (Bees.astro) */}
        <Bees class="mem__mark" />
        {/* Athena's questions, as the lead of the home page's membership section (in the reading face:
            they name Socrates and Plato, whom the handwriting's sentence case would lower) */}
        <div class="mem__questions" data-reveal-group style="--delay:450ms">
          {m.questions.map((question) => <p class="lead">{question}</p>)}
        </div>
        {/* the 'Εγγραφή' button under the questions was removed (Maria, 23 November 2026) */}
      </header>


      <div class="mem__text box box--offset on-blue-light" data-reveal>
        <div class="prose">
          <p class="mem__lead">{m.lead}</p>
          {m.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <p>
            {m.more} <a href={site.membershipForm}>{m.formLink}</a>
          </p>
        </div>
      </div>

      <section class="reg panel panel--arch on-blue" id="registration" aria-labelledby="registration-title">
        <Illustration name="laurel" class="reg__laurel" draw />
        <div class="reg__grid">
          <hgroup class="reg__head" data-reveal>
            <h2 class="reg__title t-2" id="registration-title">{reg.label}</h2>
          </hgroup>
          <div class="reg__body" data-reveal style="--i:1">
            <TuitionTiers
              tiers={reg.tiers}
              discount={discount}
              off={tuition.off}
              payInFull={reg.payInFull}
              payMonthly={reg.payMonthly}
              month={tuition.month}
              per={reg.per}
              or={tuition.or}
              payments={tuition.payments}
              total={tuition.total}
            />
            <div class="reg__notes">{reg.notes.map((note) => <p class="reg__note">{note}</p>)}</div>
          </div>
        </div>
      </section>
    </div>
  </section>
</Base>

<style>
  .mem__eyebrow {
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    margin: 0 0 -0.4rem;
    font-family: var(--font-title);
    font-style: italic;
    font-size: var(--step-0);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ink-strong);
  }
  .mem {
    padding-block: calc(var(--space-l) + 0.5rem) var(--space-xl);
    overflow-x: clip;
  }
  /* Title and symbol side by side, Athena's questions under them (the courses page's header) */
  .mem__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-s) clamp(0.75rem, 3vw, 1.75rem);
    margin-bottom: var(--space-l);
  }
  /* the motto over the title, the hive beside both */
  .mem__head h1 {
    grid-column: 1;
    grid-row: 2;
  }
  .mem__head .mem__mark {
    grid-row: 1 / span 2;
  }
  .mem__head h1:lang(el) {
    font-size: calc(clamp(3.4rem, 1.4rem + 9.6vw, 11.5rem) * 0.86);
  }
  .mem__mark {
    --mark: clamp(3.5rem, 1rem + 12vw, 10rem);
    position: relative;
    isolation: isolate;
    grid-column: 2;
    grid-row: 1;
    width: var(--mark);
    margin: calc(var(--mark) * 0.24);
  }
  .mem__mark::before {
    content: '';
    position: absolute;
    inset: -24%;
    z-index: -1;
    border-radius: var(--r-pebble-1);
    background-color: var(--blue-light);
    background-image: var(--grain);
    background-size: 400px 400px;
    filter: url(#rough-sm);
  }
  /* on arrival the pebble swells into place, then the bees fly in to it (Bees.astro) */
  @keyframes mem-pebble {
    from {
      opacity: 0;
      transform: scale(0.6) rotate(-8deg);
    }
  }
  :global(html.motion) .mem__mark::before {
    animation: mem-pebble 0.9s cubic-bezier(0.3, 0.7, 0.3, 1) 0.15s both;
  }
  .mem__questions,
  .mem__go {
    grid-column: 1 / -1;
  }
  /* the questions run as wide as the title above them (Maria, 22 November 2026) */
  .mem__questions :global(.lead) {
    max-width: none;
  }
  .mem__questions {
    display: grid;
    gap: 0.6rem;
    /* half the page wide on desktop, as wide as the title's span (Maria, 23 November 2026) */
    max-width: max(46ch, 50vw);
  }
  /* its outline goes evenly all round, not offset (Maria, 23 November 2026) */
  .mem__text::after {
    inset: -0.6rem;
    border-radius: var(--box-r, var(--r-soft));
  }
  .mem__text {
    max-width: 50rem;
    margin-inline: auto;
  }
  .mem__lead {
    font-size: var(--step-1);
    line-height: 1.3;
  }

  /* The ways to pay: a blue arch, the laurel in its crown (as on a course page) */
  /* the arch as wide as the content, so the two tiers stand side by side as on a course page */
  .reg {
    max-width: none;
    padding-inline: clamp(1rem, 0.4rem + 2.6vw, 3rem);
    margin: var(--space-xl) auto 0;
    padding-top: var(--space-l);
  }
  .reg__laurel {
    width: clamp(6rem, 16vw, 9.5rem);
    margin: 0 auto var(--space-l);
  }
  .reg__grid {
    display: grid;
    gap: var(--space-m);
    align-items: start;
  }
  /* the heading centred in the arch, under the laurel (Maria, 22 November 2026) */
  .reg__head {
    container-type: inline-size;
    text-align: center;
  }
  .reg__title {
    font-size: min(var(--step-3), 20cqi);
  }
  .reg__title:lang(el) {
    font-size: min(var(--step-3), 14.5cqi);
  }
  .reg__body {
    display: grid;
    gap: var(--space-m);
  }
  .reg__notes {
    display: grid;
    gap: 0.5rem;
  }
  .reg__note {
    font-size: var(--step--1);
  }
  @media (min-width: 60rem) {
    .mem__questions {
      grid-column: 1;
    }
    .mem__mark {
      grid-row: 1 / span 2;
    }
  }
</style>
