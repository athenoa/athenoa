---
// Membership of the Academy: the old athenoa.academy/melos (whose address leads here). Athena's
// questions, what membership offers, then the two ways to pay for a year on a blue arch, drawn by the
// same component as a course's (TuitionTiers.astro), each with its Stripe Payment Links.
// The same file renders /membership/ (Greek), /en/membership/ and /grc/membership/: the copy follows
// the address. All its words are in src/data/membership.ts and src/data/el/membership.ts.
import Base from '../layouts/Base.astro';
import Illustration from '../components/Illustration.astro';
import Signature from '../components/Signature.astro';
import Bees from '../components/membership/Bees.astro';
import Media from '../components/Media.astro';
import portrait from '../assets/media/portrait-sea.jpg';
import bannerDay from '../assets/media/membership-banner-day.jpg';
import TuitionTiers from '../components/courses/TuitionTiers.astro';
import RegisterDialog from '../components/courses/RegisterDialog.astro';
import { memberCourse } from '../data/membership';
import { content } from '../data';
import { membershipFor } from '../data/membership';
import { getLocale } from '../lib/locale';

const locale = getLocale(Astro.url);
const { site, coursesPage } = content(locale);
// the words of the two ways of paying, the same as a course's
const { tuition } = coursesPage.ui;
const m = membershipFor(locale);
const reg = m.registration;
const athena = {
  el: { alt: 'Η Δρ. Αθηνά Πόταρη πάνω από ένα ανοιχτό βιβλίο, με τη θάλασσα πίσω της', quote: 'Σας περιμένω με χαρά και ενθουσιασμό σε ένα Νέο Μυητικό Ταξίδι', name: 'Δρ. Αθηνά Δέσποινα Πόταρη', questions: 'Για ερωτήσεις, γράψτε μας στο' },
  en: { alt: 'Dr. Athena Potari over an open book, the sea behind her', quote: 'I await you with joy and enthusiasm on a New Initiatic Journey', name: 'Dr. Athena Despoina Potari', questions: 'For any questions, write to us at' },
  grc: { alt: 'Ἡ διδάσκαλος Ἀθηνᾶ Πόταρη ὑπὲρ βίβλου ἀνεῳγμένης, ὄπισθεν δ’ αὐτῆς ἡ θάλαττα', quote: 'Μετὰ χαρᾶς καὶ ἐνθουσιασμοῦ ὑμᾶς ἀναμένω εἰς Νέαν Μυστικὴν Ὁδόν', name: 'Ἀθηνᾶ Δέσποινα Πόταρη', questions: 'Εἴ τι ἀπορεῖτε, ἐπιστείλατε ἡμῖν πρὸς' },
}[locale];
const discount = reg.upfrontDiscount ?? 0;
// The Academy's membership banner (Maria, 22 November 2026): crème by day, navy by night; only the one
// for the current theme is shown, and a hidden lazy picture is never fetched.
const bannerAlt = {
  en: 'Banner: “Φιλόσοφος γίνου” (Become a philosopher). Become an annual Member of the Academy',
  el: 'Αφίσα: «Φιλόσοφος γίνου». Γίνε ετήσιο Μέλος της Ακαδημίας',
  grc: 'Πίναξ: «Φιλόσοφος γίνου». Γένεσθε ἑταῖροι τῆς Ἀκαδημίας ἐπ’ ἐνιαυτόν',
}[locale];
---

<Base title={`${m.title} | ${site.name}`} description={m.description} image={bannerDay} imageAlt={bannerAlt}>
  <section class="mem section">
    <div class="wrap">
      <header class="mem__head">
        {/* the banner's motto as an eyebrow over the title; the banner itself is gone from the page
            (it repeated the page), and is kept only as the link preview (Maria, 23 November 2026) */}
        <p class="mem__eyebrow" lang="el">“Φιλόσοφος γίνου”</p>
        <h1 class="t-1" data-split>{m.title}</h1>
        {/* The goddess on her plinth, the statue from the home page's hero, in place of the bees
            (Athena, 23 November 2026: "a symbol like the temple or the goddess"). No pebble behind her. */}
        <div class="mem__mark" data-reveal="fade"><Illustration name="portal-b-statue" draw /></div>
        {/* now and then a bee crosses the page or settles on something for a moment (Maria, 23 November
            2026: back without the hive; Athena asked only for the goddess in its place) */}
        <Bees class="mem__visitors" />
        {/* Athena's questions, as the lead of the home page's membership section (in the reading face:
            they name Socrates and Plato, whom the handwriting's sentence case would lower) */}
        <div class="mem__questions" data-reveal-group style="--delay:450ms">
          {m.questions.map((question) => <p class="lead">{question}</p>)}
        </div>
        {/* the 'Εγγραφή' button under the questions was removed (Maria, 23 November 2026) */}
      </header>


      <div class="mem__text box on-blue" data-reveal>
        <div class="prose">
          <p class="mem__lead">{m.lead}</p>
          {m.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <ul class="mem__benefits" role="list">
            {m.benefits.map((benefit) => (
              <li>
                <Illustration name={benefit.icon} class="mem__icon" note={false} />
                <span set:html={benefit.text} />
              </li>
            ))}
          </ul>
        </div>
        {/* Athena herself after the words (on the right, and at the foot on phones), in an organic frame, with her own line from the home page
            (Maria, 23 November 2026: warmer and more personal) */}
        <figure class="mem__athena">
          <Media src={portrait} alt={athena.alt} shape="pebble-1" ratio="1 / 1" focus="50% 30%" widths={[320, 480, 640]} sizes="(min-width: 60rem) 18rem, 60vw" />
          <blockquote class="mem__quote">
            <p>“{athena.quote}”</p>
            {/* her own hand under her words (Maria, 23 November 2026) */}
            <Signature class="mem__sign" />
            <cite>{athena.name}</cite>
          </blockquote>
        </figure>
      </div>

      <section class="reg panel panel--arch on-blue" id="registration" aria-labelledby="registration-title">
        <Illustration name="laurel" class="reg__laurel" draw />
        <div class="reg__grid">
          <hgroup class="reg__head" data-reveal>
            <h2 class="reg__title t-2" id="registration-title">{reg.label}</h2>
          </hgroup>
          <div class="reg__body" data-reveal style="--i:1">
            <TuitionTiers
              tiers={reg.tiers}
              discount={discount}
              off={tuition.off}
              payInFull={reg.payInFull}
              payMonthly={reg.payMonthly}
              month={tuition.month}
              per={reg.per}
              or={tuition.or}
              payments={tuition.payments}
              total={tuition.total}
              course="membership"
            />
            {/* the payment terms in a closed item, as on the course pages (Maria, 23 November 2026) */}
            <details class="more__item">
              <summary>
                <span class="more__title">{reg.notesTitle}</span>
                <svg class="more__mark" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                  <path d="M4 12.3c5-.9 11-.6 16-.4" />
                  <path class="more__mark-v" d="M12.2 4c-.6 5-.5 11 0 16" />
                </svg>
              </summary>
              <div class="more__body prose">
                {reg.notes.map((note) => <p>{note}</p>)}
                <p>{athena.questions} <a href={`mailto:${site.emails[0]}`}>{site.emails[0]}</a></p>
              </div>
            </details>
          </div>
        </div>
      </section>
    </div>
  </section>
  {/* the membership registration, like a course's but with no certificate (Maria, 23 November 2026) */}
  <RegisterDialog course={memberCourse(locale)} certificate={false} kicker={m.formKicker} />
</Base>

<style>
  /* the bold words of the benefits in gold, for more emphasis (Maria, 23 November 2026: a try) */
  .mem__benefits :global(strong) {
    color: var(--gold);
  }
  .mem__eyebrow {
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    margin: 0 0 -0.4rem;
    font-family: var(--font-title);
    font-style: italic;
    font-size: var(--step-0);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ink-strong);
  }
  .mem {
    padding-block: calc(var(--space-l) + 0.5rem) var(--space-xl);
    overflow-x: clip;
  }
  /* Title and symbol side by side, Athena's questions under them (the courses page's header) */
  .mem__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-s) clamp(0.75rem, 3vw, 1.75rem);
    margin-bottom: var(--space-l);
  }
  /* the motto over the title, the hive beside both */
  .mem__head h1 {
    grid-column: 1;
    grid-row: 2;
  }
  .mem__head .mem__mark {
    grid-row: 1 / span 2;
  }
  /* (the title at the course pages' size, t-1: Maria, 23 November 2026) */
  .mem__mark {
    --mark: clamp(4rem, 2rem + 9vw, 9rem);
    position: relative;
    grid-column: 2;
    grid-row: 1;
    align-self: end;
    width: var(--mark);
    color: var(--blue);
  }
  .mem__mark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .mem__questions,
  .mem__go {
    grid-column: 1 / -1;
  }
  /* the questions run as wide as the title above them (Maria, 22 November 2026) */
  .mem__questions :global(.lead) {
    max-width: none;
  }
  .mem__questions {
    display: grid;
    gap: 0.6rem;
    /* half the page wide on desktop, as wide as the title's span (Maria, 23 November 2026) */
    max-width: max(46ch, 50vw);
  }
  /* its outline goes evenly all round, not offset (Maria, 23 November 2026) */
  .mem__text::after {
    inset: -0.6rem;
    border-radius: var(--box-r, var(--r-soft));
  }
  /* Athena beside the words: her picture in a pebble with a fine outline, her line under it */
  .mem__text {
    display: grid;
    gap: var(--space-m);
    align-items: center;
  }
  .mem__athena {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: var(--space-s);
  }
  .mem__athena :global(.media) {
    width: min(100%, 15rem);
  }
  /* what membership gives: a list, each line with a small drawing on a light pebble */
  .mem__benefits {
    display: grid;
    gap: 0.85rem;
    margin: var(--space-s) 0 0;
    padding: 0;
    list-style: none;
  }
  .mem__benefits li {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
    align-items: center;
    gap: 0.9rem;
    margin: 0;
  }
  .mem__benefits li::before {
    content: none;
  }
  /* the symbol alone, no pebble behind it (Maria, 23 November 2026) */
  .mem__benefits :global(.mem__icon) {
    width: 2.6rem;
    height: 2.6rem;
    color: var(--ink-strong);
  }
  .mem__benefits :global(.mem__icon svg) {
    width: 100%;
    height: 100%;
  }
  /* Athena's photograph and words sit at the foot of the box, level with the end of the list (Maria) */
  .mem__athena {
    align-self: end;
  }
  /* only the visiting bees: no hive and no swarm of its own */
  .mem__head :global(.mem__visitors) {
    position: absolute;
    width: 0;
    height: 0;
    overflow: visible;
  }
  .mem__head :global(.mem__visitors .hive),
  .mem__head :global(.mem__visitors .bee--swarm) {
    display: none;
  }
  .mem__quote :global(.mem__sign) {
    display: block;
    width: 8rem;
    margin: 0.5rem auto 0.2rem;
  }
  .mem__quote {
    margin: 0;
    text-align: center;
  }
  .mem__quote p {
    margin: 0;
    font-family: var(--font-hand);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--ink-strong);
  }
  .mem__quote cite {
    display: block;
    margin-top: 0.4rem;
    font-style: normal;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  @media (min-width: 52rem) {
    .mem__text {
      grid-template-columns: minmax(0, 1fr) minmax(0, 17rem);
      gap: var(--space-l);
    }
  }
  /* the closed item under the prices */
  .more__item {
    margin-top: var(--space-m);
    border: 1.5px solid var(--line);
    border-radius: 1.4rem 1.7rem 1.5rem 1.8rem / 1.7rem 1.4rem 1.8rem 1.5rem;
  }
  .more__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem 0.85rem 1.25rem;
    list-style: none;
    cursor: pointer;
    border-radius: inherit;
  }
  .more__item summary::-webkit-details-marker {
    display: none;
  }
  .more__title {
    font-weight: 560;
  }
  .more__mark {
    flex: none;
  }
  .more__mark path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    transform-origin: 12px 12px;
    transition:
      transform var(--dur-2) var(--ease-out),
      opacity var(--dur-1);
  }
  .more__item[open] .more__mark-v {
    transform: rotate(90deg);
    opacity: 0;
  }
  .more__body {
    padding: 0 1.25rem 1.25rem;
    font-size: var(--step--1);
  }
  .mem__text {
    max-width: 50rem;
    margin-inline: auto;
  }
  .mem__lead {
    font-size: var(--step-1);
    line-height: 1.3;
  }

  /* The ways to pay: a blue arch, the laurel in its crown (as on a course page) */
  /* the arch as wide as the content, so the two tiers stand side by side as on a course page */
  .reg {
    max-width: none;
    padding-inline: clamp(1rem, 0.4rem + 2.6vw, 3rem);
    margin: var(--space-xl) auto 0;
    padding-top: var(--space-l);
  }
  /* the laurel's leaves filled with gold, its lines as before (Maria for Athena, 23 November 2026) */
  .reg__laurel {
    --leaf: var(--gold);
  }
  .reg__laurel {
    width: clamp(6rem, 16vw, 9.5rem);
    margin: 0 auto var(--space-l);
  }
  .reg__grid {
    display: grid;
    gap: var(--space-m);
    align-items: start;
  }
  /* the heading centred in the arch, under the laurel (Maria, 22 November 2026) */
  .reg__head {
    container-type: inline-size;
    text-align: center;
  }
  .reg__title {
    font-size: min(var(--step-3), 20cqi);
  }
  .reg__title:lang(el) {
    font-size: min(var(--step-3), 14.5cqi);
  }
  .reg__body {
    display: grid;
    gap: var(--space-m);
  }
  .reg__notes {
    display: grid;
    gap: 0.5rem;
  }
  .reg__note {
    font-size: var(--step--1);
  }
  @media (min-width: 60rem) {
    .mem__questions {
      grid-column: 1;
    }
    .mem__mark {
      grid-row: 1 / span 2;
    }
  }
</style>
