---
// One page per course: the same content as the popup, laid out to be read (and crawled) in full.
// The same file renders /courses/<slug>/, /el/courses/<slug>/ and /grc/courses/<slug>/: the copy follows the address.
import Base from '../../layouts/Base.astro';
import Illustration from '../../components/Illustration.astro';
import CourseBody from '../../components/courses/CourseBody.astro';
import RegistrationInfo from '../../components/courses/RegistrationInfo.astro';
import RegisterDialog from '../../components/courses/RegisterDialog.astro';
import { courseImage } from '../../components/courses/media';
import { trail } from '../../components/courses/trail';
import { content } from '../../data';
import { courses as allCourses, type Course } from '../../data/courses';
import { breadcrumbSchema, courseSchema } from '../../data/schema';
import { getLocale } from '../../lib/locale';

// Slugs are the same in both languages.
export function getStaticPaths() {
  return allCourses.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}

interface Props {
  course: Course;
}
const locale = getLocale(Astro.url);
const { courses, coursePageHref, coursesPage, registrationTab, site } = content(locale);
// The route hands over the English course; the page shows the one with the same slug in its own language.
const course = courses.find((item) => item.slug === Astro.props.course.slug) ?? Astro.props.course;
// the trail stays in the search data only; the visible breadcrumbs were removed (Maria, 22 November 2026)
const crumbs = trail(locale);
const canEnrol = course.available && Boolean(course.tuition?.length);
---

<Base
  title={`${course.subtitle ? `${course.title}: ${course.subtitle}` : course.title} | ${site.name}`}
  description={course.summary ?? `${course.title}. ${coursesPage.ui.placeholderNote}`}
  image={courseImage(course.image)}
  imageAlt={course.imageAlt}
  schema={[
    courseSchema(course),
    breadcrumbSchema([...crumbs, { name: course.title, path: coursePageHref(course.slug) }]),
  ]}
>
  <article class="course section">
    <div class="wrap">
      <CourseBody course={course} variant="page" />

      {
        canEnrol && (
          <section class="reg panel panel--arch on-blue" id={registrationTab.id} aria-labelledby="registration-title">
            <Illustration name="laurel" class="reg__laurel" draw />
            <div class="reg__grid">
              <hgroup class="reg__head" data-reveal>
                <h2 class="reg__title t-2" id="registration-title">
                  {registrationTab.label}
                </h2>
              </hgroup>
              <div class="reg__body" data-reveal style="--i:1">
                <RegistrationInfo course={course} />
              </div>
            </div>
          </section>
        )
      }
      {/* The registration form the tier buttons open */}
      {canEnrol && <RegisterDialog course={course} />}
      {/* A last line in Athena's voice (the live ΟΔΥΣΣΕΙΑ page ends on Cavafy's Ithaca) */}
      {
        course.closing && (
          <div class="course__voyage" data-reveal>
            {/* The voyage drawn around Cavafy's Ithaca (Maria, 23 November 2026): the boat setting out, the
                island waiting, a star to steer by, the sea beneath */}
            <Illustration name="hero-a-star" class="voyage__star" draw data-depth="0.12" />
            <Illustration name="sea-boat" class="voyage__boat" draw data-depth="-0.06" />
            <div class="prose course__closing">
              <blockquote>
                <p>{course.closing}</p>
              </blockquote>
            </div>
            <Illustration name="sea-island" class="voyage__island" draw data-depth="0.06" />
            <Illustration name="waves" class="voyage__waves" draw />
          </div>
        )
      }
      {/* The way into Nostos (NostosInvite) is hidden for the launch (Maria, 22 November 2026) */}
    </div>
  </article>
</Base>

<style>
  .course {
    padding-top: var(--space-m);
    /* The sun rays behind the picture run past the page edge */
    overflow-x: clip;
  }

  /* Registration: a blue arch, the laurel in its crown, the ways to pay inside */
  .reg {
    max-width: 66rem;
    margin: var(--space-xl) auto 0;
    padding-top: var(--space-l);
  }
  .reg__laurel {
    width: clamp(6rem, 16vw, 9.5rem);
    margin: 0 auto var(--space-l);
  }
  .reg__grid {
    display: grid;
    gap: var(--space-m);
    align-items: start;
  }
  /* The heading never outgrows its column: its longest word ("Registration") still fits */
  /* the heading centred in the arch, under the laurel (Maria, 22 November 2026) */
  .reg__head {
    container-type: inline-size;
    text-align: center;
  }
  .reg__title {
    font-size: min(var(--step-3), 20cqi);
  }
  .reg__title:lang(el) {
    font-size: min(var(--step-3), 14.5cqi);
  }
  /* The closing quotation, set like every quotation of the course: the voice face, a thin rule on its left */
  .course__closing {
    max-width: 40rem;
    font-size: var(--step-1);
  }
  /* The voyage: boat on the left, the quotation, Ithaca on the right, a star above, the sea beneath */
  .course__voyage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    gap: var(--space-s);
    margin: var(--space-xl) auto 0;
    /* more room above (Maria, 23 November 2026) */
    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
    color: var(--ink-strong);
  }
  .course__voyage :global(.voyage__boat) {
    width: clamp(5rem, 10vw, 8rem);
    rotate: -4deg;
  }
  .course__voyage :global(.voyage__island) {
    width: clamp(7rem, 14vw, 12rem);
  }
  .course__voyage :global(.voyage__star) {
    position: absolute;
    top: -1.5rem;
    right: 18%;
    width: clamp(1.6rem, 3vw, 2.4rem);
  }
  .course__voyage :global(.voyage__waves) {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: min(100%, 54rem);
    translate: -50% 0;
    opacity: 0.55;
  }
  /* desktop: boat, words, island in one line, all resting on the waves */
  @media (min-width: 56rem) {
    .course__voyage {
      grid-template-columns: auto minmax(0, 40rem) auto;
      align-items: end;
      justify-content: center;
      column-gap: clamp(2rem, 4vw, 4.5rem);
    }
    .course__voyage :global(.voyage__boat) {
      grid-column: 1;
      grid-row: 1;
      margin-bottom: 0.5rem;
    }
    .course__voyage .course__closing {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
    }
    .course__voyage :global(.voyage__island) {
      grid-column: 3;
      grid-row: 1;
    }
  }
  /* the boat rocks a little on the water */
  @keyframes voyage-rock {
    0%,
    100% {
      transform: rotate(-2deg) translateY(0);
    }
    50% {
      transform: rotate(2deg) translateY(-0.2rem);
    }
  }
  :global(html.motion) .course__voyage :global(.voyage__boat svg) {
    animation: voyage-rock 6s ease-in-out infinite;
    transform-origin: 50% 90%;
  }
  /* The heading above, the ways to pay under it across the whole width: the tiers stand as columns */
  .reg {
    max-width: none;
    padding-inline: clamp(1rem, 0.4rem + 2.6vw, 3rem);
  }
</style>
