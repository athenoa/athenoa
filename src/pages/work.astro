---
// Work & Press (Maria, 24 November 2026): Athena's talks, interviews and writings, the lists from
// Nostos's Talks & Articles (src/components/WorkList.astro) as a main page of their own, last in the
// menu, while Nostos is hidden. The same file renders /work/ (Greek), /en/work/ and /grc/work/.
import Base from '../layouts/Base.astro';
import WorkList from '../components/WorkList.astro';
import { getLocale } from '../lib/locale';
import { content } from '../data';

const locale = getLocale(Astro.url);
const { site } = content(locale);
const w = {
  el: { title: 'Έργο & Τύπος', description: 'Ομιλίες, συνεντεύξεις, μελέτες και άρθρα της Δρ. Αθηνάς Πόταρη.' },
  en: { title: 'Work & Press', description: 'Talks, interviews, papers and articles by Dr. Athena Potari.' },
  grc: { title: 'Ἔργα & Τύπος', description: 'Ομιλίες, συνεντεύξεις, μελέτες και άρθρα της Δρ. Αθηνάς Πόταρη.' },
}[locale];
---

<Base title={`${w.title} | ${site.name}`} description={w.description}>
  <section class="section work">
    <div class="wrap">
      <h1 class="t-1" data-split>{w.title}</h1>
    </div>
  </section>
  <WorkList />
</Base>

<style>
  .work {
    padding-bottom: 0;
  }
</style>
