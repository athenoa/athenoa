---
// Opening of "About Dr. Athena Potari": the title and the three introductory paragraphs beside a tall
// arch portrait. Depth, far to near: a blue paper arch, the photograph.
import { withGreekLemmas } from '../../lib/lemma';
import Media from '../Media.astro';
import temple from '../../assets/media/temple-blue-dress.jpg';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

const locale = getLocale(Astro.url);
const { about, site } = content(locale);
const t = {
  en: { photo: 'A woman in a long blue dress stands between the marble columns of an ancient temple' },
  el: { photo: 'Μια γυναίκα με μακρύ μπλε φόρεμα στέκεται ανάμεσα στους μαρμάρινους κίονες ενός αρχαίου ναού' },
  grc: { photo: 'Γυνὴ μακρὰν κυανῆν ἐσθῆτα ἔχουσα ἕστηκεν ἐν μέσοις τοῖς μαρμαρίνοις κίοσιν ἀρχαίου νεώ' },
}[locale];

// The title breaks where the name begins: a short opening line ("About"), then the name with its
// title on a line of its own. The name starts at the honorific that also opens site.founder.
const [honorific] = site.founder.split(' ');
const at = Math.max(about.title.indexOf(honorific), 0);
const opening = about.title.slice(0, at).trim();
const name = about.title.slice(at);
const [lead, ...paragraphs] = about.intro;
---

<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__head">
      <h1 class="hero__title t-hero" data-split style={`--name-chars:${name.length}`}>
        {opening && <span class="hero__opening t-sub">{opening}</span>}{' '}<span class="hero__name">{name}</span>
      </h1>
    </div>

    <div class="hero__figure">
      {/* (the sun rays behind the arch were taken away: Maria, 25 November 2026) */}
      <div class="hero__plate" data-reveal="grow"></div>
      <div class="hero__photo" data-depth="-0.05">
        <Media
          src={temple}
          alt={t.photo}
          shape="arch"
          ratio="5 / 7"
          focus="60% 50%"
          widths={[360, 560, 800, 1100]}
          sizes="(min-width: 46rem) 31vw, 70vw"
          innerDepth={0.1}
          priority
        />
      </div>
    </div>

    <p class="lead hero__lead" data-reveal set:html={withGreekLemmas(lead, locale)} />

    <div class="hero__more">
      {paragraphs.map((text, i) => <p data-reveal style={`--i:${i + 1}`} set:html={withGreekLemmas(text, locale)} />)}
    </div>
  </div>
</section>

<style>
  .hero {
    --fig: min(70vw, 20rem);
    position: relative;
    /* The first screen slides up under the sticky header */
    margin-top: calc(var(--header-h) * -1);
    padding-top: calc(var(--header-h) + var(--space-m));
    padding-bottom: var(--space-l);
    /* The rays reach past the page edge */
    overflow-x: clip;
  }
  .hero__grid {
    display: grid;
    gap: var(--space-m);
  }

  /* The title is sized against its own column and the length of the name, so the name stays on one
     line in either language and in the fallback face (0.46em is a generous average letter: the Greek
     name in EB Garamond needs 0.43). A still wider face simply breaks the name. */
  .hero__head {
    position: relative;
    z-index: 2;
    container-type: inline-size;
  }
  .hero__title {
    font-size: min(var(--step-5), calc(100cqi / (var(--name-chars) * 0.46)));
  }
  /* The opening words are set as the title's smaller first line, in the lighter blue of a subtitle */
  /* (close above the name: the hand's own line height would leave a gap) */
  .hero__opening {
    margin: 0 0 -0.12em;
    padding-bottom: 0;
    font-size: 0.58em;
    line-height: 1.12;
  }
  .hero__name {
    display: block;
  }

  .hero__figure {
    /* The kit's arch radius collapses its lower corners on tall frames; the width is known here,
       so the top is a true half circle and the foot keeps its curve. */
    --r-arch: calc(var(--fig) / 2) calc(var(--fig) / 2) 2.4rem 2.9rem / calc(var(--fig) / 2) calc(var(--fig) / 2)
      2.2rem 2.6rem;
    position: relative;
    width: var(--fig);
    margin-top: var(--space-m);
    margin-left: auto;
    margin-right: 0.5rem;
  }
  /* A rim the photograph's own shape, a little larger all round, not an offset second shape
     (Maria, 23 November 2026) */
  .hero__plate {
    --rim: 0.7rem;
    position: absolute;
    inset: calc(var(--rim) * -1);
    border-radius: calc(var(--fig) / 2 + var(--rim)) calc(var(--fig) / 2 + var(--rim)) 3.1rem 3.6rem /
      calc(var(--fig) / 2 + var(--rim)) calc(var(--fig) / 2 + var(--rim)) 2.9rem 3.3rem;
    background-color: var(--blue);
    background-image: url('/textures/grain-light.webp');
    background-size: 400px 400px;
    filter: url(#rough);
  }
  .hero__photo {
    position: relative;
  }

  .hero__lead {
    max-width: 36ch;
    margin-top: var(--space-s);
    color: var(--ink-strong);
  }
  .hero__more {
    display: grid;
    gap: var(--space-s);
    max-width: 25.5em;
  }
  .hero__more :global([lang='grc']) {
    white-space: nowrap;
  }

  /* Tablet: the portrait moves up beside the title and the lead; the rest runs underneath */
  @media (min-width: 46rem) {
    .hero {
      --fig: clamp(14rem, 31vw, 27rem);
      padding-top: calc(var(--header-h) + var(--space-l));
      padding-bottom: var(--space-xl);
    }
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) var(--fig);
      grid-template-areas:
        'head figure'
        'lead figure'
        'more more';
      column-gap: var(--space-xl);
      align-items: start;
    }
    .hero__head {
      grid-area: head;
    }
    .hero__figure {
      grid-area: figure;
      margin-top: 0;
      margin-right: 0;
    }
    .hero__lead {
      grid-area: lead;
      margin-top: 0;
    }
    .hero__more {
      grid-area: more;
    }
  }

  /* Desktop: all the text in one column, the portrait standing beside it */
  @media (min-width: 62rem) {
    .hero {
      --fig: clamp(19rem, 30vw, 27rem);
    }
    .hero__grid {
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'head figure'
        'lead figure'
        'more figure';
    }
    .hero__head {
      margin-bottom: var(--space-s);
    }
  }
</style>
