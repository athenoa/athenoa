---
// The ways to pay, each tier on a dark-blue slip, the tiers side by side as columns where there is room
// (Maria, 22 November 2026): its name, then its two ways of paying one above the other. Upfront is the first
// choice: a light-blue cut-out, the whole amount for the whole cycle (or year), the filled button.
// Monthly is the quieter one: an outline, the instalment set as a rate ("/ month", "× 8"), what it adds
// up to, the outlined button. Any notes on the tier follow.
// Used by the course registration (RegistrationInfo.astro) and the membership page.
//
// A course with an upfront discount shows the upfront price with the whole price struck through beside
// it and a small "−10%". Given a course (`course`, its slug), the buttons open that course's
// registration form (RegisterDialog.astro) instead of going straight to Stripe; without JavaScript, or
// where the form is not on the page, they stay plain links to Stripe.
import type { TuitionTier } from '../../data/courses';
import { getLocale } from '../../lib/locale';
import { fill, money, percent, upfrontPrice } from './money';

interface Props {
  tiers: TuitionTier[];
  /** Heading level of each tier's name */
  level?: 3 | 4;
  /** Under the upfront price: "for the whole Cycle", "for the whole year" */
  per: string;
  payInFull: string;
  payMonthly: string;
  /** "/ month", "× {n} instalments", "{price} in all" */
  month: string;
  payments: string;
  total: string;
  /** The course's upfront discount (0.1), with its mark ("−{pct}") */
  discount?: number;
  off?: string;
  /** The course's slug: the buttons open its registration form */
  course?: string;
  /** 'side': each tier across the whole width, its two ways side by side (the membership page) */
  ways?: 'stack' | 'side';
  /** On a course: membership as the alternative, a last column of its own that leads to the membership page */
  member?: {
    title: string;
    text: string;
    cta: string;
    href: string;
    now: string;
    was: string;
    off: string;
    month: string;
    payments: string;
  };
}
const { tiers, level = 3, per, payInFull, payMonthly, month, payments, total, discount = 0, off, course, member, ways = 'stack' } = Astro.props;
const columns = tiers.length + (member ? 1 : 0);
const locale = getLocale(Astro.url);
const Name = level === 4 ? 'h4' : 'h3';
const opens = (tier: TuitionTier, pay: 'full' | 'monthly') =>
  course ? { 'data-register': course, 'data-tier': tier.id, 'data-pay': pay } : {};
---

<div class="tiers-box">
<ul class:list={['tiers', member && 'tiers--member', ways === 'side' && 'tiers--side']} role="list" style={`--cols:${columns}`}>
  {
    tiers.map((tier) => (
      <li class="tier box on-blue-deep">
        <Name class="tier__name">{tier.name}</Name>
        <div class="ways">
          <div class="way way--upfront box on-blue-light">
            <p class="way__amount">
              <span class="way__sum">{money(upfrontPrice(tier.price, discount), locale)}</span>
            </p>
            {/* An upfront discount: under the price, the whole price struck through and its mark */}
            {discount > 0 && (
              <p class="way__was">
                <s>{money(tier.price, locale)}</s>
                <span class="tier__off">{fill(off ?? '', { pct: percent(discount) })}</span>
              </p>
            )}
            <p class="way__line">{per}</p>
            <a class="btn way__btn" href={tier.payInFull} {...opens(tier, 'full')}>
              {payInFull}
            </a>
          </div>
          <div class="way way--monthly">
            <p class="way__amount">
              <span class="way__sum">{money(tier.perMonth, locale)}</span>
              <span class="way__unit">{month}</span>
            </p>
            <p class="way__line way__rate">{fill(payments, { n: String(tier.payments) })}</p>
            {/* what the instalments add up to (membership's 12 × 83€ is 996€, not the year's 990€) */}
            <p class="way__total">{fill(total, { price: money(Math.round(tier.perMonth * tier.payments * 100) / 100, locale) })}</p>
            <a class="btn btn--ghost way__btn" href={tier.payMonthly} {...opens(tier, 'monthly')}>
              {payMonthly}
            </a>
          </div>
        </div>
        {tier.notes?.map((note) => (
          <p class="tier__small">{note}</p>
        ))}
      </li>
    ))
  }
  {
    member && (
      <li class="tier tier--member box on-blue-light">
        <Name class="tier__name">{member.title}</Name>
        <p class="tier__small member__text">{member.text}</p>
        <p class="way__amount">
          <span class="way__sum">{member.now}</span>
        </p>
        {member.was && (
          <p class="way__was">
            <s>{member.was}</s>
            <span class="tier__off">{member.off}</span>
          </p>
        )}
        <p class="tier__small">{member.month}</p>
        <a class="btn way__btn" href={member.href}>
          {member.cta}
        </a>
      </li>
    )
  }
</ul>
</div>

<style>
  .tiers {
    display: grid;
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The tiers as columns where the space allows; on a narrower one two, membership across under them */
  .tiers-box {
    container-type: inline-size;
  }
  @container (min-width: 36rem) {
    .tiers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tiers--member .tier--member {
      grid-column: 1 / -1;
    }
  }
  @container (min-width: 56rem) {
    .tiers {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
    .tiers--member .tier--member {
      grid-column: auto;
    }
  }
  /* Side by side inside the tier instead: the tiers one under the other, each tier's two ways beside each other */
  @container (min-width: 36rem) {
    .tiers--side {
      grid-template-columns: minmax(0, 1fr);
    }
    .tiers--side .ways {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .tier {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.25rem, 0.9rem + 1.6vw, 2rem);
  }
  .tier__name {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: calc(var(--step-1) * (0.55 + 0.45 * var(--title-scale)));
    line-height: 1.1;
    letter-spacing: var(--title-tracking);
    color: var(--ink-strong);
  }

  /* The two ways: one above the other in the tier's column, upfront first */
  .ways {
    display: grid;
    gap: 0.6rem;
  }
  /* Membership, the alternative: light-blue paper, its words, its price, the way to its page */
  .tier--member {
    align-content: start;
    justify-items: start;
  }
  .tier--member .way__btn {
    margin-top: 0.6rem;
  }
  /* Room above the amount, so it never crowds the edge (Maria, 22 November 2026) */
  .tiers .way {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    padding: clamp(1.6rem, 1.1rem + 1.4vw, 2.1rem) clamp(1.1rem, 0.9rem + 0.8vw, 1.5rem) clamp(1.2rem, 1rem + 0.8vw, 1.6rem);
  }
  /* Upfront: the first choice, a light-blue cut-out on the slip, with the filled Greek-blue button (the
     slip's own rule would make it crème, like the monthly one) */
  .way--upfront {
    --box-r: 1.3rem 1.6rem 1.4rem 1.7rem / 1.6rem 1.3rem 1.7rem 1.4rem;
  }
  .way--upfront .btn {
    --btn-bg: var(--blue);
    --btn-bg-hover: var(--blue-bright);
    --btn-ink: var(--creme-light);
  }
  /* Monthly: the quieter one, an outline drawn on the slip */
  .way--monthly {
    border: 1.5px solid var(--line);
    border-radius: 1.6rem 1.3rem 1.7rem 1.4rem / 1.3rem 1.7rem 1.4rem 1.6rem;
  }
  .way__amount {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1em 0.45em;
  }
  .way__sum {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: min(var(--step-2), 9vw);
    line-height: 1;
    letter-spacing: var(--title-tracking);
    font-variant-numeric: lining-nums;
    color: var(--ink-strong);
  }
  .way__unit {
    font-size: var(--step-0);
    color: var(--ink-soft);
  }
  /* The whole price, struck through quietly under what is paid upfront, with the discount's mark */
  .way__was {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .way__was s {
    font-family: var(--font-title);
    font-size: var(--step-1);
    font-variant-numeric: lining-nums;
    color: var(--ink-soft);
    text-decoration-thickness: 1.5px;
  }
  /* The monthly amount reads as a rate: its unit set beside it, a size down, and "× 8" under it */
  .way--monthly .way__sum {
    font-size: min(var(--step-1), 7.5vw);
  }
  .way__rate {
    font-weight: 560;
  }
  /* The discount, a small mark on a Greek-blue pebble: noticed, not shouted (it reads on every ground) */
  .tier__off {
    align-self: center;
    padding: 0.12em 0.6em 0.18em;
    border-radius: 58% 42% 52% 48% / 48% 56% 44% 52%;
    background: var(--blue);
    color: var(--creme-light);
    font-size: var(--step--1);
    font-weight: 600;
    font-variant-numeric: lining-nums;
  }
  .way__line,
  .way__total,
  .tier__small {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .way__line {
    color: var(--ink);
  }
  .way__total {
    font-variant-numeric: lining-nums;
  }
  /* The buttons stand at the foot of each way, level with each other */
  .way__btn {
    margin-top: auto;
    text-align: center;
  }
  /* In a column the buttons keep their words on one line where they can */
  .tiers .way__btn {
    padding-inline: 1.15em;
  }
  .way > :nth-last-child(2) {
    margin-bottom: 0.7rem;
  }
  .tier__small {
    max-width: 52ch;
  }
</style>
