---
// One course, drawn the same way wherever a course appears (the courses page and the home page):
// an arch cut from coloured paper, the picture set into it like a window, then the title, the same
// four facts and the actions.
//
// CLIENT DIRECTION, 11 October 2026: every course uses this one card, and what tells the courses
// apart is the colour of the paper. A course keeps its colour wherever it appears (its place in the
// course list decides it), so the colour works like a small brand of its own.
//
// Its one button, its picture and its title all lead to the course's own page (Maria, 22 November 2026).
import Media from '../Media.astro';
import { content } from '../../data';
import type { Course } from '../../data/courses';
import { getLocale } from '../../lib/locale';
import { courseImage } from './media';
import { keepHyphens } from './text';
import { feeOf, fill } from './money';

interface Props {
  course: Course;
  /** Heading level of the title: 2 on the courses page, 3 where the card sits under a section heading. */
  level?: 2 | 3;
  /** Load the picture at once (a card at the top of a page) */
  priority?: boolean;
  /** The home page's card: the flyer, the title and the start date only, no prices (Athena, 23 November 2026) */
  brief?: boolean;
}
const { course, level = 2, priority = false, brief = false } = Astro.props;
const Title = level === 3 ? 'h3' : 'h2';
const locale = getLocale(Astro.url);
const { courses, coursesPage, coursePageHref } = content(locale);
const { ui } = coursesPage;
const image = courseImage(course.image);
const href = coursePageHref(course.slug);
const titleId = `card-title-${course.slug}`;
const mainId = `card-main-${course.slug}`;
// The papers, in the order of the course list and then round again: beige paper, light blue,
// Greek blue, darker blue. The surface class turns the inks to suit.
// (Maria, 22 November 2026: the first card, ΟΔΥΣΣΕΙΑ, on the beige paper; then light blue, Greek blue.)
const tones = [
  { name: 'paper', surface: '' },
  // the light blue left out (Athena, 23 November 2026: "not lilac")
  { name: 'blue', surface: 'on-blue' },
  { name: 'deep', surface: 'on-blue-deep' },
];
const place = courses.findIndex((item) => item.slug === course.slug);
const tone = tones[Math.max(0, place) % tones.length];
// The same facts on every card, in the same order, so cards can be compared at a glance. A fact may
// have a quieter line under it: the introduction under the dates, and under the format what follows its
// first comma ("Live on Zoom" over "with recordings").
const comma = course.format?.indexOf(', ') ?? -1;
// Once known: "From 26 November 2026 until 10 June 2027", and "24 weekly lessons · 8 months"
const dates = course.lastLesson ? `${course.schedule} ${fill(ui.when.until, { date: course.lastLesson.short })}` : course.schedule;
const length =
  course.duration && course.months ? `${course.duration} · ${fill(ui.when.months, { n: String(course.months) })}` : course.duration;
// A course with tuition shows two ways: its standard tier paid upfront, then by the month
const fee = course.tuition?.[0] ? feeOf(course.tuition[0], course.upfrontDiscount ?? 0, locale) : null;
// "€550 για ολόκληρο τον Κύκλο 24 Μαθημάτων" (Athena, 23 November 2026)
const lessons = course.duration?.match(/^\d+/)?.[0];
const perCycle = lessons ? fill(ui.tuition.wholeCycleOf, { n: lessons }) : ui.tuition.feeUpfront;
const facts = [
  { label: ui.facts.dates, value: dates, note: course.scheduleNote },
  { label: ui.facts.duration, value: length },
  comma < 0
    ? { label: ui.facts.format, value: course.format }
    : { label: ui.facts.format, value: course.format!.slice(0, comma), note: course.format!.slice(comma + 2) },
  { label: ui.facts.language, value: course.teaching && ui.languages[course.teaching] },
  { label: ui.facts.fee, value: course.price?.display, fee: true },
].filter((fact) => fact.value && (!brief || fact.label === ui.facts.dates));
// "€200 & VAT (24%)": the amount stands out, the tax note sits smaller beside it.
const splitFee = (display: string) => {
  const at = display.indexOf(' ');
  return at < 0 ? [display, ''] : [display.slice(0, at), display.slice(at + 1)];
};
---

<article
  class:list={[
    'card',
    `card--${tone.name}`,
    'panel',
    tone.surface,
  ]}
  id={course.slug}
>
  <div class="card__figure">
    <Media
      class="card__media"
      src={image}
      alt={course.imageAlt}
      shape="soft"
      ratio="16 / 9"
      sizes="(min-width: 48rem) 46vw, 92vw"
      priority={priority}
    />
    {/* On the courses page, whether it is open: "Live" in gold with a pulsing white dot, like a recording light,
        or "Coming soon" (Maria, 24 November 2026); not on the home page's brief cards */}
    {
      !brief && (
        <p class:list={['card__status', !course.comingSoon && 'card__status--live']}>
          {!course.comingSoon && <span class="card__pulse" aria-hidden="true" />}
          {course.comingSoon ? ui.soon : ui.live}
        </p>
      )
    }
    {/* The picture is a second way in for a pointer; keyboard and screen readers use the named links below. */}
    <a class="card__cover" href={href} tabindex="-1" aria-hidden="true"></a>
  </div>

  <div class="card__text" data-reveal-group>
    <div class="card__head">
      <Title class="card__title t-3" id={titleId}>
        <a class="card__titlelink" href={href} set:html={keepHyphens(course.title)} />
      </Title>
      {course.subtitle && <p class="card__subtitle" set:html={keepHyphens(course.subtitle)} />}
    </div>
    {course.summary && !brief && <p class="card__summary">{course.summary}</p>}
    <dl class="card__facts">
      {
        facts.map((fact) => (
          <div class="card__fact">
            <dt>{fact.label}</dt>
            {fact.fee ? (
              fee ? (
                /* "€550 ετήσια προπληρωμή" over "ή €68,75 τον μήνα × 8"; an upfront discount strikes the whole price */
                <dd class="card__fee">
                  <span class="card__amount">{fee.now}</span>
                  <span class="card__tax">{perCycle}</span>
                  {/* an upfront discount: under the price, the whole price struck through and its mark */}
                  {fee.was && (
                    <span class="card__struck">
                      <s class="card__was">{fee.was}</s>
                      <span class="card__off">{fill(ui.tuition.off, { pct: fee.pct })}</span>
                    </span>
                  )}
                  <span class="card__aside card__save">{fill(ui.tuition.feeMonthly, { month: fee.month, n: fee.payments })}</span>
                </dd>
              ) : (
                <dd class="card__fee">
                  <span class="card__amount">{splitFee(fact.value!)[0]}</span>
                  <span class="card__tax">{splitFee(fact.value!)[1]}</span>
                </dd>
              )
            ) : 'note' in fact && fact.note ? (
              <dd>
                {fact.value}
                <span class="card__aside">{fact.note}</span>
              </dd>
            ) : (
              <dd>{fact.value}</dd>
            )}
          </div>
        ))
      }
    </dl>
    {/* One way on: the course's own page, for every course (Maria, 22 November 2026) */}
    <p class="card__go">
      <a class="btn" href={href} id={mainId} aria-labelledby={`${mainId} ${titleId}`}>
        {ui.viewCourse}
      </a>
    </p>
  </div>
</article>

<style>
  /* on the Greek-blue card the button is gold (Maria for Athena, 23 November 2026) */
  .card--blue :global(.btn) {
    --btn-bg: var(--gold);
    --btn-bg-hover: color-mix(in srgb, var(--gold) 82%, #fff);
    --btn-ink: #071260;
    --btn-ledge: color-mix(in srgb, var(--gold) 55%, #000);
  }
  /* Every course picture is a banner (Maria, 22 November 2026): a rectangle with softly rounded corners,
     in one frame on every card (16:9, the banners' own shape), on a card of coloured paper whose corners
     follow it. --frame is the picture's outline; the link laid over it follows the same curve.
     --pad is the margin of coloured paper around the picture and --foot the space under the actions. */
  .card {
    --frame: var(--r-soft);
    --panel-r: var(--r-soft);
    --pad: clamp(0.7rem, 0.5rem + 0.8vw, 1rem);
    /* the rim of paper around the picture, at its top and sides: about half of --pad (Maria, 22 November 2026) */
    --rim: clamp(0.5rem, 0.4rem + 0.3vw, 0.7rem);
    --foot: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
    position: relative;
    padding: var(--rim) var(--rim) var(--foot);
  }
  /* The third paper is paper itself, a shade darker than the page it lies on */
  .card--paper {
    --paper: var(--creme-deep);
  }
  .card__figure {
    position: relative;
    isolation: isolate;
    margin-bottom: var(--space-m);
  }
  .card__media {
    --media-r: var(--frame);
  }
  .card__status {
    position: absolute;
    z-index: 2;
    top: clamp(0.6rem, 0.4rem + 0.8vw, 1rem);
    right: clamp(0.6rem, 0.4rem + 0.8vw, 1rem);
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    margin: 0;
    padding: 0.2em 0.85em 0.26em;
    border-radius: 58% 42% 52% 48% / 48% 56% 44% 52%;
    background: var(--blue-light);
    color: var(--blue-deep);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.02em;
    pointer-events: none;
  }
  .card__status--live {
    background: var(--gold);
  }
  /* the recording light: a white dot that breathes */
  .card__pulse {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 0 rgb(255 255 255 / 0.7);
  }
  :global(html.motion) .card__pulse {
    animation: card-pulse 1.6s ease-out infinite;
  }
  @keyframes card-pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(255 255 255 / 0.75);
      opacity: 1;
    }
    70% {
      box-shadow: 0 0 0 0.5em rgb(255 255 255 / 0);
      opacity: 0.75;
    }
    100% {
      box-shadow: 0 0 0 0 rgb(255 255 255 / 0);
      opacity: 1;
    }
  }
  .card__cover {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: var(--frame);
  }
  .card :global(.media__clip img) {
    transition: scale var(--dur-3) var(--ease-out) var(--hover-delay);
  }
  .card__figure:hover :global(.media__clip img) {
    scale: 1.035;
  }
  /* the words keep their own inset (the narrower rim is made up here) */
  .card__text {
    padding-inline: calc(clamp(0.6rem, 0.3rem + 1.2vw, 1.25rem) + var(--pad) - var(--rim));
  }
  .card__text > :global(* + *) {
    margin-top: var(--space-s);
  }
  /* Two actions: side by side where there is room, else stacked */
  .card__go {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    padding-top: 0.35rem;
  }
  .card__titlelink {
    color: inherit;
    text-decoration: none;
  }
  .card__titlelink:hover {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.12em;
  }
  /* A long label (Greek) may run to two lines in a narrow card */
  .card__go .btn {
    text-align: center;
  }
  .card__head {
    display: grid;
    gap: 0.3rem;
  }
  .card__subtitle {
    font-family: var(--font-title);
    font-weight: 300;
    font-size: var(--step-1);
    text-wrap: balance;
    line-height: 1.15;
    color: var(--ink-soft);
  }
  /* the summary runs the full width of the card's text */
  .card__summary {
    max-width: none;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  /* The facts: a small ruled table, the same on every card */
  .card__facts {
    display: grid;
    margin: var(--space-s) 0 0;
    border-top: 1.5px solid var(--line);
  }
  .card__fact {
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.42rem 0 0.46rem;
    border-bottom: 1.5px solid var(--line);
  }
  .card__fact dt {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .card__fact dd {
    margin: 0;
    font-variant-numeric: lining-nums;
  }
  .card__aside {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .card__fee {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.45em;
  }
  .card__amount {
    font-family: var(--font-title);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1;
  }
  .card__tax {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  /* the struck price and the monthly way: each a line of its own under the fee */
  .card__save,
  .card__struck {
    flex-basis: 100%;
  }
  .card__struck {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  /* an upfront discount: the whole price struck through quietly, and a small mark on a Greek-blue pebble */
  .card__was {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .card__off {
    padding: 0.05em 0.5em 0.1em;
    border-radius: 58% 42% 52% 48% / 48% 56% 44% 52%;
    background: var(--blue);
    color: var(--creme-light);
    font-size: var(--step--1);
    font-weight: 600;
  }

  /* Side by side, the cards share the height of their row. The picture keeps its frame, the same in every
     card; the words take up the difference, so the facts and the actions stand at the foot of each card. */
  @media (min-width: 48rem) {
    .card,
    .card__text {
      display: flex;
      flex-direction: column;
    }
    .card__text {
      flex: 1 0 auto;
    }
    /* The slack goes under the last lines before the facts: the summary, or the title when there is none */
    .card__text > :nth-last-child(3) {
      flex-grow: 1;
    }
  }
</style>
