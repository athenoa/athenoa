---
// The course popup: a native <dialog>, one per course, rendered in the page so its content is in the HTML.
// A card link with data-course-open="<slug>" opens it; so does arriving at /courses/#<slug>.
// "Enroll" in its foot opens the last item, the ways to pay (each a Stripe Payment Link); without
// JavaScript it is a link to the same place on the course page.
import CourseBody from './CourseBody.astro';
import RegisterDialog from './RegisterDialog.astro';
import { feeOf, fill } from './money';
import { content } from '../../data';
import type { Course } from '../../data/courses';
import { getLocale } from '../../lib/locale';

interface Props {
  course: Course;
}
const { course } = Astro.props;
const locale = getLocale(Astro.url);
const { coursesPage, coursePageHref, registrationTab } = content(locale);
const { ui } = coursesPage;
// The fee in the foot, as on the card: the standard tier paid upfront, then by the month
const fee = course.tuition?.[0] ? feeOf(course.tuition[0], course.upfrontDiscount ?? 0, locale) : null;
const titleId = `course-title-${course.slug}`;
// The same test as the card's "Enroll" button
const canEnrol = course.available && Boolean(course.tuition?.length);
---

<dialog class:list={['cd', canEnrol && 'cd--full']} data-course-dialog={course.slug} aria-labelledby={titleId}>
  <div class="cd__sheet">
    <!-- A cross only (client direction, 11 October 2026); the word is kept for screen readers -->
    <button class="cd__close" type="button" data-course-close title={ui.close}>
      <span class="visually-hidden">{ui.close}</span>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M5 5.4c4.6 4.2 9 8.800 14 13.400M19 5c-4.400 4.800-9.200 9-13.800 14"></path>
      </svg>
    </button>

    <div class="cd__scroll" data-course-scroll>
      <CourseBody course={course} variant="dialog" titleId={titleId} />
    </div>

    {
      canEnrol && (
        <div class="cd__foot on-blue-deep" data-course-foot>
          {
            fee && (
              <p class="cd__price">
                <span class="cd__price-label">{course.price?.label}</span>
                <span class="cd__price-now">{fee.now}</span>
                <span class="cd__price-words">{ui.tuition.feeUpfront}</span>
                {fee.was && (
                  <span class="cd__price-line">
                    <s>{fee.was}</s>
                    <span class="cd__price-off">{fill(ui.tuition.off, { pct: fee.pct })}</span>
                  </span>
                )}
                <span class="cd__price-line">{fill(ui.tuition.feeMonthly, { month: fee.month, n: fee.payments })}</span>
              </p>
            )
          }
          <a class="btn" href={`${coursePageHref(course.slug)}#${registrationTab.id}`} data-enroll-start>
            {ui.enroll}
          </a>
        </div>
      )
    }
  </div>
</dialog>
{/* Its registration form, beside it (a tier button opens it over the popup) */}
{canEnrol && <RegisterDialog course={course} />}

<script>
  const motionOn = () => document.documentElement.classList.contains('motion');
  const find = (slug: string) =>
    slug ? document.querySelector<HTMLDialogElement>(`dialog[data-course-dialog="${CSS.escape(slug)}"]`) : null;
  const hashSlug = () => decodeURIComponent(location.hash.slice(1));
  // replaceState keeps Astro's router state and adds no history entry.
  const setHash = (slug: string) =>
    history.replaceState(history.state, '', slug ? `#${slug}` : location.pathname + location.search);

  // On a phone every section of the popup is open, one after another under a plain heading: nothing
  // to unfold, nothing hidden (Athena's wish, for older readers)
  const phone = () => matchMedia('(max-width: 47.99rem)').matches;
  function unfold(dialog: HTMLDialogElement) {
    const items = dialog.querySelectorAll<HTMLDetailsElement>('details.acc__item');
    dialog.classList.toggle('cd--plain', phone());
    if (!phone()) return;
    items.forEach((item) => {
      item.removeAttribute('name');
      item.open = true;
    });
  }

  function open(dialog: HTMLDialogElement) {
    if (dialog.open) return;
    unfold(dialog);
    dialog.classList.remove('is-closing');
    dialog.showModal();
    setHash(dialog.dataset.courseDialog!);
  }

  // Plays the closing transition, then closes for real.
  function close(dialog: HTMLDialogElement) {
    if (!dialog.open || dialog.classList.contains('is-closing')) return;
    if (!motionOn()) return dialog.close();
    const finish = () => {
      clearTimeout(timer);
      dialog.removeEventListener('transitionend', onEnd);
      dialog.close();
    };
    const onEnd = (event: TransitionEvent) => {
      if (event.target === dialog && event.propertyName === 'opacity') finish();
    };
    const timer = setTimeout(finish, 500);
    dialog.addEventListener('transitionend', onEnd);
    dialog.classList.add('is-closing');
  }

  function bind(dialog: HTMLDialogElement) {
    const slug = dialog.dataset.courseDialog!;

    dialog.querySelector('[data-course-close]')?.addEventListener('click', () => close(dialog));

    // Escape
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close(dialog);
    });

    // A click on the backdrop lands on the dialog element itself. The press must start there too,
    // so dragging a text selection out of a field does not close the popup.
    let pressedBackdrop = false;
    dialog.addEventListener('pointerdown', (event) => (pressedBackdrop = event.target === dialog));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog && pressedBackdrop) close(dialog);
    });

    // "Enroll": open the ways to pay, the accordion's last item, and bring it into view
    dialog.querySelector('[data-enroll-start]')?.addEventListener('click', (event) => {
      const item = dialog.querySelector<HTMLDetailsElement>('details[data-registration]');
      if (!item) return;
      event.preventDefault();
      item.open = true;
      requestAnimationFrame(() =>
        item.scrollIntoView({ block: 'start', behavior: motionOn() ? 'smooth' : 'auto' }),
      );
    });

    dialog.addEventListener('close', () => {
      dialog.classList.remove('is-closing');
      dialog.querySelector('[data-course-scroll]')?.scrollTo(0, 0);
      if (hashSlug() === slug) setHash('');
      // Back to the card that leads here (Safari does not restore focus to a clicked link by itself).
      document.querySelector<HTMLElement>(`a[data-course-open="${CSS.escape(slug)}"]:not([tabindex="-1"])`)?.focus();
    });
  }

  document.addEventListener('astro:page-load', () => {
    const dialogs = document.querySelectorAll<HTMLDialogElement>('dialog[data-course-dialog]');
    if (!dialogs.length) return;

    dialogs.forEach((dialog) => {
      if (dialog.hasAttribute('data-ready')) return;
      dialog.setAttribute('data-ready', '');
      bind(dialog);
    });

    // Card links are real links to the course page; here they open the popup instead.
    document.querySelectorAll<HTMLAnchorElement>('a[data-course-open]:not([data-ready])').forEach((link) => {
      const dialog = find(link.dataset.courseOpen!);
      if (!dialog) return;
      link.setAttribute('data-ready', '');
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        open(dialog);
        // "Enroll" on a card goes straight to the ways to pay
        if (link.hasAttribute('data-course-enroll')) {
          dialog.querySelector<HTMLElement>('[data-enroll-start]')?.click();
        }
      });
    });

    // Arriving at /courses/#<slug>
    const wanted = find(hashSlug());
    if (wanted) open(wanted);
  });

  // The hash changing while the page is open (a pasted address, a link from the footer)
  window.addEventListener('hashchange', () => {
    const wanted = find(hashSlug());
    document.querySelectorAll<HTMLDialogElement>('dialog[data-course-dialog][open]').forEach((dialog) => {
      if (dialog !== wanted) close(dialog);
    });
    if (wanted) open(wanted);
  });
</script>

<style>
  .cd {
    --cd-max: calc(100dvh - 1.5rem);
    width: min(100% - 1rem, 62rem);
    max-width: none;
    max-height: var(--cd-max);
    margin: auto;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    overflow: visible;
  }
  .cd::backdrop {
    background: color-mix(in srgb, var(--blue-deep, #071260) 62%, transparent);
  }
  /* The page behind stays put while a popup is open */
  :global(html:has(dialog.cd[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  /* The sheet: rough-cut paper. Colour and edge live on ::before so the text is never distorted. */
  .cd__sheet {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    max-height: var(--cd-max);
    border-radius: 2.2rem 2.8rem 2.4rem 3rem / 2.8rem 2.2rem 3rem 2.4rem;
  }
  .cd--full .cd__sheet {
    height: min(var(--cd-max), 54rem);
  }
  .cd__sheet::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-color: var(--creme);
    background-image: var(--grain);
    background-size: 400px 400px;
    filter: url(#rough);
  }

  .cd__scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 4rem clamp(1.1rem, 0.4rem + 3.4vw, 3rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: inherit;
  }

  .cd__close {
    position: absolute;
    top: 0.8rem;
    right: 0.9rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1.5px solid color-mix(in srgb, var(--blue) 28%, transparent);
    border-radius: 1.6rem 1.3rem 1.7rem 1.2rem / 1.3rem 1.7rem 1.2rem 1.6rem;
    background: var(--creme-light);
    color: var(--blue);
    font-size: var(--step--1);
    font-weight: 560;
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--hover-delay),
      color var(--dur-1) var(--hover-delay);
  }
  .cd__close:hover {
    background: var(--blue);
    color: var(--creme-light);
  }
  .cd__close:focus-visible {
    border-radius: 1.6rem 1.3rem 1.7rem 1.2rem / 1.3rem 1.7rem 1.2rem 1.6rem;
    outline-offset: 3px;
  }
  .cd__close path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
  }

  /* The foot: a darker blue cut-out along the bottom of the sheet holding the fee and the way in */
  .cd__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1em 0.55em;
  }
  .cd__price-label,
  .cd__price-line {
    flex-basis: 100%;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .cd__price-now {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: var(--step-2);
    line-height: 1;
    letter-spacing: var(--title-tracking);
    font-variant-numeric: lining-nums;
    color: var(--ink-strong);
  }
  .cd__price-words {
    font-size: var(--step--1);
  }
  .cd__price-line {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .cd__price-off {
    padding: 0.02em 0.5em 0.08em;
    border-radius: 58% 42% 52% 48% / 48% 56% 44% 52%;
    background: var(--creme-light);
    color: var(--blue-deep);
    font-weight: 600;
  }
  .cd__foot {
    position: relative;
    isolation: isolate;
    flex: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    margin: 0 0.55rem 0.55rem;
    padding: 1rem clamp(1.1rem, 0.4rem + 3vw, 2.4rem) 1.1rem;
    border-radius: 1.7rem 2rem 1.9rem 2.5rem / 1.9rem 1.6rem 2.5rem 1.9rem;
  }
  .cd__foot::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-color: var(--paper);
    background-image: var(--grain);
    background-size: 400px 400px;
    filter: url(#rough-sm);
  }
  /* ---------- Open and close ---------- */
  .cd[open] {
    display: block;
  }
  :global(html.motion) .cd[open] {
    transition:
      opacity var(--dur-1) var(--ease-soft),
      transform var(--dur-2) var(--ease-out);
    will-change: transform, opacity;
  }
  :global(html.motion) .cd[open]::backdrop {
    transition: opacity var(--dur-2) var(--ease-soft);
  }
  @starting-style {
    :global(html.motion) .cd[open] {
      opacity: 0;
      transform: translate3d(0, 1.75rem, 0) scale(0.955);
    }
    :global(html.motion) .cd[open]::backdrop {
      opacity: 0;
    }
  }
  :global(html.motion) .cd.is-closing {
    opacity: 0;
    transform: translate3d(0, 0.9rem, 0) scale(0.975);
    transition-duration: 0.26s;
    transition-timing-function: var(--ease-in-out);
  }
  :global(html.motion) .cd.is-closing::backdrop {
    opacity: 0;
    transition-duration: 0.26s;
  }

  @media (max-width: 30rem) {
    .cd {
      --cd-max: calc(100dvh - 1rem);
    }
    .cd__sheet {
      border-radius: 1.7rem 2.1rem 1.8rem 2.2rem / 2.1rem 1.7rem 2.2rem 1.8rem;
    }
  }

  /* On a phone the sections are plain: each under its own heading, all open, nothing to tap open */
  .cd--plain :global(.acc__item) {
    border: 0;
    background: none;
  }
  .cd--plain :global(.acc__item + .acc__item) {
    margin-top: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1.5px solid var(--line);
    border-radius: 0;
  }
  .cd--plain :global(.acc__item summary) {
    padding: 0.6rem 0 0.4rem;
    pointer-events: none;
    cursor: default;
  }
  .cd--plain :global(.acc__mark) {
    display: none;
  }
  .cd--plain :global(.acc__label) {
    font-size: var(--step-2);
  }
  .cd--plain :global(.acc__content) {
    padding: 0.4rem 0 0.6rem;
  }
</style>
