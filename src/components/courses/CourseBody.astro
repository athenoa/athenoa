  .body--page .body__summary {
    font-size: var(--step-1);
    line-height: 1.34;
  }
  /* Wide: the summary on the left, the facts beside it (Maria, 23 November 2026) */
  @media (min-width: 60rem) {
    .body--page .body__lede {
