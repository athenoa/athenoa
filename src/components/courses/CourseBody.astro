    margin: var(--space-xl) auto 0;
    text-align: center;
  }
  .body__wait-line {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: calc(var(--step-2) * var(--title-scale));
    line-height: 1.15;
    text-wrap: balance;
  }

  /* ---------- The page's arrival (Maria, 23 November 2026) ----------
     One calm, ordered arrival of the course page's first screen, with motion on only (html.motion; with
     reduced motion all of it is simply there), opacity and transform only, done within about 1.8 s:
       the "Coming soon" pill drops in; the title's words rise (the site's split heading, motion.ts);
       the subtitle fades up; the picture prints in (a sheet of paper slides off it, downward, its top
       edge soft) while the sun swells a little behind it; the chip with Athena's medallion slides onto
       it from the left, the medallion settling; the date's label is pressed on at the lower right;
       then the summary and the facts, row after row, the fee last. Further down, the scroll reveals. */
  .body__print {
    display: none;
  }
  :global(html.motion) .body--page .body__print {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    overflow: hidden;
    border-radius: var(--r-soft);
    -webkit-mask-image: -webkit-radial-gradient(white, black); /* Safari keeps the rounded clip */
    pointer-events: none;
  }
  /* the sheet: taller than the picture, its top fifth fading in, so the edge that leaves is soft */
  :global(html.motion) .body--page .body__print > span {
    position: absolute;
    left: 0;
    right: 0;
    top: -22%;
    height: 122%;
    background:
      linear-gradient(to bottom, transparent, var(--paper) 18%) top / 100% 100% no-repeat;
    animation: body-print 0.85s var(--ease-in-out) 0.35s both;
  }
  @keyframes body-print {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, 104%, 0);
    }
  }
  :global(html.motion) .body--page .body__soon {
    animation: body-drop 0.45s var(--ease-out) 0s both;
  }
  :global(html.motion) .body--page .body__subtitle {
    animation: body-rise 0.55s var(--ease-out) 0.3s both;
  }
  :global(html.motion) .body--page .body__chip {
    /* the same calm slide up and fade as the date label (Maria, 23 November 2026) */
    animation: body-press 0.8s cubic-bezier(0.22, 0.61, 0.36, 1) 0.95s both;
  }
  :global(html.motion) .body--page .body__note {
    animation: body-press 0.8s cubic-bezier(0.22, 0.61, 0.36, 1) 1.1s both;
  }
  :global(html.motion) .body--page .body__summary {
    animation: body-rise 0.5s var(--ease-out) 1s both;
  }
  :global(html.motion) .body--page .facts__row {
    animation: body-rise 0.42s var(--ease-out) both;
    animation-delay: calc(1.1s + var(--row, 0) * 60ms);
  }
  .body--page .facts__row:nth-child(2) {
    --row: 1;
  }
  .body--page .facts__row:nth-child(3) {
    --row: 2;
  }
  .body--page .facts__row:nth-child(4) {
    --row: 3;
  }
  .body--page .facts__row:nth-child(5) {
    --row: 4;
  }
  @keyframes body-drop {
    from {
      opacity: 0;
      transform: translate3d(0, -0.9rem, 0);
    }
  }
  @keyframes body-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 0.8rem, 0);
    }
  }
  @keyframes body-slide {
    from {
      opacity: 0;
      transform: translate3d(-1.6rem, 0, 0);
    }
  }
  @keyframes body-settle {
    from {
      transform: rotate(-10deg) scale(0.9);
    }
    60% {
      transform: rotate(3deg) scale(1.03);
    }
  }
  /* the date label: a calm slide up and fade (Maria, 23 November 2026: the sticker press was too cheap) */
  @keyframes body-press {
    from {
      opacity: 0;
      transform: translate3d(0, 0.9rem, 0);
    }
  }

  /* "If you sign up now…": in Athena's hand on a slip of aged, golden paper under the start date, right-aligned
     with it (Maria, 28 November 2026: no tilt, smaller letters, overlapping the date's chip). The same paper by day and by night. */
  .body__missed[hidden] {
    display: none;
  }
  .body--page .body__missed {
    position: absolute;
    right: var(--edge);
    /* tucked under the date's chip: its top edge runs behind the chip */
    top: calc(100% + clamp(1.3rem, 0.8rem + 1.6vw, 2.1rem) - 0.9rem);
    z-index: 2;
    max-width: min(30rem, 80%);
    margin: 0;
    padding: 1.35rem 1.1rem 0.6rem;
    border-radius: 0.5rem 0.9rem 0.6rem 1rem / 0.9rem 0.5rem 1rem 0.6rem;
    background-color: #e6cd94;
    background-image:
      radial-gradient(120% 140% at 50% 45%, transparent 55%, rgb(150 104 38 / 0.32)),
      url('/textures/grain-dark.webp');
    background-size: auto, 300px 300px;
    box-shadow: 0 0.3rem 0.9rem rgb(5 10 50 / 0.28);
    color: #4a3312;
    font-size: var(--step--1);
    line-height: 1.35;
    text-align: left;
    text-wrap: balance;
  }
  .body--page .body__figure:has(.body__missed:not([hidden])) {
    margin-bottom: calc(clamp(5rem, 3rem + 4vw, 7rem) + 3.2rem);
  }
  @media (max-width: 40rem) {
    /* on a phone the date sits under the picture, and the note under the date */
    .body--page .body__missed {
      top: calc(100% + 4.6rem);
      max-width: none;
      left: var(--edge);
      text-align: center;
    }
    .body--page .body__figure:has(.body__missed:not([hidden])) {
      margin-bottom: 14rem;
    }
    /* Εὖ Ζῆν's phone banner: the date sits half over the picture's edge, the note just under it */
    .body--page .body__figure:has(:global(.body__portrait)) .body__missed {
      top: calc(100% + 0.6rem);
    }
    .body--page .body__figure:has(:global(.body__portrait)):has(.body__missed:not([hidden])) {
      margin-bottom: 8.5rem;
    }
  }

  /* Tablet and small laptop widths (Maria, 28 November 2026: the two chips must never touch, and the date
     stays half over the picture's edge). Both chips are made smaller here; below about 50rem even that is
     too tight, so the date (and the golden slip with it) goes under Athena's chip, as on a phone. */
  @media (min-width: 40.01rem) and (max-width: 72rem) {
    .body--page .body__figure:has(.body__chip) .body__chip {
      --thumb: clamp(4rem, 2.4rem + 3vw, 5.4rem);
