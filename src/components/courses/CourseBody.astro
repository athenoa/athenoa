    .body--page .body__figure:has(.body__chip) .body__note {
      top: calc(100% + 2.4rem);
      bottom: auto;
    }
    .body--page .body__figure:has(.body__chip) .body__missed {
      top: calc(100% + 5rem);
    }
    .body--page .body__figure:has(.body__chip):has(.body__missed:not([hidden])) {
      margin-bottom: 13rem;
    }
  }
</style>

<script>
  // The "recordings of what you missed" line shows once the course's first lesson has begun
  document.addEventListener('astro:page-load', () => {
    for (const el of document.querySelectorAll<HTMLElement>('[data-missed-from]')) {
      el.hidden = Date.now() < Date.parse(el.dataset.missedFrom ?? '');
    }
  });
</script>
