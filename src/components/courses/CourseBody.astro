  .sec .prose {
    font-size: max(1.24rem, var(--step-0));
    font-weight: 430;
    line-height: 1.72;
  }
  .sec .prose :global(li + li) {
    margin-top: 0.9em;
  }
  .sec .prose :global(strong) {
