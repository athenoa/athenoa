  .body__sections {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }
  .sec {
    display: grid;
    gap: var(--space-m);
    align-items: start;
  }
  .sec.box {
    padding: clamp(1.6rem, 0.8rem + 4vw, 4.5rem);
