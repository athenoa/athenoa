  /* Who teaches it: Athena's name on a crème paper chip at the picture's lower left, half over its edge
     (as the date's label is stuck at its lower right), and her photograph pinned to it like a medallion,
     larger than the chip and breaking out over its top edge onto the picture (Maria, 22 November 2026).
     --thumb is the medallion's size; the chip keeps room for it on its left. */
  .body__chip {
    --thumb: clamp(4.5rem, 3.4rem + 3.6vw, 7rem);
    position: absolute;
    z-index: 3;
    left: clamp(0.6rem, 3%, 2rem);
    bottom: calc(clamp(1.3rem, 0.8rem + 1.6vw, 2.1rem) * -1);
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: calc(var(--thumb) * 0.62);
    max-width: min(30rem, 66%);
    padding: 0.55rem 1.3rem 0.6rem calc(var(--thumb) + 0.55rem);
    color: var(--blue);
    font-size: var(--step-0);
    line-height: 1.25;
  }
  .body__chip::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    /* a little see-through over the picture (Maria, 23 November 2026) */
    opacity: 1; /* solid, no see-through (Maria, 25 November 2026) */
    border-radius: 2.6rem 2rem 2.4rem 2.8rem / 2.8rem 2.4rem 2rem 2.6rem;
    background-color: var(--creme-light);
    background-image: url('/textures/grain-dark.webp');
    background-size: 400px 400px;
    filter: url(#rough-sm);
  }
  /* The medallion: its foot level with the chip's, its top well above it. A thin ring of day crème in
     every theme, so it reads against the picture and the chip alike. */
  .body__chip :global(.body__thumb) {
    position: absolute;
    left: -0.35rem;
    bottom: -0.3rem;
    width: var(--thumb);
    height: var(--thumb);
    border: 3px solid #f9f3e3;
    border-radius: 50%;
    object-fit: cover;
  }
  /* The sound and theme buttons are fixed in the window's lower left corner: on a wide screen the chip
     starts clear of them (about 7.5rem from the window's edge) */
  @media (min-width: 48rem) {
    .body__chip {
      left: max(clamp(0.6rem, 3%, 2rem), calc(7.5rem - (100vw - 100%) / 2));
    }
  }
  .body--page .body__note {
    left: auto;
    right: clamp(0.6rem, 3%, 2rem);
    bottom: -1.5rem;
    max-width: 40%;
  }
  /* A phone has no room for both slips on the picture: the chip keeps its place on the picture's edge and
     the date's label sits just under it, on the right, in room the figure keeps below itself */
  /* The start date on a chip like Athena's, on the picture's lower edge at the right, level with hers
     (Maria, 23 November 2026): the same clean, slightly see-through paper (not the old irregular shape) */
  .body--page .body__note {
    top: auto;
    bottom: calc(clamp(1.3rem, 0.8rem + 1.6vw, 2.1rem) * -1);
    max-width: 80%;
    padding: 0.55rem 1.3rem 0.6rem;
    font-weight: 500;
  }
  .body--page .body__note::before {
    border-radius: 2.6rem 2rem 2.4rem 2.8rem / 2.8rem 2.4rem 2rem 2.6rem;
    background-color: var(--creme-light);
    background-image: url('/textures/grain-dark.webp');
    opacity: 1; /* solid, no see-through (Maria, 25 November 2026) */
  }
  /* The banner as large as it can be: the full width of the window, edge to edge, square-cornered, at the
     top of the page (Athena, 23 November 2026). The chip and the date line up with the text column. */
  .body--page .body__figure {
    --edge: max(var(--gutter), calc((100vw - var(--wrap)) / 2));
    margin-inline: calc(50% - 50vw);
    margin-top: 0;
    margin-bottom: clamp(5rem, 3rem + 4vw, 7rem);
  }
  .body--page .body__media {
    --media-r: 0;
  }
  /* no vignette on the banner: its blue tint showed at the corners like a border (Maria, 25 November 2026) */
  .body--page .body__media :global(.media__clip::after) {
    display: none;
  }
  .body--page .body__note {
    right: var(--edge);
  }
  .body--page .body__chip {
    left: var(--edge);
  }
  @media (min-width: 48rem) {
    /* clear of the sound and theme buttons in the window's lower left corner */
    .body--page .body__chip {
      left: max(7.5rem, var(--edge));
    }
  }
  @media (max-width: 40rem) {
    .body--page .body__figure {
      margin-bottom: 9rem;
    }
    /* a phone has no room for both chips on the picture's edge: the date's sits just under Athena's */
    .body--page .body__note {
      top: calc(100% + 2.6rem);
      bottom: auto;
      max-width: none;
      white-space: nowrap;
      font-size: var(--step-1);
    }
    .body__chip {
      max-width: 88%;
      font-size: var(--step--1);
    }
  }

  /* On the page the sun's rays run under the picture, where the note is written. They part around it:
     the note lies on a patch of clean paper with a soft edge, which the picture stays in front of. */
  .body--page .body__jot::before {
    content: '';
    position: absolute;
    inset: -0.9rem -2.2rem -1.1rem -1.7rem;
