---
// Everything there is to say about one course, rendered once so the popup and the course page cannot drift apart.
//   variant="dialog"  compact header, sections as an accordion (the registration notes are its last item)
//   variant="page"    h1 header, sections written out under h2 headings
// On the page the registration is placed by the caller; in the popup it is the accordion's last item.
import { Image, Picture } from 'astro:assets';
import { handCase } from '../../lib/hand';
import Media from '../Media.astro';
import portrait from '../../assets/media/athena-portrait-thumb.jpg';
import Illustration from '../Illustration.astro';
import RegistrationInfo from './RegistrationInfo.astro';
import PaperNote from './PaperNote.astro';
import LangNote from './LangNote.astro';
import { content } from '../../data';
import type { Course } from '../../data/courses';
import { getLocale } from '../../lib/locale';
import { courseImage } from './media';
import { keepHyphens } from './text';
import { feeOf, fill } from './money';

interface Props {
  course: Course;
  variant: 'dialog' | 'page';
  /** id for the title, so a dialog can be labelled by it */
  titleId?: string;
}
const { course, variant, titleId } = Astro.props;
const { coursesPage, registrationTab, site } = content(getLocale(Astro.url));
const { ui } = coursesPage;
const image = courseImage(course.image);
const page = variant === 'page';
const portraitBanner = page && course.bannerPortrait ? courseImage(course.bannerPortrait) : null;
const isOpen = course.status === 'open';
// A course that cannot be enrolled in yet takes names for its waitlist instead (the same test as the card).
const waitlist = !course.available;
const Title = page ? 'h1' : 'h2';
const Label = page ? 'h2' : 'h3';
// The facts, as on the card but in full: every date, the format, the language, the fee. The format reads
// as on the card: what comes before its first comma, and what follows it as a quieter line ("Live on
// Zoom" over "with recordings"; Maria, 22 November 2026).
const comma = course.format?.indexOf(', ') ?? -1;
const format = comma < 0 ? course.format : course.format!.slice(0, comma);
const formatNote = comma < 0 ? undefined : course.format!.slice(comma + 2);
// Once known, the last lesson closes the dates and the months join the length
const dates = course.dates && [
  ...course.dates,
  ...(course.lastLesson ? [{ label: ui.when.last, when: course.lastLesson.when }] : []),
];
const length =
  course.duration && course.months ? `${course.duration} · ${fill(ui.when.months, { n: String(course.months) })}` : course.duration;
// A course with tuition: its standard tier paid upfront, then by the month (as on the card)
const fee = course.tuition?.[0] ? feeOf(course.tuition[0], course.upfrontDiscount ?? 0, getLocale(Astro.url)) : null;
// "€550 για ολόκληρο τον Κύκλο 24 Μαθημάτων" (Athena, 23 November 2026): the count is the number the course's length starts with
const lessons = course.duration?.match(/^\d+/)?.[0];
const perCycle = lessons ? fill(ui.tuition.wholeCycleOf, { n: lessons }) : ui.tuition.feeUpfront;
const facts = [
  { label: ui.facts.dates, value: dates ? undefined : course.schedule, dates },
  { label: ui.facts.duration, value: length },
  { label: ui.facts.format, value: format, note: formatNote },
  { label: ui.facts.language, value: course.teaching && ui.languages[course.teaching], lang: true },
  { label: ui.facts.fee, value: course.price?.display, fee: true },
].filter((fact) => fact.value || fact.dates);

// Page only: each section sits on a different ground so the long read has a rhythm.
// The three blues all appear down the page: light blue here, darker blue here, Greek blue for registration.
// Not the light blue (Athena, 23 November 2026: "not lilac", something that pops): Greek blue with white words.
const grounds = [[], ['panel', 'on-blue'], ['panel', 'on-blue-deep'], [], ['box', 'box--line']];
// The monad (the One) closes each course's description (ΟΔΥΣΣΕΙΑ speaks of "the relation of the One to the Many").
const symbolFor = 'description';
---

<div class:list={['body', `body--${variant}`]}>
  <header class="body__head">
    <div
      class:list={['body__figure', !isOpen && 'body__figure--jot']}
      style={`--ar:${(image.height / image.width).toFixed(3)}`}
    >
      {/* The sun's rays that stood behind the picture were taken away (Athena, 23 November 2026: calmer,
          and the flyer itself larger) */}
      {/* Every course picture is a banner, shown whole in a rectangle with softly rounded corners
          (Maria, 22 November 2026); on the page it runs the full width of the content */}
      {/* phones: the portrait banner, the full screen (Maria, 24 November 2026); the wide one from tablets up */}
      {portraitBanner && (
        <Picture
          class="body__portrait"
          data-light={course.bannerPortraitLight ? '' : undefined}
          src={portraitBanner}
          alt={course.imageAlt}
          widths={[390, 600, 714]}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
        />
      )}
      <Media
        class:list={['body__media', portraitBanner && 'body__media--wide']}
        src={image}
        alt={course.imageAlt}
        shape="soft"
        ratio={page && course.banner ? course.banner.ratio : `${image.width} / ${image.height}`}
        focus={page && course.banner ? course.banner.focus : undefined}
        sizes={page ? '(min-width: 86rem) 82rem, calc(100vw - 2rem)' : '(min-width: 48rem) 26rem, 88vw'}
        priority={page}
        reveal={false}
      />
      {/* On the page, a course not open yet says "Coming soon", a pill over the banner's top right corner; the
          "Live" pill is only on the courses page's cards (Maria, 24 November 2026) */}
      {page && course.comingSoon && <p class="body__soon"><span>{ui.soon}</span></p>}
      {/* On the page the picture "prints in": a sheet of paper slides off it, downward (the arrival below) */}
      {page && <span class="body__print" aria-hidden="true"><span /></span>}
      {/* On the page, who teaches it: Athena's photograph and name on a paper chip stuck to the picture.
          Not on Εὖ Ζῆν, whose banner already shows her portrait and name (Maria, 23 November 2026). */}
      {
        page && course.slug !== 'eu-zen' && (
          <p class="body__chip">
            <Image class="body__thumb" src={portrait} alt="" width={112} height={112} densities={[1, 2]} />
            <span>
              {ui.taughtBy} {course.instructor}
            </span>
          </p>
        )
      }
      {/* The season it runs, on a paper label stuck to the picture. While the details are still to come:
          a note in Athena's hand instead, jotted at an angle on the page under the picture. */}
      {
        isOpen ? (
          course.schedule && (
            <>
              <PaperNote class="body__note">
                {handCase(course.schedule)}
              </PaperNote>
              {/* Once the first lesson has taken place, a line in Athena's hand under the start date: a late
                  sign-up gets the recordings of what they missed (Maria, 28 November 2026). The page is built
                  ahead of time, so the visitor's own clock shows it (script below). */}
              {page && course.starts?.firstLesson && (
                <p class="body__missed hand" hidden data-missed-from={course.starts.firstLesson}>
                  {handCase(ui.missedNote)}
                </p>
              )}
            </>
          )
        ) : (
          <p class="body__jot hand" data-reveal={page ? 'fade' : undefined} style="--delay:600ms">
            {ui.placeholderBadge}
            <svg viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <path d="M3 5.5C40 3 96 2.4 197 4.6C150 5.6 96 7.4 58 10.4" />
            </svg>
          </p>
        )
      }
    </div>

    {/* On the page the banner carries the title and subtitle in its own lettering, so the page's own title
        and subtitle are kept for screen readers and search only (Athena, 23 November 2026) */}
    <Title
      class:list={['body__title', page ? 't-1 visually-hidden' : 't-2']}
      id={titleId}
      data-split={page ? '' : undefined}
      set:html={keepHyphens(course.title)}
    />
    {/* The subtitle right under the title: smaller, lighter, in the title's face (Maria, 22 November 2026) */}
    {course.subtitle && <p class:list={['body__subtitle', page && 'visually-hidden']} set:html={keepHyphens(course.subtitle)} />}
    {!page && <p class="body__by">{ui.taughtBy} {course.instructor}</p>}

    <div class="body__lede stack">
      {
        isOpen ? (
          course.summary && <p class="body__summary">{course.summary}</p>
        ) : (
          <p>{ui.placeholderNote}</p>
        )
      }
      {
        isOpen && facts.length > 0 && (
          <dl class:list={['facts', page && 'on-blue text-larger']}>
            {facts.map((fact) => (
              <div class="facts__row">
                <dt>{fact.label}</dt>
                <dd>
                  {fact.dates ? (
                    <ul class="facts__dates" role="list">
                      {fact.dates.map((date) => (
                        <li>
                          <span class="facts__what">{date.label}</span> {date.when}
                        </li>
                      ))}
                    </ul>
                  ) : 'fee' in fact && fee ? (
                    <>
                      <span class="facts__fee">
                        <strong>{fee.now}</strong> {perCycle}
                      </span>
                      {/* an upfront discount: under the price, the whole price struck through and its mark */}
                      {fee.was && (
                        <span class="facts__what">
                          <s>{fee.was}</s>
                          <span class="facts__off">{fill(ui.tuition.off, { pct: fee.pct })}</span>
                        </span>
                      )}
                      <span class="facts__month">{fill(ui.tuition.feeMonthly, { month: fee.month, n: fee.payments })}</span>
                    </>
                  ) : (
                    <>
                      {fact.value}
                      {'lang' in fact && <LangNote teaching={course.teaching} />}
                      {'note' in fact && fact.note && <span class="facts__month">{fact.note}</span>}
                    </>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        waitlist && !page && (
          <p class="body__actions">
            {(
              <a
                class="btn"
                href={site.routes.contact}
                aria-haspopup="dialog"
                data-waitlist-open
                data-waitlist-course={course.title}
                data-waitlist-slug={course.slug}
                data-waitlist-lang={course.teaching && `${ui.facts.language}: ${ui.languages[course.teaching]}`}
              >
                {ui.joinWaitlist}
              </a>
            )}
          </p>
        )
      }
      {/* A quiet way to ask something first; it opens an email to the Academy */}
      {
        !isOpen && !page && (
          <p class="body__ask">
            {ui.waitlist.question} <a href={`mailto:${site.emails[0]}`}>{ui.contactInstead}</a>
          </p>
        )
      }
    </div>
  </header>

  {
    page && course.sections.length > 0 && (
      <div class="body__sections">
        {course.sections.map((section, i) => {
          const ground = grounds[i % grounds.length];
          return (
            <section
              class:list={['sec', section.id === symbolFor && 'sec--mark', ...ground]}
              id={section.id}
              aria-labelledby={`${section.id}-title`}
            >
              <hgroup class="sec__head" data-reveal>
                <Label class="sec__title t-2" id={`${section.id}-title`}>
                  {section.label}
                </Label>
              </hgroup>
              <div class="prose" data-reveal style="--i:1" set:html={section.html} />
              {section.id === symbolFor && <Illustration name="monad" class="sec__mark" draw />}
            </section>
          );
        })}
      </div>
    )
  }

  {
    !page && isOpen && (
      <div class="acc">
        {course.sections.map((section, i) => (
          <details class="acc__item" name={`sections-${course.slug}`} open={i === 0}>
            <summary>
              <Label class="acc__label">{section.label}</Label>
              <svg class="acc__mark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                <path d="M4 12.3c5-.9 11-.6 16-.4" />
                <path class="acc__mark-v" d="M12.2 4c-.6 5-.5 11 0 16" />
              </svg>
            </summary>
            <div class="acc__content prose" set:html={section.html} />
          </details>
        ))}
        {/* The ways to pay (the dialog variant is no longer shown anywhere: the card popups are gone). Not for a
            course that cannot be enrolled in yet. */}
        {course.available && course.tuition?.length ? (
        <details class="acc__item" name={`sections-${course.slug}`} data-registration>
          <summary>
            <Label class="acc__label">{registrationTab.label}</Label>
            <svg class="acc__mark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
              <path d="M4 12.3c5-.9 11-.6 16-.4"></path>
              <path class="acc__mark-v" d="M12.2 4c-.6 5-.5 11 0 16"></path>
            </svg>
          </summary>
          <div class="acc__content">
            <RegistrationInfo course={course} level={4} />
          </div>
        </details>
        ) : null}
      </div>
    )
  }
  {/* A course not open yet: at the foot of its page, a calm word and the way onto its waitlist (Maria) */}
  {
    page && waitlist && (
      <section class="body__wait box on-blue" aria-label={ui.joinWaitlist}>
        <p class="body__wait-line">{ui.waitlist.invite}</p>
        <p>
          <a
            class="btn"
            href={site.routes.contact}
            aria-haspopup="dialog"
            data-waitlist-open
            data-waitlist-course={course.title}
            data-waitlist-slug={course.slug}
            data-waitlist-lang={course.teaching && `${ui.facts.language}: ${ui.languages[course.teaching]}`}
          >
            {ui.joinWaitlist}
          </a>
        </p>
        <p class="body__ask">
          {ui.waitlist.question} <a href={`mailto:${site.emails[0]}`}>{ui.contactInstead}</a>
        </p>
      </section>
    )
  }
</div>

<style>
  /* the portrait banner on phones only: the whole screen's width and height, under the header */
  .body__figure :global(.body__portrait) {
    display: none;
  }
  @media (max-width: 40rem) {
    .body--page .body__figure:has(:global(.body__portrait)) :global(.body__portrait) {
      display: block;
      width: 100%;
      height: 100svh;
      object-fit: cover;
      object-position: 50% 50%;
    }
    .body--page .body__figure:has(:global(.body__portrait)) :global(.body__media--wide),
    .body--page .body__figure:has(:global(.body__portrait)) .body__chip,
    .body--page .body__figure:has(:global(.body__portrait)) .body__print {
      display: none;
    }
    /* the picture starts at the very top, under the header */
    .body--page .body__figure:has(:global(.body__portrait)) {
      margin-top: calc(var(--header-h) * -1 - var(--space-m));
    }
    /* the start date half over the banner's lower edge (Maria, 24 November 2026) */
    .body--page .body__figure:has(:global(.body__portrait)) .body__note {
      top: 100%;
      translate: 0 -50%;
    }
    .body--page .body__figure:has(:global(.body__portrait)) {
      margin-bottom: 4.5rem;
    }
  }
  /* ---------- Header, shared ---------- */
  .body__head {
    display: grid;
    gap: var(--space-s);
  }
  .body__figure {
    position: relative;
  }
  /* Every course picture is a banner: a rectangle with softly rounded corners, the whole of it in view */
  .body__media {
    --media-r: var(--r-soft);
  }
  .body__subtitle {
    font-family: var(--font-title);
    font-weight: 300;
    font-size: calc(var(--step-1) * 1.05);
    line-height: 1.12;
    letter-spacing: var(--title-tracking);
    color: var(--ink-soft);
    text-wrap: balance;
  }
  .body__by {
    font-style: italic;
    color: var(--ink-soft);
  }
  .body__lede {
    max-width: var(--measure);
  }
  /* A longer label (a date, in the Greek hand) may take two lines on a phone rather than run off the picture */
  .body__note {
    left: 7%;
    bottom: -1.5rem;
    max-width: 88%;
    white-space: normal;
    text-wrap: balance;
  }
  /* "Details to follow", as Athena might jot it on the page: under the picture, at an angle, with a
     quick stroke of the pen beneath. It hangs in space the figure keeps free for it (--jot-room). */
  .body__figure--jot {
    --jot-room: 4.1rem;
  }
  .body__jot {
    position: absolute;
    top: calc(100% + 1.05rem);
    left: 5%;
    max-width: 100%;
    font-size: max(1.3rem, var(--step-1));
    rotate: -4deg;
    transform-origin: 0 50%;
  }
  .body__jot svg {
    display: block;
    width: 106%;
    height: 0.5em;
    margin: -0.12em 0 0 -3%;
    overflow: visible;
  }
  .body__jot path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  /* The facts: a small ruled table, as on the card */
  .facts {
    display: grid;
    margin: var(--space-s) 0 0;
    border-top: 1.5px solid var(--line);
    font-size: var(--step--1);
  }
  /* On the page the facts lie on a sheet of papyrus, a warmer, deeper paper than the page (Athena,
     23 November 2026), with a clean edge */
  /* A bright indigo sheet, crème letters, by day and by night (Athena, 25 November 2026: no muted colours;
     was a papyrus brown that turned muddy at night) */
  .body--page .facts {
    padding: 0.4rem clamp(1rem, 0.6rem + 2vw, 2rem) 0.6rem;
    border-top: 0;
    border-radius: 1.1rem;
    background-color: #2238c3;
    background-image: var(--grain);
    background-size: 400px 400px;
    font-size: var(--step-0);
  }
  .body--page .facts dd .facts__what {
    font-size: var(--step-0);
  }
  .body--page .facts__row {
    grid-template-columns: 7.6rem minmax(0, 1fr);
  }
  /* on a phone each label sits over its value, so the larger values keep the box's full width */
  @media (max-width: 40rem) {
    .body--page .facts__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
  .body--page .facts__off {
    background: var(--creme-light);
    color: #0b1c8c;
  }
  .body--page .facts__row:last-child {
    border-bottom: 0;
  }
  /* the summary under the picture: the key line of the course, in bold (Athena, 23 November 2026) */
  .body--page .body__summary {
    font-weight: 600;
  }
  .facts__row {
    display: grid;
    grid-template-columns: 6.4rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.6rem 0 0.65rem;
    border-bottom: 1.5px solid var(--line);
  }
  /* Information first (Maria, 22 November 2026): the values a step up, the row labels and the date
     labels small and quiet */
  .facts dt {
    color: var(--ink-soft);
  }
  .facts dd {
    margin: 0;
    font-size: var(--step-0);
    line-height: 1.35;
    font-variant-numeric: lining-nums;
  }
  .body--page .facts dd {
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .facts dd .facts__what {
    font-size: var(--step--1);
    line-height: 1.4;
  }
  /* the monthly way is information too: a step under the upfront price, not as quiet as a label */
  .facts__month {
    display: block;
    font-size: var(--step-0);
    color: var(--ink-soft);
  }
  .facts__dates li + li {
    margin-top: 0.35rem;
  }
  .facts__dates {
    display: grid;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .facts__what {
    display: block;
    color: var(--ink-soft);
  }
  .facts__fee strong {
    font-weight: 600;
  }
  .facts__off {
    display: inline-block;
    margin-left: 0.35em;
    padding: 0.02em 0.45em 0.06em;
    border-radius: 58% 42% 52% 48% / 48% 56% 44% 52%;
    background: var(--blue);
    color: var(--creme-light);
    font-weight: 600;
  }

  /* The waitlist beside the contact link, or either alone */
  .body__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1.5rem;
  }

  .body__ask {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .body__ask a {
    color: inherit;
  }

  /* ---------- Popup ---------- */
  /* In the popup the picture is small: the date's label is set smaller, so it does not cover it */
  .body--dialog .body__note {
    max-width: 72%;
    font-size: clamp(1.05rem, 0.8rem + 1vw, 1.35rem);
  }
  .body--dialog .body__head {
    gap: 0.6rem var(--space-l);
  }
  .body--dialog .body__figure {
    max-width: 30rem;
    margin-bottom: 1.5rem;
  }
  .body--dialog .body__figure--jot {
    margin-bottom: var(--jot-room);
  }
  .body--dialog .body__title {
    font-size: clamp(2rem, 1.5rem + 2.4vw, 3.4rem);
    font-size: calc(clamp(2rem, 1.5rem + 2.4vw, 3.4rem) * var(--title-scale));
  }
  @media (min-width: 48rem) {
    .body--dialog .body__head {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      align-items: start;
    }
    .body--dialog .body__figure {
      grid-row: 1 / -1;
      margin: 0;
    }
    .body--dialog .body__figure--jot {
      margin-bottom: var(--jot-room);
    }
    .body--dialog .body__title,
    .body--dialog .body__subtitle,
    .body--dialog .body__by,
    .body--dialog .body__lede {
      grid-column: 2;
    }
  }

  .acc {
    display: grid;
    gap: 0.55rem;
    margin-top: var(--space-m);
  }
  .acc__item {
    border: 1.5px solid var(--line);
    border-radius: 1.5rem 1.9rem 1.6rem 2rem / 1.9rem 1.5rem 2rem 1.6rem;
    transition:
      background-color var(--dur-2),
      border-color var(--dur-2);
  }
  .acc__item:nth-child(even) {
    border-radius: 1.9rem 1.5rem 2rem 1.6rem / 1.5rem 2rem 1.6rem 1.9rem;
  }
  .acc__item[open] {
    background-color: var(--creme-light);
    border-color: transparent;
  }
  .acc__item summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 1rem;
    padding: 0.85rem 1.1rem 0.9rem 1.35rem;
    list-style: none;
    cursor: pointer;
    border-radius: inherit;
  }
  .acc__item summary::-webkit-details-marker {
    display: none;
  }
  .acc__label {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: calc(var(--step-1) * (0.55 + 0.45 * var(--title-scale)));
    line-height: 1.08;
    letter-spacing: var(--title-tracking);
    color: var(--ink-strong);
    transition: color var(--dur-1) var(--hover-delay);
  }
  .acc__mark {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--ink-strong);
  }
  .acc__mark path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    transform-origin: 12px 12px;
    transition:
      transform var(--dur-2) var(--ease-out),
      opacity var(--dur-1);
  }
  .acc__item[open] .acc__mark-v {
    transform: rotate(90deg);
    opacity: 0;
  }
  .acc__item summary:hover .acc__label {
    color: var(--blue-bright);
  }
  .acc__content {
    padding: 0.2rem 1.35rem 1.5rem;
  }
  /* Where the browser can animate to height:auto, the panels ease open */
  @supports (interpolate-size: allow-keywords) {
    :global(html.motion) .acc__item {
      interpolate-size: allow-keywords;
    }
    :global(html.motion) .acc__item::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size var(--dur-2) var(--ease-out),
        content-visibility var(--dur-2) allow-discrete;
    }
    :global(html.motion) .acc__item[open]::details-content {
      block-size: auto;
    }
  }

  /* ---------- Page ---------- */
  /* The wide hero (Maria, 22 November 2026): the title, then the picture across the whole content width
     with the sun behind it and two paper slips stuck to it (who teaches, and when it starts), then the
     summary and the facts under it. */
  .body--page .body__head {
    gap: var(--space-m);
  }
  .body--page .body__title,
  .body--page .body__subtitle {
    order: 1;
  }
  /* "Coming soon": a small pill on light-blue paper, under the title */
  /* the pill lies over the banner, at its top right, inside the content's edge */
  .body--page .body__soon {
    position: absolute;
    z-index: 3;
    top: clamp(0.8rem, 0.4rem + 1.6vw, 1.8rem);
    right: var(--edge);
    margin: 0;
  }
  /* phones: the portrait banner fills the screen from the top, so the pill sits clear under the header */
  @media (max-width: 47.99rem) {
    .body--page .body__figure:has(:global(.body__portrait)) .body__soon {
      top: calc(var(--header-h) + 1.4rem);
    }
  }
  .body__soon span {
    display: inline-block;
    padding: 0.25em 0.95em 0.32em;
    border-radius: 58% 42% 52% 48% / 48% 56% 44% 52%;
    background: var(--blue-light);
    color: var(--blue-deep);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  /* between the title and the section headings in size: on the page it sits close under the title */
  .body--page .body__subtitle {
    margin-top: calc(var(--space-m) * -0.6);
    font-size: clamp(1.6rem, 1.05rem + 2.3vw, 3.1rem);
  }
  /* Greek is set in the fallback face, which runs wider than the title face: a step smaller,
     so the long compound in the title stays whole on a phone */
  .body--page .body__title:lang(el) {
    font-size: calc(clamp(3.1rem, 1.9rem + 5.8vw, 7.6rem) * 0.86);
  }
  /* Room above and below for the rays that reach past the picture */
  .body--page .body__figure {
    order: 2;
    margin-block: clamp(1.5rem, 0.5rem + 5vw, 5rem) clamp(2.5rem, 1.5rem + 5vw, 6rem);
  }
  /* Stacked (phone and tablet): the summary and the facts sit centred under the picture (Maria, 25 November 2026) */
  .body--page .body__lede {
    order: 3;
    margin-inline: auto;
  }
  @media (max-width: 59.99rem) {
    .body--page .body__summary {
