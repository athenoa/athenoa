---
// The registration form for one course: the Academy's Google Form, rebuilt in the site's own paper
// (Maria, 22 November 2026: "rebuild the Google form, elegantly, and then take them to the same Stripe
// link"). A native <dialog>, one per course on a page: CourseDialog.astro places it beside the course
// popup, and the course page beside its registration.
//
// The tier buttons (TuitionTiers.astro, data-register="<slug>") open it with their choice made: the
// tuition and the way of paying, which can still be changed here. On sending, the details are kept
// (src/lib/forms.ts, table "registrations", with an id made in the browser), then:
//   card, in full or monthly: on to that tier's Stripe Payment Link, as
//     <the link>?client_reference_id=<the registration's id>
//     so the payment can be matched to the registration (no name, email or other personal data goes
//     into the address);
//   bank transfer: a calm confirmation with the account, and where to send the proof of payment.
// If the details cannot be kept, it says so and still offers the payment (the plain Stripe link) and
// the email address: a registration never stands in the way of a payment.
// A hidden field catches robots: when it is filled nothing is kept or sent, and the form simply closes
// on a thank-you. Without JavaScript this never opens and the tier buttons are plain links to Stripe.
import { handCase } from '../../lib/hand';
import { content } from '../../data';
import type { Course } from '../../data/courses';
import { getLocale } from '../../lib/locale';
import { fill, money, percent, upfrontPrice } from './money';
import { heart } from './marks';

interface Props {
  course: Course;
}
const { course } = Astro.props;
const locale = getLocale(Astro.url);
const { coursesPage, site } = content(locale);
const { ui } = coursesPage;
const r = ui.register;
const bank = ui.registration.bank;
const tiers = course.tuition ?? [];
const discount = course.upfrontDiscount ?? 0;
const off = discount > 0 ? fill(ui.tuition.off, { pct: percent(discount) }) : '';
const id = (name: string) => `rg-${course.slug}-${name}`;
const fmt = (value: number) => money(value, locale);
const first = tiers[0];
// the monthly way as on the tiers: "80€ / μήνα × 8 · σύνολο 640€"
const monthly = (tier: (typeof tiers)[number]) =>
  `${fmt(tier.perMonth)} ${ui.tuition.month} ${fill(ui.tuition.payments, { n: String(tier.payments) })} · ${fill(ui.tuition.total, { price: fmt(Math.round(tier.perMonth * tier.payments * 100) / 100) })}`;
---

{
  first && (
    <dialog class="rg" data-register-dialog={course.slug} data-off={off} aria-labelledby={id('title')}>
      <div class="rg__sheet">
        <button class="rg__close" type="button" data-register-close>
          <span class="visually-hidden">{ui.close}</span>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M5 5.4c4.6 4.2 9 8.800 14 13.400M19 5c-4.400 4.800-9.200 9-13.800 14" />
          </svg>
        </button>

        <div class="rg__scroll" data-register-scroll>
          <header class="rg__head">
            <p class="hand hand--m">{handCase(r.kicker)}</p>
            <h2 class="rg__title t-3" id={id('title')}>
              {course.title}
            </h2>
          </header>

          <form class="rg__form" data-register-form>
            <fieldset class="rg__set">
              <legend class="rg__legend">{r.tierLegend}</legend>
              <div class="rg__opts rg__opts--pair">
                {tiers.map((tier, i) => (
                  <label class="opt">
                    <input
                      type="radio"
                      name="tier"
                      value={tier.id}
                      checked={i === 0}
                      data-full={tier.payInFull}
                      data-monthly={tier.payMonthly}
                      data-price={fmt(tier.price)}
                      data-upfront={fmt(upfrontPrice(tier.price, discount))}
                      data-month={monthly(tier)}
                    />
                    <span class="opt__name">
                      {tier.name}
                      {tier.id === 'love' && <span class="opt__heart" set:html={heart} />}
                    </span>
                    <span class="opt__price">{fmt(tier.price)}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="rg__set">
              <legend class="rg__legend">{r.payLegend}</legend>
              <div class="rg__opts">
                <label class="opt">
                  <input type="radio" name="payment" value="full" checked />
                  <span class="opt__name">{r.payFull}</span>
                  <span class="opt__price">
                    <span data-now="full">{fmt(upfrontPrice(first.price, discount))}</span>
                    {discount > 0 && (
                      <span class="opt__was">
                        <s data-was="full">{fmt(first.price)}</s> <span class="opt__off">{off}</span>
                      </span>
                    )}
                  </span>
                </label>
                <label class="opt">
                  <input type="radio" name="payment" value="monthly" />
                  <span class="opt__name">{r.payMonthly}</span>
                  <span class="opt__price">
                    <span data-now="monthly">{monthly(first)}</span>
                  </span>
                </label>
                <label class="opt">
                  <input type="radio" name="payment" value="bank" />
                  <span class="opt__name">{r.payBank}</span>
                  <span class="opt__price">
                    <span data-now="bank">{fmt(upfrontPrice(first.price, discount))}</span>
                    {discount > 0 && (
                      <span class="opt__was">
                        <s data-was="bank">{fmt(first.price)}</s> <span class="opt__off">{off}</span>
                      </span>
                    )}
                  </span>
                </label>
              </div>
            </fieldset>

            <fieldset class="rg__set">
              <legend class="rg__legend">{r.detailsLegend}</legend>
              <div class="rg__fields">
                <div class="field">
                  <label for={id('first')}>
                    {r.firstName} <span aria-hidden="true">*</span>
                  </label>
                  <input
                    id={id('first')}
                    name="first_name"
                    autocomplete="given-name"
                    required
                    maxlength="100"
                    data-missing={r.errors.firstName}
                  />
                </div>
                <div class="field">
                  <label for={id('last')}>
                    {r.lastName} <span aria-hidden="true">*</span>
                  </label>
                  <input
                    id={id('last')}
                    name="last_name"
                    autocomplete="family-name"
                    required
                    maxlength="100"
                    data-missing={r.errors.lastName}
                  />
                </div>
                <div class="field">
                  <label for={id('email')}>
                    {r.email} <span aria-hidden="true">*</span>
                  </label>
                  <input
                    id={id('email')}
                    name="email"
                    type="email"
                    autocomplete="email"
                    inputmode="email"
                    autocapitalize="off"
                    spellcheck="false"
                    required
                    maxlength="254"
                    data-missing={r.errors.email}
                    data-mismatch={r.errors.emailInvalid}
                  />
                </div>
                <div class="field">
                  <label for={id('phone')}>
                    {r.phone} <span aria-hidden="true">*</span>
                  </label>
                  <input
                    id={id('phone')}
                    name="phone"
                    type="tel"
                    autocomplete="tel"
                    inputmode="tel"
                    required
                    minlength="5"
                    maxlength="40"
                    pattern="[0-9+\(\)\s.\-\/]{5,40}"
                    data-missing={r.errors.phone}
                    data-mismatch={r.errors.phoneInvalid}
                  />
                </div>
                <div class="field rg__wide">
                  <label for={id('address')}>
                    {r.address} <span class="rg__optional">({r.optional})</span>
                  </label>
                  <input id={id('address')} name="address" autocomplete="street-address" maxlength="300" />
                </div>
                <div class="field rg__wide">
                  <label for={id('certificate')}>
                    {r.certificate} <span aria-hidden="true">*</span>
                  </label>
                  <input
                    id={id('certificate')}
                    name="certificate_name"
                    autocomplete="off"
                    required
                    maxlength="200"
                    data-missing={r.errors.certificate}
                  />
                </div>
              </div>
            </fieldset>

            {/* The terms the box below accepts, at hand: the link in its label opens them here */}
            <details class="rg__terms" id={id('terms')}>
              <summary>
                <span>{r.termsTitle}</span>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                  <path d="M4 12.3c5-.9 11-.6 16-.4" />
                  <path class="rg__terms-v" d="M12.2 4c-.6 5-.5 11 0 16" />
                </svg>
              </summary>
              <div class="prose rg__terms-body">
                {course.registrationNote && <p>{course.registrationNote}</p>}
                {course.paymentNotes?.map((note) => <p>{note}</p>)}
                {course.cancellations && <Fragment set:html={course.cancellations} />}
              </div>
            </details>

            <div class="field rg__agree">
              <label class="rg__check">
                <input type="checkbox" name="terms" required data-missing={r.errors.terms} />
                <span>
                  {r.termsBefore}
                  <a href={`#${id('terms')}`} data-terms-open>
                    {r.termsLink}
                  </a>{' '}
                  <span aria-hidden="true">*</span>
                </span>
              </label>
            </div>

            {/* Robots fill every field; people never see this one */}
            <div class="rg__trap" aria-hidden="true">
              <label>
                Website <input name="website" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <div class="rg__actions">
              <p class="rg__total">
                {r.total}: <strong data-total>{fmt(upfrontPrice(first.price, discount))}</strong>
                {/* an upfront discount: under the amount, the whole price struck through and its mark */}
                {
                  discount > 0 && (
                    <span class="opt__was" data-total-off>
                      <s data-was="total">{fmt(first.price)}</s> <span class="opt__off">{off}</span>
                    </span>
                  )
                }
              </p>
              <button
                class="btn"
                type="submit"
                data-submit
                data-card={r.submitCard}
                data-bank={r.submitBank}
                data-sending={r.sending}
              >
                {r.submitCard}
              </button>
              <p class="rg__privacy">{r.privacy}</p>
              <div class="rg__failed" role="alert" data-failed hidden>
                <p>{r.failed}</p>
                <p>
                  <a class="btn btn--ghost" href={first.payInFull} data-continue>
                    {r.continue}
                  </a>
                </p>
              </div>
            </div>
          </form>

          {/* After a bank-transfer registration (or when it could not be kept): the account */}
          <div class="rg__done" data-done tabindex="-1" hidden>
            <h3 class="rg__done-title t-3" data-done-title>
              {r.doneTitle}
            </h3>
            <p data-done-text data-ok={r.doneBank} data-failed-text={r.failedBank}>
              {r.doneBank}
            </p>
            <p class="rg__total" data-done-total>
              {r.total}: <strong data-total>{fmt(upfrontPrice(first.price, discount))}</strong>
            </p>
            <dl class="rg__bank" data-done-bank>
              <div>
                <dt>{bank.bankLabel}</dt>
                <dd>{bank.bank}</dd>
              </div>
              <div>
                <dt>{bank.holderLabel}</dt>
                <dd>{bank.holder}</dd>
              </div>
              <div>
                <dt>IBAN</dt>
                {/* One click selects the whole number, to copy it exactly */}
                <dd class="rg__iban" translate="no">
                  {bank.iban}
                </dd>
              </div>
            </dl>
            <ul class="prose rg__bank-notes" data-done-bank>
              {bank.notes.map((note) => (
                <li set:html={note} />
              ))}
            </ul>
            <p class="rg__ask">
              <a href={`mailto:${site.emails[0]}`}>{site.emails[0]}</a>
            </p>
          </div>
        </div>
      </div>
    </dialog>
  )
}

<script>
  import { addRow } from '../../lib/forms';

  type Pay = 'full' | 'monthly' | 'bank';
  type Control = HTMLInputElement;

  const motionOn = () => document.documentElement.classList.contains('motion');
  // An id for the registration, made here so the Stripe payment can carry it back
  const newId = (): string => {
    if (typeof crypto.randomUUID === 'function') return crypto.randomUUID();
    const b = crypto.getRandomValues(new Uint8Array(16));
    b[6] = (b[6] & 0x0f) | 0x40;
    b[8] = (b[8] & 0x3f) | 0x80;
    const h = [...b].map((x) => x.toString(16).padStart(2, '0')).join('');
    return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;
  };
  // The tier's Stripe link with the registration's id, and nothing else, added to it
  const withReference = (link: string, reference: string) => {
    const url = new URL(link);
    url.searchParams.set('client_reference_id', reference);
    return url.href;
  };
  const pageLocale = () => {
    const lang = document.documentElement.lang;
    return lang === 'en' || lang === 'grc' ? lang : 'el';
  };

  // The form's own words for each field, given to the site's field messages (scripts/fields.ts)
  function check(control: Control) {
    control.setCustomValidity('');
    const v = control.validity;
    const text = v.valueMissing
      ? control.dataset.missing
      : v.typeMismatch || v.patternMismatch || v.tooShort
        ? control.dataset.mismatch
        : '';
    if (text) control.setCustomValidity(text);
  }

  let opener: HTMLElement | null = null;

  function bind(dialog: HTMLDialogElement) {
    const form = dialog.querySelector<HTMLFormElement>('[data-register-form]')!;
    const done = dialog.querySelector<HTMLElement>('[data-done]')!;
    const failed = dialog.querySelector<HTMLElement>('[data-failed]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const scroll = dialog.querySelector<HTMLElement>('[data-register-scroll]')!;
    const field = (name: string) => form.elements.namedItem(name) as Control;
    const tierInput = () => form.querySelector<HTMLInputElement>('input[name="tier"]:checked')!;
    const payment = () => (form.querySelector<HTMLInputElement>('input[name="payment"]:checked')!.value as Pay);
    const off = dialog.dataset.off ?? '';

    // The amounts follow the tuition chosen; the button names what comes next
    const update = () => {
      const tier = tierInput().dataset;
      const pay = payment();
      dialog.querySelectorAll<HTMLElement>('[data-now="full"], [data-now="bank"]').forEach((el) => (el.textContent = tier.upfront!));
      dialog.querySelectorAll<HTMLElement>('[data-was]').forEach((el) => (el.textContent = tier.price!));
      dialog.querySelector<HTMLElement>('[data-now="monthly"]')!.textContent = tier.month!;
      const total = pay === 'monthly' ? tier.month! : tier.upfront!;
      dialog.querySelectorAll<HTMLElement>('[data-total]').forEach((el) => (el.textContent = total));
      const mark = dialog.querySelector<HTMLElement>('[data-total-off]');
      if (mark) mark.hidden = pay === 'monthly' || !off;
      if (!submit.disabled) submit.textContent = pay === 'bank' ? submit.dataset.bank! : submit.dataset.card!;
    };
    form.addEventListener('change', (event) => {
      if ((event.target as HTMLInputElement).type === 'radio') update();
    });

    // Every field's message in the form's own words, kept up to date as it is filled in
    const controls = [...form.querySelectorAll<Control>('input[data-missing]')];
    controls.forEach((control) => {
      check(control);
      control.addEventListener('input', () => check(control));
      control.addEventListener('change', () => check(control));
    });

    // The name for the certificate follows the first and last name, until it is written by hand
    const certificate = field('certificate_name');
    let ownName = false;
    certificate.addEventListener('input', () => (ownName = certificate.value.trim() !== ''));
    ['first_name', 'last_name'].forEach((name) =>
      field(name).addEventListener('input', () => {
        if (ownName) return;
        certificate.value = `${field('first_name').value.trim()} ${field('last_name').value.trim()}`.trim();
        check(certificate);
        // lets the site's field messages see the change
        certificate.dispatchEvent(new Event('change', { bubbles: true }));
      }),
    );

    // After a send the browser stops for missing answers: the first of them takes the focus (the site's
    // field script would pick the fieldset, which also counts as invalid)
    submit.addEventListener('click', () =>
      requestAnimationFrame(() => {
        const first = form.querySelector<HTMLInputElement>('input:invalid');
        if (first && document.activeElement !== first) first.focus();
      }),
    );

    // "the Terms of participation": open them here, in the form
    form.querySelector('[data-terms-open]')!.addEventListener('click', (event) => {
      event.preventDefault();
      const terms = dialog.querySelector<HTMLDetailsElement>('.rg__terms')!;
      terms.open = true;
      terms.scrollIntoView({ block: 'start', behavior: motionOn() ? 'smooth' : 'auto' });
    });

    const busy = (on: boolean) => {
      submit.disabled = on;
      submit.setAttribute('aria-busy', String(on));
      submit.textContent = on ? submit.dataset.sending! : payment() === 'bank' ? submit.dataset.bank! : submit.dataset.card!;
    };
    // Back from Stripe with the browser's back button, the page comes back as it was left
    window.addEventListener('pageshow', () => busy(false));

    const showDone = (kept: boolean, bankDetails: boolean) => {
      const text = done.querySelector<HTMLElement>('[data-done-text]')!;
      done.querySelector<HTMLElement>('[data-done-title]')!.hidden = !kept;
      text.textContent = kept ? text.dataset.ok! : text.dataset.failedText!;
      text.hidden = !bankDetails;
      done.querySelectorAll<HTMLElement>('[data-done-bank], [data-done-total]').forEach((el) => (el.hidden = !bankDetails));
      form.hidden = true;
      done.hidden = false;
      scroll.scrollTo(0, 0);
      done.focus();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      failed.hidden = true;
      const tier = tierInput();
      const pay = payment();
      const link = pay === 'full' ? tier.dataset.full! : pay === 'monthly' ? tier.dataset.monthly! : '';
      // A robot filled the hidden field: keep nothing, send nowhere, thank it
      if (field('website').value) return showDone(true, false);

      const reference = newId();
      const value = (name: string) => field(name).value.trim();
      const row: Record<string, unknown> = {
        id: reference,
        course: dialog.dataset.registerDialog,
        tier: tier.value,
        payment: pay,
        first_name: value('first_name'),
        last_name: value('last_name'),
        email: value('email'),
        phone: value('phone'),
        certificate_name: value('certificate_name'),
        terms_accepted: true,
        locale: pageLocale(),
      };
      if (value('address')) row.address = value('address');

      busy(true);
      try {
        await addRow('registrations', row);
      } catch {
        busy(false);
        // Not kept: say so, and still offer the way to pay
        if (link) {
          failed.querySelector<HTMLAnchorElement>('[data-continue]')!.href = link;
          failed.hidden = false;
          failed.scrollIntoView({ block: 'nearest' });
        } else showDone(false, true);
        return;
      }
      if (link) window.location.assign(withReference(link, reference));
      else {
        busy(false);
        showDone(true, true);
      }
    });

    // Closing: the cross, Escape, or a press that starts and ends on the backdrop
    dialog.querySelector('[data-register-close]')!.addEventListener('click', () => dialog.close());
    let pressedBackdrop = false;
    dialog.addEventListener('pointerdown', (event) => (pressedBackdrop = event.target === dialog));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog && pressedBackdrop) dialog.close();
    });
    dialog.addEventListener('close', () => {
      // after a finished registration, the next opening starts afresh
      if (!done.hidden) {
        form.reset();
        ownName = false;
        controls.forEach(check);
        done.hidden = true;
        form.hidden = false;
      }
      failed.hidden = true;
      if (opener?.isConnected) opener.focus({ preventScroll: true });
      opener = null;
    });

    return (tierId: string, pay: Pay) => {
      const tier = form.querySelector<HTMLInputElement>(`input[name="tier"][value="${CSS.escape(tierId)}"]`);
      if (tier) tier.checked = true;
      const way = form.querySelector<HTMLInputElement>(`input[name="payment"][value="${pay}"]`);
      if (way) way.checked = true;
      update();
      scroll.scrollTo(0, 0);
      // With a mouse and keyboard the first field is ready to type in; on a touch screen that would
      // raise the keyboard over the form at once
      field('first_name').autofocus = matchMedia('(hover: hover) and (pointer: fine)').matches && done.hidden;
      dialog.showModal();
    };
  }

  const openers = new WeakMap<HTMLDialogElement, (tier: string, pay: Pay) => void>();
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLDialogElement>('dialog[data-register-dialog]:not([data-ready])').forEach((dialog) => {
      if (typeof dialog.showModal !== 'function') return;
      dialog.setAttribute('data-ready', '');
      openers.set(dialog, bind(dialog));
    });
  });

  // One listener for every tier button on every page, added once. Capture phase: it answers before
  // the page router treats the link as navigation. Where the course's form is not on the page, the
  // link simply goes to Stripe.
  const root = document.documentElement as HTMLElement & { athRegister?: boolean };
  if (!root.athRegister) {
    root.athRegister = true;
    document.addEventListener(
      'click',
      (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const from = event.target instanceof Element ? event.target.closest<HTMLElement>('a[data-register]') : null;
        if (!from) return;
        const dialog = document.querySelector<HTMLDialogElement>(
          `dialog[data-register-dialog="${CSS.escape(from.dataset.register!)}"][data-ready]`,
        );
        const open = dialog && openers.get(dialog);
        if (!open) return;
        event.preventDefault();
        opener = from;
        open(from.dataset.tier ?? '', (from.dataset.pay as Pay) ?? 'full');
      },
      true,
    );
  }
</script>

<style>
  .rg {
    --rg-max: calc(100dvh - 1.5rem);
    width: min(100% - 1rem, 44rem);
    max-width: none;
    max-height: var(--rg-max);
    margin: auto;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    overflow: visible;
  }
  .rg::backdrop {
    background: color-mix(in srgb, var(--blue-deep, #071260) 62%, transparent);
  }
  :global(html:has(dialog.rg[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }
  :global(html.motion) .rg[open] {
    transition:
      opacity var(--dur-1) var(--ease-soft),
      transform var(--dur-2) var(--ease-out);
  }
  @starting-style {
    :global(html.motion) .rg[open] {
      opacity: 0;
      transform: translate3d(0, 1.5rem, 0) scale(0.96);
    }
  }

  /* The sheet: rough-cut paper, as the course popup. Colour and edge live on ::before so the text is never distorted. */
  .rg__sheet {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    max-height: var(--rg-max);
    border-radius: 2.2rem 2.8rem 2.4rem 3rem / 2.8rem 2.2rem 3rem 2.4rem;
  }
  .rg__sheet::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-color: var(--creme);
    background-image: var(--grain);
    background-size: 400px 400px;
    filter: url(#rough);
  }
  .rg__scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 3.5rem clamp(1.1rem, 0.4rem + 3.4vw, 2.75rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: inherit;
  }
  .rg__close {
    position: absolute;
    top: 0.8rem;
    right: 0.9rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1.5px solid color-mix(in srgb, var(--blue) 28%, transparent);
