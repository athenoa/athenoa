---
// How to register for a course: until when, the ways to pay (TuitionTiers.astro: their buttons open the registration form, RegisterDialog.astro, and from
// there Stripe), the notes on paying, then the registration form's further ways and terms as closed
// items (bank transfer, cancellations, scholarships). Membership is the tiers' last column.
// Shared by the course page, the course popup and the home page's course detail.
import TuitionTiers from './TuitionTiers.astro';
import { feeOf, fill, money } from './money';
import { membershipFor } from '../../data/membership';
import { content } from '../../data';
import type { Course } from '../../data/courses';
import { getLocale } from '../../lib/locale';

interface Props {
  course: Course;
  /** Heading level of each tuition's name, under the heading of the registration section */
  level?: 3 | 4;
}
const { course, level = 3 } = Astro.props;
const locale = getLocale(Astro.url);
const { coursesPage, site } = content(locale);
const { tuition, membership, registration } = coursesPage.ui;
const { bank } = registration;
const discount = course.upfrontDiscount ?? 0;
// Membership as the alternative, the last column beside the tiers (as on the Academy's old page): its
// standard price, paid upfront less its discount or by the month, and the way to its page
const yearly = membershipFor(locale).registration;
const memberFee = yearly.tiers[0] ? feeOf(yearly.tiers[0], yearly.upfrontDiscount ?? 0, locale) : null;
const member = memberFee && {
  title: membership.title,
  text: membership.text,
  cta: membership.cta,
  href: site.routes.membership,
  now: memberFee.now,
  was: memberFee.was,
  off: memberFee.pct ? fill(tuition.off, { pct: memberFee.pct }) : '',
  month: `${memberFee.month} ${tuition.month} ${fill(tuition.payments, { n: memberFee.payments })} · ${fill(tuition.total, { price: money(Math.round(yearly.tiers[0].perMonth * yearly.tiers[0].payments * 100) / 100, locale) })}`,
  payments: memberFee.payments,
};
// The closed items under the tuition. The cancellation terms belong to each course (their dates differ).
const more = [
  { id: 'bank', title: bank.title },
  course.cancellations ? { id: 'cancellations', title: registration.cancellations, html: course.cancellations } : null,
  { id: 'scholarships', title: registration.scholarships.title, html: registration.scholarships.html },
].filter((item) => item !== null);
---

<div class="reginfo">
  {/* HTML: it may link the Academy's secretariat */}
  {course.registrationOpen && <p class="reginfo__open" set:html={course.registrationOpen} />}
  {
    course.tuition && (
      <TuitionTiers
        tiers={course.tuition}
        level={level}
        payInFull={tuition.payInFull}
        payMonthly={tuition.payMonthly}
        month={tuition.month}
        or={tuition.or}
        payments={tuition.payments}
        total={tuition.total}
        discount={discount}
        off={tuition.off}
        course={course.slug}
        member={member ?? undefined}
      />
    )
  }
  <div class="prose reginfo__notes">
    {course.registrationNote && <p>{course.registrationNote}</p>}
    {course.paymentNotes?.map((note) => <p>{note}</p>)}
  </div>

  <div class="more">
    {
      more.map((item) => (
        <details class="more__item" id={`${course.slug}-${item.id}`}>
          <summary>
            <span class="more__title">{item.title}</span>
            <svg class="more__mark" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
              <path d="M4 12.3c5-.9 11-.6 16-.4" />
              <path class="more__mark-v" d="M12.2 4c-.6 5-.5 11 0 16" />
            </svg>
          </summary>
          {item.id === 'bank' ? (
            <div class="more__body">
              <dl class="bank">
                <div>
                  <dt>{bank.bankLabel}</dt>
                  <dd>{bank.bank}</dd>
                </div>
                <div>
                  <dt>{bank.holderLabel}</dt>
                  <dd>{bank.holder}</dd>
                </div>
                <div>
                  <dt>IBAN</dt>
                  {/* One click selects the whole number, to copy it exactly */}
                  <dd class="bank__iban" translate="no">
                    {bank.iban}
                  </dd>
                </div>
              </dl>
              <ul class="prose bank__notes">
                {bank.notes.map((note) => (
                  <li set:html={note} />
                ))}
              </ul>
              {/* Registering to pay this way: the form, set to bank transfer (without JavaScript, an email) */}
              {course.tuition?.length ? (
                <p class="bank__register">
                  <a
                    class="btn btn--ghost"
                    href={`mailto:${site.emails[0]}`}
                    data-register={course.slug}
                    data-tier={course.tuition[0].id}
                    data-pay="bank"
                  >
                    {tuition.bankRegister}
                  </a>
                </p>
              ) : null}
            </div>
          ) : (
            <div class="more__body prose" set:html={item.html} />
          )}
        </details>
      ))
    }
  </div>

</div>

<style>
  .reginfo {
    display: grid;
    gap: var(--space-m);
  }
  .reginfo__open {
    font-weight: 560;
  }
  .bank__register {
    margin-top: var(--space-s);
  }
  .reginfo__notes {
    font-size: var(--step--1);
  }

  /* The further ways and terms: closed items with a hand-drawn plus, like the popup's sections */
  .more {
    display: grid;
    gap: 0.5rem;
  }
  .more__item {
    border: 1.5px solid var(--line);
    border-radius: 1.4rem 1.7rem 1.5rem 1.8rem / 1.7rem 1.4rem 1.8rem 1.5rem;
  }
  .more__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem 0.85rem 1.25rem;
    list-style: none;
    cursor: pointer;
    border-radius: inherit;
  }
  .more__item summary::-webkit-details-marker {
    display: none;
  }
  .more__title {
    font-weight: 560;
  }
  .more__mark {
    flex: none;
  }
  .more__mark path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    transform-origin: 12px 12px;
    transition:
      transform var(--dur-2) var(--ease-out),
      opacity var(--dur-1);
  }
  .more__item[open] .more__mark-v {
    transform: rotate(90deg);
    opacity: 0;
  }
  .more__body {
    padding: 0 1.25rem 1.25rem;
    font-size: var(--step--1);
  }

  /* Each label over its value, so the account number has the whole width */
  .bank {
    display: grid;
    gap: 0.55rem;
    margin: 0 0 var(--space-s);
  }
  .bank dt {
    color: var(--ink-soft);
  }
  .bank dd {
    margin: 0;
  }
  /* The account number: never hyphenated or broken inside a group, and selected whole in one click */
  .bank__iban {
    font-size: var(--step-0);
    font-variant-numeric: lining-nums tabular-nums;
    letter-spacing: 0.03em;
    hyphens: none;
    overflow-wrap: normal;
    word-break: keep-all;
    -webkit-user-select: all;
    user-select: all;
  }
</style>
