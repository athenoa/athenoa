---
import { bee as beeSvg } from './bee';
// Bees for the membership page (Maria, 22 November 2026), in place of the tetractys: a small swarm
// hovering over the light-blue pebble, and now and then a bee that crosses the window, or flies in,
// settles on something on the page (the pebble, the banner, a price, a button) for a few seconds and
// leaves again. The bee (μέλισσα) is an old figure of the soul and of the gathering of wisdom: Plato
// has the gentle, civic souls come back as bees (Phaedo 82b), and the Pythia was "the Delphic bee".
// Drawn in the site's ink: round strokes in the page's ink colour on paper, wings in light blue.
// Motion only under html.motion (the swarm then hovers and the visitors fly); without it the swarm
// stands still and no bee visits. Every bee is decoration (aria-hidden) and lets clicks through.
interface Props {
  class?: string;
  [key: string]: unknown;
}
const { class: className, ...rest } = Astro.props;

// One bee, facing right, its wings attached at their lower edge so they can beat from there.
const bee = beeSvg;

// The swarm: where each bee hovers in the mark (centre, % of the box), its turn, size and the moment
// its hovering begins, so no two move together
const swarm = [
  { x: 20, y: 22, r: -14, s: 1, d: 0 },
  { x: 54, y: 12, r: 8, s: 0.86, d: -0.7 },
  { x: 84, y: 30, r: 22, s: 0.94, d: -1.9 },
  { x: 34, y: 50, r: -5, s: 1.12, d: -1.2 },
  { x: 66, y: 50, r: 12, s: 0.9, d: -2.6 },
  { x: 10, y: 74, r: -24, s: 0.8, d: -0.4 },
  { x: 46, y: 82, r: 6, s: 0.96, d: -3.1 },
  { x: 80, y: 76, r: -10, s: 0.84, d: -1.5 },
  { x: 100, y: 54, r: 30, s: 0.74, d: -2.2 },
];
// On arrival each bee flies in from its own side, from a few rem away, in turn (Maria, 23 November 2026)
const arrive = (i: number) => {
  const angle = (i * 137.5 * Math.PI) / 180;
  return { x: +(Math.cos(angle) * 9).toFixed(1), y: +(Math.sin(angle) * 6 - 3).toFixed(1) };
};
---

<div class:list={['bees', className]} aria-hidden="true" data-bees {...rest}>
  {
    swarm.map((b, i) => (
      <span
        class="bee bee--swarm"
        style={`--x:${b.x}%;--y:${b.y}%;--r:${b.r}deg;--s:${b.s};--d:${b.d}s;--fx:${arrive(i).x}rem;--fy:${arrive(i).y}rem;--at:${(0.35 + i * 0.12).toFixed(2)}s`}
        set:html={bee}
      />
    ))
  }
  <template data-bee-template><span class="bee bee--visitor" set:html={bee} /></template>
</div>

<script>
  // The visitors: one bee now and then, never more than two at a time. A crossing flies across the
  // window and away; a visit flies in, settles on top of something on the page, rests, and leaves.
  type Point = { x: number; y: number };
  // things with a visible top edge to land on (a heading's box starts well above its letters)
  const SPOTS = ['.mem__mark', '.mem__banner', '.mem__text', '.tier', '.way', '.mem .btn'];
  let timers: number[] = [];
  let flying = 0;

  const rand = (a: number, b: number) => a + Math.random() * (b - a);
  const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));

  // keyframes along a line with a gentle wobble, the bee turned along its way (never more than 35°)
  function path(from: Point, to: Point, wobble: number, settle: boolean, size: number) {
    const left = to.x < from.x;
    const dx = to.x - from.x;
    const dy = to.y - from.y;
    const len = Math.hypot(dx, dy) || 1;
    const nx = -dy / len;
    const ny = dx / len;
    const waves = rand(1.5, 3);
    const phase = rand(0, Math.PI * 2);
    const steps = 24;
    const at = (t: number) => {
      const fade = settle ? Math.sin(Math.PI * t) * (1 - t) * 1.6 : 1;
      const w = Math.sin(Math.PI * 2 * waves * t + phase) * wobble * fade;
      return { x: from.x + dx * t + nx * w, y: from.y + dy * t + ny * w };
    };
    const frames: Keyframe[] = [];
    for (let i = 0; i <= steps; i++) {
      const t = i / steps;
      const p = at(t);
      const q = at(Math.min(1, t + 0.02));
      const r = at(Math.max(0, t - 0.02));
      let angle = (Math.atan2(q.y - r.y, q.x - r.x) * 180) / Math.PI;
      if (left) angle = angle > 0 ? angle - 180 : angle + 180;
      angle = settle && i === steps ? 0 : Math.max(-35, Math.min(35, angle));
      frames.push({
        transform: `translate(${(p.x - size / 2).toFixed(1)}px, ${(p.y - size * 0.375).toFixed(1)}px) rotate(${angle.toFixed(1)}deg) scaleX(${left ? -1 : 1})`,
      });
    }
    return { frames, left };
  }

  function make(root: HTMLElement, fixed: boolean) {
    const template = root.querySelector<HTMLTemplateElement>('[data-bee-template]');
    const bee = template?.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
    if (!bee) return null;
    bee.classList.add(fixed ? 'bee--fixed' : 'bee--page');
    document.body.append(bee);
    return bee;
  }

  function cross(root: HTMLElement) {
    const bee = make(root, true);
    if (!bee) return;
    flying++;
    const size = bee.offsetWidth;
    const fromLeft = Math.random() < 0.5;
    const y = innerHeight * rand(0.2, 0.8);
    const from = { x: fromLeft ? -size : innerWidth + size, y };
    const to = { x: fromLeft ? innerWidth + size : -size, y: y + innerHeight * rand(-0.18, 0.18) };
    const { frames } = path(from, to, rand(18, 46), false, size);
    const fly = bee.animate(frames, { duration: (Math.hypot(to.x - from.x, to.y - from.y) / rand(150, 230)) * 1000, easing: 'linear' });
    fly.onfinish = fly.oncancel = () => {
      bee.remove();
      flying--;
    };
  }

  function visit(root: HTMLElement) {
    // something in view, below the header, to settle on
    const spots = SPOTS.flatMap((s) => Array.from(document.querySelectorAll<HTMLElement>(s))).filter((el) => {
      const r = el.getBoundingClientRect();
      return r.width > 60 && r.top > 110 && r.top < innerHeight - 80;
    });
    if (!spots.length) return cross(root);
    const spot = spots[Math.floor(Math.random() * spots.length)].getBoundingClientRect();
    const bee = make(root, false);
    if (!bee) return;
    flying++;
    const size = bee.offsetWidth;
    const sx = scrollX;
    const sy = scrollY;
    const seat = { x: spot.left + sx + spot.width * rand(0.18, 0.82), y: spot.top + sy - size * 0.36 };
    const fromLeft = seat.x - sx > innerWidth / 2 ? false : true;
    const start = { x: sx + (fromLeft ? -size : innerWidth + size), y: sy + innerHeight * rand(0.05, 0.6) };
    const inward = path(start, seat, rand(14, 30), true, size);
    const arrive = bee.animate(inward.frames, { duration: rand(2300, 3300), easing: 'cubic-bezier(.3,.6,.35,1)', fill: 'forwards' });
    const done = () => {
      bee.remove();
      flying--;
    };
    arrive.oncancel = done;
    arrive.onfinish = () => {
      bee.classList.add('is-sitting');
      later(() => {
        if (!bee.isConnected) return;
        bee.classList.remove('is-sitting');
        const away = { x: seat.x + (inward.left ? -1 : 1) * rand(innerWidth * 0.5, innerWidth * 0.9), y: sy - size * 2 };
        const out = path(seat, away, rand(12, 26), false, size);
        const leave = bee.animate(out.frames, { duration: rand(2200, 3000), easing: 'cubic-bezier(.5,0,.75,.6)', fill: 'forwards' });
        leave.onfinish = leave.oncancel = done;
      }, rand(3500, 7000));
    };
  }

  function next(root: HTMLElement, first = false) {
    later(
      () => {
        if (!document.hidden && root.isConnected && flying < 2) (Math.random() < 0.55 ? cross : visit)(root);
        if (root.isConnected) next(root);
      },
      first ? rand(2500, 4500) : rand(7000, 15000),
    );
  }

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-bees]');
    if (!root || !document.documentElement.classList.contains('motion')) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    next(root, true);
  });
  // leaving the page: no bee follows the visitor to the next one
  document.addEventListener('astro:before-swap', () => {
    timers.forEach(clearTimeout);
    timers = [];
    flying = 0;
    document.querySelectorAll('.bee--visitor').forEach((bee) => bee.remove());
  });
</script>

<style>
  .bees {
    position: relative;
    aspect-ratio: 1;
  }
  .bee {
    display: block;
    width: var(--bee, 2.6rem);
    color: var(--ink-strong, currentColor);
    pointer-events: none;
  }
  .bee :global(.bee__svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .bee :global(.bee__wing) {
    fill: color-mix(in srgb, var(--blue-light) 70%, transparent);
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  /* the swarm: each bee at its place in the mark, turned its own way */
  .bee--swarm {
    --bee: 34%;
    position: absolute;
    left: var(--x);
    top: var(--y);
    translate: -50% -50%;
    rotate: var(--r);
    scale: var(--s);
  }

  /* the visitors live on the page itself (appended to body), so these rules are global */
  :global(.bee--visitor) {
    --bee: clamp(1.7rem, 1.3rem + 1vw, 2.3rem);
    position: absolute;
    left: 0;
    top: 0;
    z-index: 45;
    width: var(--bee);
    color: var(--ink-strong);
    pointer-events: none;
    will-change: transform;
  }
  :global(.bee--visitor.bee--fixed) {
    position: fixed;
  }

  @keyframes bee-hover {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
    35% {
      transform: translate(0.16rem, -0.22rem) rotate(3deg);
    }
    70% {
      transform: translate(-0.14rem, 0.12rem) rotate(-3deg);
    }
  }
  @keyframes bee-flap {
    to {
      transform: scaleY(0.3);
    }
  }
  /* resting: the wings lie still and now and then shiver */
  @keyframes bee-rest {
    0%,
    86%,
    100% {
      transform: scaleY(1);
    }
    90%,
    96% {
      transform: scaleY(0.55);
    }
  }
  /* arrival: from outside the pebble, a slight swerve, then hovering in place */
  @keyframes bee-arrive {
    0% {
      opacity: 0;
      transform: translate(var(--fx), var(--fy)) rotate(-12deg);
    }
    20% {
      opacity: 1;
    }
    60% {
      transform: translate(calc(var(--fx) * 0.25 + 0.6rem), calc(var(--fy) * 0.2 - 0.5rem)) rotate(6deg);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
  :global(html.motion) .bee--swarm {
    animation: bee-arrive 1.5s cubic-bezier(0.3, 0.7, 0.3, 1) var(--at) both;
  }
  :global(html.motion) .bee--swarm :global(.bee__svg) {
    animation: bee-hover 3.2s ease-in-out var(--d) infinite;
  }
  :global(html.motion) .bee :global(.bee__wing),
  :global(html.motion .bee--visitor .bee__wing) {
    animation: bee-flap 0.09s linear infinite alternate;
  }
  :global(html.motion) .bee :global(.bee__wing--front),
  :global(html.motion .bee--visitor .bee__wing--front) {
    animation-delay: -0.045s;
  }
  :global(html.motion .bee--visitor.is-sitting .bee__wing) {
    animation: bee-rest 2.6s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.bee--visitor) {
      display: none;
    }
  }
</style>
