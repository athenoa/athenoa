---
// Home: "Living Transmission". A darker-blue night cut-out with a sea of waves along its foot, drawn in
// three tones; the photograph, with a light-blue rim in its own shape, overlaps the cut-out's edge, and a torch
// (the flame handed on) stands beside the call to enrol.
import Media from '../Media.astro';
import waves from '../../assets/illustrations/waves.svg?raw';
import night from '../../assets/media/night-acropolis.png';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

const locale = getLocale(Astro.url);
const { transmission } = content(locale).home;
const t = {
  en: {
    photoAlt: 'A woman in a white blouse and a blue shawl sits in the dark, the floodlit Acropolis glowing behind her',
  },
  el: {
    photoAlt:
      'Μια γυναίκα με λευκή μπλούζα και μπλε εσάρπα κάθεται στο σκοτάδι, με τη φωταγωγημένη Ακρόπολη να λάμπει πίσω της',
  },
  grc: {
    photoAlt: 'Γυνὴ λευκὸν χιτωνίσκον καὶ κυανοῦν ἱμάτιον ἔχουσα ἐν σκότῳ κάθηται, ὄπισθεν δ’ αὐτῆς ἡ Ἀκρόπολις πεφωτισμένη λάμπει',
  },
}[locale];
// The three bands of sea are one drawing (src/assets/illustrations/waves.svg, 50 KB with its moving
// lines). It is written into the page once, in the middle band, and the other two show that same
// drawing through <use>: the page is 100 KB lighter and the browser moves one set of lines instead of
// three. Each band keeps its own colour (currentColor), place and depth, as before.
const wavesOpen = waves.match(/^<svg[^>]*>/)![0];
const wavesBody = waves.slice(wavesOpen.length).replace(/<\/svg>\s*$/, '');
const wavesSource = `${wavesOpen}<g id="trans-waves">${wavesBody}</g></svg>`;
const wavesCopy = `${wavesOpen}<use href="#trans-waves"></use></svg>`;
---

<section class="trans section" aria-labelledby="transmission-title">
  <div class="wrap trans__grid">
    <div class="trans__photo" data-depth="-0.06">
      <span class="trans__mat" aria-hidden="true"></span>
      <Media
        src={night}
        alt={t.photoAlt}
        shape="pebble-2"
        ratio="6 / 5"
        focus="58% 50%"
        widths={[360, 520, 690]}
        sizes="(min-width: 60rem) 32rem, 80vw"
      />
    </div>

    <div class="trans__panel panel panel--big on-blue-deep">
      <div class="panel__clip" aria-hidden="true">
        <span class="illo illo--waves trans__waves trans__waves--1" aria-hidden="true" data-depth="0.06"
          ><Fragment set:html={wavesCopy} /></span
        >
        <span class="illo illo--waves trans__waves trans__waves--2" aria-hidden="true" data-depth="0.14"
          ><Fragment set:html={wavesSource} /></span
        >
        <span class="illo illo--waves trans__waves trans__waves--3" aria-hidden="true" data-depth="0.22"
          ><Fragment set:html={wavesCopy} /></span
        >
      </div>
      <div class="trans__text">
        <h2 class="t-2" id="transmission-title" data-split>{transmission.title}</h2>
        <p class="trans__lead" data-reveal>{transmission.text}</p>
          {/* its 'See all courses' button moved to the two buttons at the foot of the home page (Maria, 23 November 2026) */}
      </div>
    </div>
  </div>
</section>

<style>
  .trans__grid {
    position: relative;
    display: grid;
    container-type: inline-size;
  }
  /* The photograph is small (690px), so it never grows past 32rem. */
  .trans__photo {
    position: relative;
    z-index: 2;
    justify-self: end;
    width: min(78%, 32rem);
    margin: 0 clamp(1.5rem, 6%, 3.5rem) -5.5rem 0;
  }
  /* The rim: the photograph's own shape, a little larger all round (Maria, 22 November 2026: a border,
     as around the arches, not a second shape); it moves with the photograph */
  .trans__mat {
    position: absolute;
    inset: -0.8rem;
    border-radius: var(--r-pebble-2);
    background-color: var(--blue-light);
    background-image: var(--grain);
    background-size: 400px 400px;
  }
  .trans__panel {
    padding-top: 7.5rem;
    padding-bottom: calc(var(--space-xl) + 7rem);
  }
  .trans__text > * + * {
    margin-top: var(--space-m);
  }
  .trans__text h2 {
    max-width: 21ch;
  }
  .trans__lead {
    max-width: 40ch;
    font-size: var(--step-1);
    line-height: 1.36;
  }
  .trans__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s) var(--space-m);
  }

  /* Three bands of the same drawing, staggered and at different depths, make the sea:
     crème nearest, then light blue, then a mid blue far off. */
  .trans__waves {
    position: absolute;
    left: -8%;
    bottom: 1.4rem;
    width: max(116%, 46rem);
    color: var(--creme);
  }
  .trans__waves--2 {
    left: auto;
    right: -14%;
    bottom: 2.7rem;
    color: var(--blue-light);
  }
  .trans__waves--3 {
    left: -18%;
    bottom: 3.9rem;
    width: max(132%, 52rem);
    color: color-mix(in srgb, var(--blue-light) 42%, var(--blue));
  }

  @media (min-width: 60rem) {
    .trans__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
    }
    .trans__photo {
      grid-column: 1 / span 5;
      grid-row: 1;
      justify-self: start;
      width: min(100%, 32rem);
      margin: -2rem 0 3rem 1.25rem;
    }
    .trans__panel {
      grid-column: 3 / -1;
      grid-row: 1;
      padding-top: var(--space-xl);
      padding-left: calc(30% + var(--space-l));
      padding-bottom: calc(var(--space-xl) + 8rem);
    }
    /* The three bands sit close enough to weave through one another, all inside the cut-out. */
    .trans__waves--1 {
      bottom: 1.5rem;
    }
    .trans__waves--2 {
      bottom: 3.1rem;
    }
    .trans__waves--3 {
      bottom: 4.6rem;
    }
  }
</style>
