---
// Home hero. The original hero picture of athenoa.academy (the temple, Athena rising behind its
// pediment with her spear and a Nike, the flame in the doorway) redrawn as a two-ink print.
//
// CLIENT DIRECTION, 11 October 2026: the picture is full bleed (it runs under the header to the
// edges of the window, no cut-out) and its foot fades into the page below the first screen; the
// trees on the left are gone so the title can be large and tall; and the picture follows the
// day/night switch: a marble temple under a light-blue sky by day, the starry night scene by night.
//
// CLIENT DIRECTION, 22 November 2026: the temple stands in the middle of the hero at every width,
// the picture fills the whole first screen (no paper under it), the title and its subtitle stand
// above the temple, centred, a statue of Athena stands on the ground left of the temple, and the
// highlighted words are underlined with a pen stroke instead of the brush swash (kept, hidden).
//
// Artwork: src/assets/illustrations/portal-b-*.svg, generated by scripts/illustrations/portal-b-build.mjs.
// The picture layers share one square frame (viewBox 0 0 1000 1000, temple axis at x 500, the
// temple's ground at y 946). The frame is placed by --scene-h (its size), --scene-x (its centre
// line) and --scene-b (how far it stands above the foot of the first screen). --u is one drawing
// unit, so the trees and the near ground keep the same stroke weight as the rest.
import Illustration from '../Illustration.astro';
import HeroBird from './HeroBird.astro';
import FireSound from './FireSound.astro';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

const locale = getLocale(Astro.url);
const { home } = content(locale);
const highlight = home.hero.highlight;
// CLIENT DIRECTION, 11 October 2026: Athena (with her spear and the Nike) is hidden for now and may
// come back later, and so are the disc and rays behind her head, which read as a sun over the roof
// without her. Set this to true to show them all again; nothing else needs to change.
const showAthena = false;
---

<section class:list={['hero', `hero--${locale}`, !showAthena && 'hero--bare']} data-pointer-scene>
  <div class="hero__panel theme-day">
    <div class="hero__stage" aria-hidden="true">
      <div class="hero__layer hero__layer--sky" data-depth="0.5" data-pointer="-6" data-reveal="fade">
        <Illustration name="portal-b-sky" />
      </div>
      {
        [1, 2, 3].map((n) => (
          <div
            class="hero__layer hero__layer--sky hero__layer--tw"
            data-depth="0.5"
            data-pointer="-6"
            data-reveal="fade"
            style={`--n:${n - 1}`}
          >
            <Illustration name={`portal-b-stars-${n}`} />
          </div>
        ))
      }
      <div class="hero__layer hero__layer--milky" data-depth="0.42" data-pointer="-4" data-reveal="fade">
        <Illustration name="portal-b-milkyway" />
      </div>
      {/* The day sky: soft shapes of cloud with no outline drift across it, slower than the drawn clouds */}
      <div class="hero__layer hero__layer--haze" data-depth="0.46" data-reveal="fade">
        {[0, 1, 2, 3, 4, 5, 6].map((n) => <Illustration name="hero-cloud-soft" class={`hero__haze hero__haze--${n + 1}`} />)}
      </div>
      {/* Far off behind the temple, the Olympus range: two faded silhouettes a shade off the sky, with
          no outline, for depth. The clouds drift behind them (client direction, 15 October 2026: at first
          they passed in front). */}
      <div class="hero__layer hero__layer--peaks" data-depth="0.44" data-pointer="-5" data-reveal="fade">
        <Illustration name="hero-peaks" note={false} />
      </div>
      {/* The drawn clouds are gone (client direction, 11 October 2026): only the loose streaks remain */}
      <div class="hero__layer"><span class="hero__meteor"></span></div>
      {/* Now and then two birds cross the sky */}
      <div class="hero__layer hero__layer--birds" data-depth="0.3">
        <Illustration name="hero-bird" class="hero__bird hero__bird--1" />
        <Illustration name="hero-bird" class="hero__bird hero__bird--2" />
      </div>
      {
        showAthena && (
          <>
            <div class="hero__layer hero__layer--glow hero__scene" data-depth="0.3" data-reveal="fade">
              <Illustration name="portal-b-rays" draw />
            </div>
            <div class="hero__layer hero__layer--athena hero__scene" data-depth="0.22" data-reveal="fade">
              <Illustration name="portal-b-athena" draw />
            </div>
          </>
        )
      }
      <div class="hero__layer hero__layer--temple hero__scene" data-depth="0.12" data-reveal="fade">
        <Illustration name="portal-b-cella" />
        <Illustration name="portal-b-light" />
        <Illustration name="portal-b-temple" draw />
        <Illustration name="portal-b-flame" />
      </div>
      {/* The fire: two small drawings over the bowl (the dark tongue and its bright heart), so it can flicker without redrawing the temple */}
      <div class="hero__layer hero__layer--fire" data-depth="0.12" data-reveal="fade">
        <Illustration name="portal-b-fire-1" class="hero__fire hero__fire--1" />
        <Illustration name="portal-b-fire-2" class="hero__fire hero__fire--2" />
      </div>
      {/* A statue of Athena on her plinth, on the ground left of the temple (client direction, 22 November 2026) */}
      <div class="hero__layer hero__layer--statue" data-depth="0.12" data-reveal="fade">
        <Illustration name="portal-b-statue" draw />
      </div>
      <div class="hero__layer hero__layer--trees-l hero__trees" data-depth="-0.2" data-pointer="8" data-reveal="fade">
        <Illustration name="portal-b-trees-left" />
      </div>
      <div class="hero__layer hero__layer--trees-r hero__trees" data-depth="-0.28" data-pointer="12" data-reveal="fade">
        <Illustration name="portal-b-trees-right" />
      </div>
      <div class="hero__layer hero__layer--ground" data-depth="-0.1" data-pointer="5" data-reveal="fade">
        <Illustration name="portal-b-ground" />
      </div>
      <div class="hero__grain"></div>
    </div>
    <div class="hero__fade" aria-hidden="true"></div>
    <HeroBird />
    <FireSound />

    <h1 class="hero__title t-hero" data-split>
      {
        home.hero.titleLines.map((line, n) => {
          const at = line.indexOf(highlight);
          // The first line is the title; what follows is its subtitle, set smaller and shown in
          // lower case (home.hero.subtitle), because the handwritten face is unreadable in capitals.
          // (the space keeps the lines apart when the heading is read out as one sentence)
          if (at < 0)
            return (
              <>
                {n > 0 && ' '}
                <span class:list={['hero__line', n > 0 && 't-sub']}>{n > 0 ? home.hero.subtitle : line}</span>
              </>
            );
          return (
            <span class="hero__line">
              {line.slice(0, at)}
              <span class="hl">
                {highlight.split(' ').map((word, n) => (
                  <>
                    {n > 0 && ' '}
                    <span class="hl__w">{word}</span>
                  </>
                ))}
              </span>
              {line.slice(at + highlight.length)}
            </span>
          );
        })
      }
      {/* the pen strokes under the highlighted words, one per line they stand on (drawn by the script below) */}
      <span class="hero__pens" aria-hidden="true"></span>
    </h1>
  </div>
</section>

<script>
  // The swashes behind the highlighted words, centred on the letters in whatever face the browser
  // drew them with: from 0.115em above the capitals to 0.115em under the baseline. The letters' place
  // in the line comes from the face's own measures (the same ones the browser lays the line out by).
  function fitSwashes() {
    const ctx = document.createElement('canvas').getContext('2d');
    if (!ctx) return;
    document.querySelectorAll<HTMLElement>('.hero__title .hl__w').forEach((word) => {
      const style = getComputedStyle(word);
      const size = parseFloat(style.fontSize);
      const box = word.getBoundingClientRect().height;
      ctx.font = `${style.fontStyle} ${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
      const face = ctx.measureText(word.textContent ?? 'H');
      const capital = ctx.measureText('H');
      const ascent = face.fontBoundingBoxAscent;
      const descent = face.fontBoundingBoxDescent;
      if (!size || !box || !ascent) return;
      const baseline = (box - (ascent + descent)) / 2 + ascent;
      const pad = size * 0.115;
      word.style.setProperty('--hl-top', `${(baseline - capital.actualBoundingBoxAscent - pad).toFixed(1)}px`);
      word.style.setProperty('--hl-bottom', `${(box - baseline - pad).toFixed(1)}px`);
    });
  }
  let fitting = 0;
  const refit = () => {
    cancelAnimationFrame(fitting);
    fitting = requestAnimationFrame(fitSwashes);
  };
  document.addEventListener('astro:page-load', () => {
    fitSwashes();
    document.fonts?.ready.then(fitSwashes);
  });
  window.addEventListener('resize', refit);

  // The pen strokes under the highlighted words (they stand in for the swashes, hidden on the hero):
  // one uniform stroke under each line the highlight stands on, so two words side by side share one
  // line and words on two lines get one each. An ink line drawn by hand: thin where the nib lands and
  // lifts, a little fuller in the middle, never quite straight. Two, so stacked lines differ.
  const PENS = [
    'M3 14.6C40 12.2 92 10.9 152 10.6C216 10.3 288 11.2 344 9.8C370 9.1 387 7.9 396.6 6.3C398.6 6 399.4 7.6 397.8 8.3C386 11.6 365 13.4 341 14.1C285 15.6 214 14.9 152 15.4C94 15.9 43 16.8 4.4 16.5C2.2 16.4 1.6 14.9 3 14.6Z',
    'M2.6 11.4C30 10.2 78 11.6 140 12.2C204 12.8 268 11.4 330 11.8C360 12 384 12.8 397 14.4C399 14.7 399 16.3 397 16.4C383 16.6 358 15.9 329 16C268 16.2 205 17.2 140 16.7C79 16.2 31 14.6 3.4 13.7C1.4 13.6 1 11.5 2.6 11.4Z',
  ];
  function drawPens() {
    const title = document.querySelector<HTMLElement>('.hero__title');
    const host = title?.querySelector<HTMLElement>('.hero__pens');
    if (!title || !host) return;
    const box = title.getBoundingClientRect();
    const size = parseFloat(getComputedStyle(title).fontSize);
    // the highlighted words, gathered into the lines they stand on
    const lines: { left: number; right: number; top: number }[] = [];
    title.querySelectorAll<HTMLElement>('.hl__w').forEach((word) => {
      const r = word.getBoundingClientRect();
      const line = lines.find((l) => Math.abs(l.top - r.top) < size * 0.3);
      if (line) {
        line.left = Math.min(line.left, r.left);
        line.right = Math.max(line.right, r.right);
      } else lines.push({ left: r.left, right: r.right, top: r.top });
    });
    host.innerHTML = lines
      .map(
        (l, n) =>
          `<svg class="hero__pen" viewBox="0 0 400 24" preserveAspectRatio="none" focusable="false" style="left:${(l.left - box.left - size * 0.06).toFixed(1)}px;top:${(l.top - box.top).toFixed(1)}px;width:${(l.right - l.left + size * 0.14).toFixed(1)}px"><path d="${PENS[n % 2]}"/></svg>`,
      )
      .join('');
  }
  let penning = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(penning);
    penning = requestAnimationFrame(drawPens);
  });
  document.addEventListener('astro:page-load', () => {
    drawPens();
    document.fonts?.ready.then(drawPens);
  });

  // The clouds, the birds, the stars and the fire only move while the hero is on screen.
  document.addEventListener('astro:page-load', () => {
    const hero = document.querySelector<HTMLElement>('.hero');
    if (!hero || hero.dataset.watched) return;
    hero.dataset.watched = 'true';
    new IntersectionObserver(([entry]) => hero.classList.toggle('is-away', !entry.isIntersecting)).observe(hero);
  });
</script>

<style>
  .hero {
    /* the title keeps the logo's distance from the edges (--edge, tokens.css) */
    --hero-pad: var(--edge);
    --panel-w: 100vw;
    --panel-h: max(100svh, 32rem);
    /* the first screen below the header, which lies over the top of the picture */
    --hero-open: calc(var(--panel-h) - var(--header-h));
    /* how far below the first screen the picture takes to fade into the page */
    --hero-fade: clamp(4rem, 14svh, 10rem);
    /* The title stands centred above the temple (client direction, 22 November 2026), in two lines on
       wide screens: --hero-fit is the ems its longer line needs, --hero-rows the lines it takes. It is
       as large as the width allows, and the height (a little over a tenth of the open height). */
    --hero-col: calc(var(--panel-w) - 2 * var(--hero-pad));
    --hero-fit: 10.6;
    /* the same, scaled for a title face of another width (--type-wide; 1 for PP Editorial New) */
    --hero-fitw: calc(var(--hero-fit) * var(--type-wide, 1));
    --hero-rows: 2;
    /* air between the header and the title */
    /* more room under the header, the title closer to the picture (Maria, 22 November 2026) */
    --hero-top: clamp(2rem, 9svh, 6rem);
    --hero-fs: min(calc(var(--hero-col) / var(--hero-fitw)), calc(var(--hero-open) * 0.105), 7.5rem);
    /* the title and its subtitle (whose size has a floor) */
    --hero-block: calc(var(--hero-fs) * (var(--hero-rows) * 1.01 + 0.42) + max(var(--hero-fs) * 0.36, 1.3rem) * 1.3);
    /* air between the subtitle and the roof */
    --hero-gap: clamp(0.4rem, 1.2svh, 1rem);
    /* The picture fills the first screen to its foot (client direction, 22 November 2026): the ground
       line runs this far above it, and the sky colour carries on under the line. */
    --hero-ground: clamp(2rem, 6svh, 4rem);
    /* The temple takes the height left under the title: its roof (acroteria included) stands 0.66 of
       the frame above the ground line. On a narrow screen the width stops it first, leaving room on
       the left for the statue. */
    --scene-h: max(
      12rem,
      min(
        calc((var(--hero-open) - var(--hero-top) - var(--hero-block) - var(--hero-gap) - var(--hero-ground)) / 0.66),
        var(--panel-w) * 0.72
      )
    );
    --scene-x: 50%;
    --u: calc(var(--scene-h) / 1000);
    /* the frame's foot: the ground line is 54 units above it */
    --scene-b: calc(var(--hero-ground) - var(--u) * 54);

    /* The picture runs under the sticky header, to the top of the window. */
    margin-top: calc(var(--header-h) * -1);
    padding-bottom: var(--hero-fade);
  }
  /* The longer of the two lines: "STUDY AT THE MODERN" / "Αρχαίας Ελληνικής Σοφίας" */
  .hero--el {
    --hero-fit: 11.6;
  }
  .hero--grc {
    --hero-fit: 13.4;
  }

  .hero__panel {
    /* Day. The drawings read three washes (--pb-night: whatever must match the ground they stand
       on, --pb-stone: the temple and the goddess, --pb-light: light itself) and one line colour.
       theme-day keeps the palette itself from being swapped, so both scenes are set from the same
       daytime inks: light-blue sky, marble in the paper colour, Greek-blue line. */
    --hero-sky: var(--blue-light);
    --hero-line: var(--blue);
    --hero-grain: url('/textures/grain-dark.webp');
    --pb-night: var(--blue-light);
    --pb-stone: var(--creme-light);
    --pb-light: var(--creme-light);
    --ink-strong: var(--blue);
    --highlight: var(--creme-light);
    --highlight-ink: var(--blue);
    --sub-ink: var(--blue);
    /* the far mountains: barely darker than the sky, the nearer range a little more */
    --peak-far: color-mix(in srgb, var(--blue) 9%, var(--blue-light));
    --peak-near: color-mix(in srgb, var(--blue) 16%, var(--blue-light));

    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* the title stands in the middle of the sky left over the roof (on wide screens it fills it) */
    justify-content: center;
    min-height: var(--panel-h);
    padding: calc(var(--header-h) + var(--hero-top)) var(--hero-pad)
      calc(var(--hero-ground) + var(--scene-h) * 0.66 + var(--hero-gap));
  }
  /* Night: the darker blue ground, stone in Greek blue, light in light blue, crème line. */
  :global(html[data-theme='dark']) .hero__panel {
    --hero-sky: var(--blue-deep);
    --hero-line: var(--creme);
    --hero-grain: url('/textures/grain-light.webp');
    --pb-night: var(--blue-deep);
    --pb-stone: var(--blue);
    --pb-light: var(--blue-light);
    --ink-strong: var(--creme-light);
    --highlight: var(--blue-light);
    --highlight-ink: var(--blue-deep);
    --sub-ink: var(--blue-light);
    /* by night a little lighter than the sky, as hills are against stars */
    --peak-far: color-mix(in srgb, var(--blue) 26%, var(--blue-deep));
    --peak-near: color-mix(in srgb, var(--blue) 38%, var(--blue-deep));
  }

  /* ---------- title ---------- */
  /* The title is one stacking context and its highlighted words are not, so the swashes lie behind
     every word of the title, never over the end of the row above (client direction). */
  .hero__title {
    isolation: isolate;
    /* as wide as its longer line needs and no wider, so the lines always break the same way */
    width: min(100%, calc(var(--hero-fitw) * 1em));
    font-size: var(--hero-fs);
    /* a touch more air between the rows than other titles have (client direction, 15 October 2026) */
    /* more air again (Maria, 22 November 2026) */
    line-height: calc(var(--title-leading) + 0.16);
    text-align: center;
    text-wrap: balance;
    /* (while the swash is hidden the highlighted words keep the title's ink) */
    --highlight-ink: var(--ink-strong);
  }
  /* The highlighted words are set heavier than the rest of the title (client direction) */
  .hero__title .hl__w {
    isolation: auto;
    font-weight: 500;
  }
  .hero__line {
    display: block;
  }
  /* The swash has to hold every letter of its word: a little wider and squarer than the kit's. */
  /* The swash is centred on the letters, from a little above the capitals to a little under the
     baseline, so it covers whole words and does not hang below them (client direction, 14 October
     2026). In the title face the capitals rise 0.01em above the line's box and the baseline sits
     0.79em down it (line height 1); the stand-in face is set to the same lines (fonts.css). */
  .hero__title .hl__w {
    /* the swash's top and foot without the script; the script below measures the letters in the face
       the browser actually used and sets --hl-top and --hl-bottom (Safari ignores the stand-in face's
       line settings in fonts.css, so its letters sit lower than Chrome's) */
    --hl-top-d: -0.125em;
    --hl-bottom-d: 0.095em;
  }
  .hero__title .hl__w::before {
    inset: var(--hl-top, var(--hl-top-d)) -0.36em var(--hl-bottom, var(--hl-bottom-d)) -0.34em;
    border-radius: 22% 27% 20% 29% / 44% 40% 47% 42%;
  }
  .hero__title .hl__w:nth-child(even)::before {
    inset: calc(var(--hl-top, var(--hl-top-d)) + 0.02em) -0.38em calc(var(--hl-bottom, var(--hl-bottom-d)) - 0.02em) -0.33em;
    border-radius: 27% 21% 29% 22% / 41% 46% 40% 45%;
  }
  /* Greek titles are set in EB Garamond, whose capitals start lower on the line (measured: from 0.16em
     to the baseline at 0.86em, in a line of 1.01): the swash moves down to sit centred on them too */
  .hero--el .hero__title .hl__w,
  .hero--grc .hero__title .hl__w {
    --hl-top-d: 0.047em;
    --hl-bottom-d: 0.037em;
  }
  /* CLIENT DIRECTION, 22 November 2026: "hide the brushstrokes from the hero for now and replace
     with a hand-held pen underline". The swash is only hidden: to bring it back, delete this rule,
     the --highlight-ink line in .hero__title, and the .hero__pen strokes (markup and rules). */
  .hero__title .hl__w::before {
    display: none;
  }
  /* With no swash to wait for, the highlighted words are in their blue from the start (Maria, 23 November
     2026): the delayed colour change of split headings (motion.css) does not apply here */
  :global(html) .hero .hero__title .hl__w,
  :global(html.motion) .hero .hero__title[data-split] .hl__w {
    color: var(--ink-strong);
    transition: none;
  }
  /* The pen strokes, in the title's ink: one under each line of highlighted words, placed by the
     script (left, width and the top of the line); --pen-top sets them under the letters. */
  .hero__title {
    position: relative;
  }
  .hero__pens {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero__pens :global(.hero__pen) {
    position: absolute;
    margin-top: var(--pen-top, 0.84em);
    height: 0.2em;
    max-width: none;
    overflow: visible;
    fill: var(--ink-strong);
    pointer-events: none;
  }
  /* Greek: EB Garamond sits lower on the line, and its letters have tails below it */
  .hero--el .hero__pens,
  .hero--grc .hero__pens {
    --pen-top: 0.98em;
  }
  /* With motion on, the pen draws its line from left to right after the title has risen */
  :global(html.motion) .hero__pens :global(.hero__pen) {
    clip-path: inset(-50% 100% -50% 0);
    transition: clip-path 0.8s cubic-bezier(0.5, 0, 0.3, 1);
    transition-delay: var(--hl-delay, 1.5s);
  }
  :global(html.motion) .hero__pens :global(.hero__pen + .hero__pen) {
    transition-delay: calc(var(--hl-delay, 1.5s) + 0.6s);
  }
  :global(html.motion) .hero__title.is-in .hero__pens :global(.hero__pen) {
    clip-path: inset(-50% 0 -50% 0);
  }
  /* The subtitle in the handwritten voice face, under the title, never below the size a hand needs. */
  .hero__title .t-sub {
    margin-top: 0.42em;
    font-size: max(0.36em, 1.3rem);
    text-wrap: balance;
  }

  /* ---------- stage ---------- */
  /* The sheet the picture is printed on: the first screen. Below it the sky thins out into the page
     on a strip of its own (.hero__fade). The strip is still, and it alone carries the mask: a mask
     over the whole stage had every frame of the clouds, the stars and the fire pass through it,
     which kept the machine busy. Under the ground line the picture is plain sky colour in both
     themes, so the strip only needs that colour. */
  .hero__stage {
    position: absolute;
    /* (it starts above the top of the page: the header can stand a few pixels taller than
       --header-h, and the page's paper showed there as a pale line) */
    inset: -2rem 0 0;
    z-index: -1;
    overflow: hidden;
    background-color: var(--hero-sky);
    pointer-events: none;
  }
  .hero__fade {
    position: absolute;
    inset: 100% 0 auto;
    z-index: -1;
    height: var(--hero-fade);
    background-color: var(--hero-sky);
    background-image: var(--hero-grain);
    background-size: 400px 400px;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, #000, transparent);
  }
  .hero__layer {
    position: absolute;
    inset: 2rem 0 0;
  }
  /* Nothing in the picture moves while it is out of sight (class set by the script below) */
  .hero.is-away :global(*) {
    animation-play-state: paused !important;
  }
  /* Each drawing's wrapper is the positioned box; the SVG fills it and may draw outside its frame. */
  .hero__layer :global(.illo) {
    position: absolute;
    color: var(--hero-line);
  }
  .hero__layer :global(svg) {
    width: 100%;
    height: 100%;
    max-width: none;
    overflow: visible;
  }
  /* The stars run on behind the header to the top of the window, so the sky is not cut off under it
     (client direction, 11 October 2026). */
  .hero__layer--sky :global(.illo),
  .hero__layer--milky :global(.illo) {
    inset: -5% -2%;
  }
  /* The range stands on the ground line, its foot behind it, across the whole width */
  .hero__layer--peaks :global(.illo) {
    left: -2%;
    right: -2%;
    bottom: calc(var(--scene-b) + var(--u) * 6);
    /* (15% lower than at first, so the summit shows under the title's highlights: 15 October 2026) */
