---
// After Stripe (Maria, 23 November 2026): where a Payment Link sends people back to, set in each link's
// "After payment" setting in Stripe: /payment/success/ (or /en/payment/success/). /payment/failed/ is for
// links that cannot complete, and for us to point people to. Not for search engines.
// Wording PROPOSED, for Athena to approve (logged in tasks/text-changes.md).
import Illustration from '../Illustration.astro';
import Signature from '../Signature.astro';
import { content } from '../../data';
import { getLocale, mainLocale } from '../../lib/locale';

interface Props {
  kind: 'success' | 'failed';
}
const { kind } = Astro.props;
const locale = getLocale(Astro.url);
const { site } = content(locale);
const email = site.emails[0];
const words = {
  el: {
    success: {
      kicker: 'Σας ευχαριστούμε',
      title: 'Η θέση σας εξασφαλίστηκε',
      text: ['Η πληρωμή σας ολοκληρώθηκε και η εγγραφή σας καταχωρήθηκε.', 'Θα σας στείλουμε σύντομα email με όλες τις λεπτομέρειες για την έναρξη.'],
    },
    failed: {
      kicker: 'Κάτι δεν πήγε καλά',
      title: 'Η πληρωμή δεν ολοκληρώθηκε',
      text: ['Η πληρωμή σας δεν ολοκληρώθηκε, οπότε δεν έγινε καμία χρέωση.', 'Μπορείτε να δοκιμάσετε ξανά, να επιλέξετε κατάθεση σε τραπεζικό λογαριασμό, ή να μας γράψετε και θα σας βοηθήσουμε.'],
    },
    ask: 'Για οτιδήποτε, γράψτε μας στο',
    home: 'Αρχική σελίδα',
    courses: 'Δείτε τα μαθήματα',
  },
  en: {
    success: {
      kicker: 'Thank you',
      title: 'Your place is secured',
      text: ['Your payment went through and your registration is recorded.', 'We will email you soon with all the details for the start.'],
    },
    failed: {
      kicker: 'Something went wrong',
      title: 'The payment did not go through',
      text: ['Your payment was not completed, so nothing was charged.', 'You can try again, choose a bank transfer, or write to us and we will help.'],
    },
    ask: 'For anything at all, write to us at',
    home: 'Home page',
    courses: 'See the courses',
  },
}[mainLocale(locale)];
const w = words[kind];
---

{/* By night the starry sky of the home page behind everything, its larger stars pulsing (Maria, 23 November 2026) */}
<div class="pay__sky" aria-hidden="true">
  <Illustration name="portal-b-sky" />
  {[1, 2, 3].map((n) => <span class="pay__tw" style={`--n:${n - 1}`}><Illustration name={`portal-b-stars-${n}`} /></span>)}
  <Illustration name="portal-b-milkyway" />
</div>
<section class="pay wrap" aria-labelledby="pay-title">
  <div class="pay__sheet box on-blue">
    <Illustration name="laurel" class="pay__laurel" draw />
    <p class="pay__kicker hand hand--m" data-kicker>{w.kicker}</p>
    <h1 class="t-1 pay__title" id="pay-title">{w.title}</h1>
    {w.text.map((line) => <p class="pay__text">{line}</p>)}
    {kind === 'success' && <Signature class="pay__sign" />}
    <p class="pay__ask">{words.ask} <a href={`mailto:${email}`}>{email}</a></p>
    {/* no home button on the success page (Maria, 23 November 2026): the header still leads home */}
    {kind === 'failed' && (
      <p class="pay__go">
        <a class="btn" href={site.routes.courses}>{words.courses}</a>
        <a class="btn btn--ghost" href={site.home.href}>{words.home}</a>
      </p>
    )}
  </div>
</section>
{/* No footer on these pages: the olive grove instead, its trees over the foot of the box (Maria, 23 November 2026) */}
<div class="pay__ground"><div class="pay__scene" aria-hidden="true">
  <div class="pay__layer pay__layer--far"><Illustration name="footer-grove-far" /></div>
  <div class="pay__layer pay__layer--mid"><Illustration name="footer-grove-mid" /></div>
  <div class="pay__layer pay__layer--near"><Illustration name="footer-grove-near" /></div>
</div></div>

<style>
  .pay__sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: none;
    color: #f2e9d3;
    pointer-events: none;
  }
  :global(html[data-theme='dark']) .pay__sky {
    display: block;
  }
  .pay__sky :global(.illo),
  .pay__sky .pay__tw {
    position: absolute;
    inset: 0;
  }
  .pay__sky :global(svg) {
    width: 100%;
    height: 100%;
  }
  .pay__sky :global(.illo--portal-b-milkyway) {
    opacity: 0.55;
  }
  @keyframes pay-twinkle {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.3;
    }
  }
  :global(html.motion) .pay__tw {
    animation: pay-twinkle calc(2.6s + var(--n, 0) * 0.9s) ease-in-out calc(var(--n, 0) * -1.3s) infinite alternate;
  }
  .pay {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    /* half the room above the box (Maria, 23 November 2026) */
    padding-block: calc((var(--header-h) + var(--space-l)) / 2) 0;
  }
  /* the grove: as wide as the window (never narrower than 64rem, so a phone sees its middle), rising over the
     last part of the box */
  /* the grove is wider than a phone: clip it there, so the page never widens */
  .pay__ground {
    position: relative;
    z-index: 2;
    overflow-x: clip;
    margin-top: calc(max(130vw, 83rem) * -0.17);
  }
  .pay__scene {
    position: relative;
    z-index: 2;
    left: 50%;
    /* 30% taller than a footer (Maria, 23 November 2026): wider by as much, its sides clipped */
    width: max(130%, 83rem);
    translate: -50% 0;
    aspect-ratio: 1600 / 525;
    pointer-events: none;
  }
  .pay__layer {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    color: var(--blue);
  }
  .pay__layer :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .pay__layer--far {
    bottom: 16%;
  }
  .pay__layer--mid {
    bottom: 2.7%;
  }
  .pay__layer--near {
    bottom: -1px;
  }
  .pay__scene :global(.sky-day path),
  .pay__scene :global(.sky-moon path) {
    fill: var(--gold);
  }
  /* no sun, moon or stars here: they would fall on the box */
  .pay__scene :global(.sky-night),
  .pay__scene :global(.sky-day) {
    display: none;
  }
  /* no blue band under the grove: its ground is the page's paper, only the ground line drawn (Maria) */
  .pay__layer--near :global(path[fill='currentColor']) {
    fill: var(--paper);
  }
  .pay__sheet {
    max-width: 42rem;
    padding: clamp(2rem, 1.2rem + 4vw, 4rem) clamp(2rem, 1.2rem + 4vw, 4rem) clamp(6rem, 4rem + 8vw, 10rem);
    text-align: center;
    --leaf: var(--gold);
  }
  .pay__laurel {
    width: clamp(5rem, 4rem + 4vw, 7rem);
    margin: 0 auto var(--space-s);
  }
  .pay__title {
    margin: 0.2rem 0 var(--space-m);
    font-size: clamp(2.2rem, 1.6rem + 3vw, 3.6rem);
  }
  .pay__text {
    margin: 0 auto 0.7rem;
    max-width: 34ch;
    font-size: var(--step-1);
  }
  .pay__sheet :global(.pay__sign) {
    display: block;
    width: 8rem;
    margin: var(--space-s) auto 0;
  }
  .pay__ask {
    margin-top: var(--space-m);
    font-size: 0.92rem;
    opacity: 0.8;
  }
  .pay__ask a {
    color: inherit;
    overflow-wrap: anywhere;
  }
  .pay__go {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-top: var(--space-m);
  }
</style>

<script>
  // Stripe sends everyone back to the Greek page; whoever registered on the English pages sees it in English
  // (the form notes the language just before leaving for Stripe: RegisterDialog.astro)
  document.addEventListener('astro:page-load', () => {
    let lang = '';
    try {
      lang = localStorage.getItem('ath-pay-lang') ?? '';
    } catch {}
    const onEnglish = location.pathname.startsWith('/en/');
    if (lang === 'en' && !onEnglish) return location.replace('/en' + location.pathname);
    // "Σας ευχαριστούμε, Μαρία": the first name they gave in the form (success page only)
    let name = '';
    try {
      name = (localStorage.getItem('ath-pay-name') ?? '').trim().split(/\s+/)[0] ?? '';
    } catch {}
    const kicker = document.querySelector<HTMLElement>('[data-kicker]');
    if (name && kicker && location.pathname.includes('/success')) kicker.textContent = `${kicker.textContent}, ${name}`;
  });
</script>
