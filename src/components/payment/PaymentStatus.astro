---
// After Stripe (Maria, 23 November 2026): where a Payment Link sends people back to, set in each link's
// "After payment" setting in Stripe: /payment/success/ (or /en/payment/success/). /payment/failed/ is for
// links that cannot complete, and for us to point people to. Not for search engines.
// Wording PROPOSED, for Athena to approve (logged in tasks/text-changes.md).
import Illustration from '../Illustration.astro';
import Signature from '../Signature.astro';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

interface Props {
  kind: 'success' | 'failed';
}
const { kind } = Astro.props;
const locale = getLocale(Astro.url);
const { site } = content(locale);
const email = site.emails[0];
const words = {
  el: {
    success: {
      kicker: 'Σας ευχαριστούμε',
      title: 'Η θέση σας εξασφαλίστηκε',
      text: ['Η πληρωμή σας ολοκληρώθηκε και η εγγραφή σας καταχωρήθηκε.', 'Θα σας στείλουμε σύντομα email με όλες τις λεπτομέρειες για την έναρξη.'],
    },
    failed: {
      kicker: 'Κάτι δεν πήγε καλά',
      title: 'Η πληρωμή δεν ολοκληρώθηκε',
      text: ['Η πληρωμή σας δεν ολοκληρώθηκε, οπότε δεν έγινε καμία χρέωση.', 'Μπορείτε να δοκιμάσετε ξανά, να επιλέξετε κατάθεση σε τραπεζικό λογαριασμό, ή να μας γράψετε και θα σας βοηθήσουμε.'],
    },
    ask: 'Για οτιδήποτε, γράψτε μας στο',
    home: 'Αρχική σελίδα',
    retry: 'Δοκιμάστε ξανά',
    courses: 'Δείτε τα μαθήματα',
  },
  en: {
    success: {
      kicker: 'Thank you',
      title: 'Your place is secured',
      text: ['Your payment went through and your registration is recorded.', 'We will email you soon with all the details for the start.'],
    },
    failed: {
      kicker: 'Something went wrong',
      title: 'The payment did not go through',
      text: ['Your payment was not completed, so nothing was charged.', 'You can try again, choose a bank transfer, or write to us and we will help.'],
    },
    ask: 'For anything at all, write to us at',
    home: 'Home page',
    retry: 'Try again',
    courses: 'See the courses',
  },
  grc: {
    success: {
      kicker: 'Χάριν ἴσμεν',
      title: 'Ἡ χώρα ὑμῖν φυλάττεται',
      text: ['Ἡ καταβολὴ ἐτελέσθη καὶ ἡ ἐγγραφὴ ὑμῶν ἀναγέγραπται.', 'Ἐν τάχει ἐπιστελοῦμεν ὑμῖν πάντα τὰ περὶ τῆς ἀρχῆς.'],
    },
    failed: {
      kicker: 'Οὐ κατὰ γνώμην ἐχώρησεν',
      title: 'Ἡ καταβολὴ οὐκ ἐτελέσθη',
      text: ['Ἡ καταβολὴ ὑμῶν οὐκ ἐτελέσθη, ὥστε οὐδὲν ἀργύριον ἐλήφθη.', 'Ἔξεστιν ὑμῖν αὖθις πειρᾶσθαι, ἢ διὰ τραπέζης καταβαλεῖν, ἢ ἐπιστεῖλαι ἡμῖν, καὶ βοηθήσομεν.'],
    },
    ask: 'Περὶ παντὸς ἐπιστείλατε ἡμῖν πρὸς',
    home: 'Οἴκαδε',
    retry: 'Πειράσασθε αὖθις',
    courses: 'Ἴδετε τὰ μαθήματα',
  },
}[locale];
const w = words[kind];
---

{/* By night the starry sky of the home page behind everything, its larger stars pulsing (Maria, 23 November 2026) */}
<div class="pay__sky" aria-hidden="true">
  <Illustration name="portal-b-sky" />
  {[1, 2, 3].map((n) => <span class="pay__tw" style={`--n:${n - 1}`}><Illustration name={`portal-b-stars-${n}`} /></span>)}
  <Illustration name="portal-b-milkyway" />
</div>
{/* The whole page is one screen, nothing to scroll (Maria, 24 November 2026): the card in the middle, the grove
    along the foot of the screen over the card's foot, and by day a living sky behind: clouds drifting, a pair of
    birds now and then, the sun glowing low over the hills. */}
<div class="pay-stage">
<div class="pay__day" aria-hidden="true">
  <span class="pay__sun"><span class="pay__glow"></span><span class="pay__disc"></span></span>
  {[1, 2, 3, 4, 5].map((n) => <Illustration name="hero-cloud-soft" class={`pay__cloud pay__cloud--${n}`} />)}
  <Illustration name="hero-bird" class="pay__bird pay__bird--1" />
  <Illustration name="hero-bird" class="pay__bird pay__bird--2" />
  <Illustration name="hero-bird" class="pay__bird pay__bird--3" />
</div>
<section class="pay wrap" aria-labelledby="pay-title">
  <div class="pay__sheet box on-blue">
    <Illustration name="laurel" class="pay__laurel" draw />
    <p class="pay__kicker hand hand--m" data-kicker>{w.kicker}</p>
    <h1 class="t-1 pay__title" id="pay-title">{w.title}</h1>
    {/* both sentences in one paragraph, so the space between them matches the lines' (Maria, 24 November 2026) */}
    <p class="pay__text">{w.text.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
    {kind === 'success' && <Signature class="pay__sign" />}
    <p class="pay__ask">{words.ask} <a href={`mailto:${email}`}>{email}</a></p>
    {/* no home button on the success page (Maria, 23 November 2026): the header still leads home */}
    {/* the failure page: one way, back to the course (or membership) to try again (Maria, 23 November 2026) */}
    {kind === 'failed' && (
      <p class="pay__go">
        <a class="btn" href={site.routes.courses} data-retry>{words.retry}</a>
      </p>
    )}
  </div>
</section>
{/* No footer on these pages: the olive grove instead, its trees over the foot of the box (Maria, 23 November 2026) */}
<div class="pay__ground"><div class="pay__scene" aria-hidden="true">
  <div class="pay__layer pay__layer--far"><Illustration name="footer-grove-far" /></div>
  <div class="pay__layer pay__layer--mid"><Illustration name="footer-grove-mid" /></div>
  <div class="pay__layer pay__layer--near"><Illustration name="footer-grove-near" /></div>
</div></div>
</div>

<style>
  .pay__sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: none;
    color: #f2e9d3;
    pointer-events: none;
  }
  :global(html[data-theme='dark']) .pay__sky {
    display: block;
  }
  .pay__sky :global(.illo),
  .pay__sky .pay__tw {
    position: absolute;
    inset: 0;
  }
  .pay__sky :global(svg) {
    width: 100%;
    height: 100%;
  }
  .pay__sky :global(.illo--portal-b-milkyway) {
    opacity: 0.55;
  }
  @keyframes pay-twinkle {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.3;
    }
  }
  :global(html.motion) .pay__tw {
    animation: pay-twinkle calc(2.6s + var(--n, 0) * 0.9s) ease-in-out calc(var(--n, 0) * -1.3s) infinite alternate;
  }
  /* One screen, nothing to scroll (Maria, 24 November 2026). --sw/--sh: the grove's width and height. It spans
     the window (a little wider, its sides clipped) but never stands taller than about a third of the screen,
     so the card always has the room above it. On a very small phone the stage may grow past the screen
     rather than let the trees cover the words. */
  .pay-stage {
    --sw: max(100vw, min(max(130vw, 83rem), 34svh * 3.0476));
    --sh: calc(var(--sw) * 525 / 1600);
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    overflow: clip;
  }
  /* the page is the screen: the header, then the stage taking whatever height is left */
  :global(body:has(.pay-stage)) {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
  :global(body:has(.pay-stage) > main) {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }
  .pay {
    position: relative;
    z-index: 1;
    flex: 1 1 auto;
    display: grid;
    place-items: center;
    /* below the card: room for the trees, which rise to just over half the grove's height */
    padding-block: clamp(0.4rem, 1.6svh, 1rem) calc(var(--sh) * 0.53);
  }
  /* the grove along the foot of the screen, over the last part of the card */
  .pay__ground {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--sh);
    pointer-events: none;
  }
  .pay__scene {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: var(--sw);
    translate: -50% 0;
    aspect-ratio: 1600 / 525;
  }

  /* The day sky behind everything (Maria, 24 November 2026): soft clouds drift across, a pair of birds
     crosses now and then, and the sun glows low over the hills. By day only; at night the stars. Only
     transforms and opacity move. */
  .pay__day {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  :global(html[data-theme='dark']) .pay__day {
    display: none;
  }
  .pay__sun {
    position: absolute;
    right: 19%;
    bottom: calc(var(--sh) * 0.62);
    width: clamp(2.4rem, 1.8rem + 2.4vw, 4.2rem);
    aspect-ratio: 1;
  }
  .pay__disc,
  .pay__glow {
    position: absolute;
    border-radius: 50%;
  }
  .pay__disc {
    inset: 0;
    background: var(--gold);
  }
  /* the glow: a wide soft halo of gold that breathes (a gradient, never a blur) */
  .pay__glow {
    inset: -160%;
    background: radial-gradient(circle, color-mix(in srgb, var(--gold) 70%, transparent) 0%, color-mix(in srgb, var(--gold) 34%, transparent) 26%, color-mix(in srgb, var(--gold) 12%, transparent) 44%, transparent 64%);
  }
  @keyframes pay-glow {
    from {
      transform: scale(0.88);
      opacity: 0.65;
    }
    to {
      transform: scale(1.08);
      opacity: 1;
    }
  }
  :global(html.motion) .pay__glow {
    animation: pay-glow 5.5s ease-in-out infinite alternate;
  }
  .pay__day :global(.pay__cloud) {
    position: absolute;
    left: 0;
    top: var(--top);
    width: var(--w);
    aspect-ratio: 600 / 120;
    color: color-mix(in srgb, var(--creme-light) var(--mix, 40%), color-mix(in srgb, var(--blue) 26%, var(--creme)));
    transform: translate3d(var(--at), 0, 0);
  }
  .pay__day :global(.pay__cloud svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .pay__day :global(.pay__cloud--1) { --w: clamp(16rem, 40vw, 40rem); --top: 4%; --at: 58vw; --t: 120s; }
  .pay__day :global(.pay__cloud--2) { --w: clamp(12rem, 28vw, 28rem); --top: 20%; --at: 6vw; --t: 150s; --mix: 32%; scale: -1 1; }
  .pay__day :global(.pay__cloud--3) { --w: clamp(14rem, 34vw, 34rem); --top: 36%; --at: 70vw; --t: 135s; --mix: 36%; }
  .pay__day :global(.pay__cloud--4) { --w: clamp(10rem, 22vw, 22rem); --top: 11%; --at: 30vw; --t: 170s; --mix: 30%; }
  .pay__day :global(.pay__cloud--5) { --w: clamp(13rem, 30vw, 30rem); --top: 48%; --at: -4vw; --t: 145s; --mix: 34%; scale: -1 1; }
  @keyframes pay-cloud {
    from {
      transform: translate3d(-105%, 0, 0);
    }
    to {
      transform: translate3d(100vw, 0, 0);
    }
  }
  :global(html.motion) .pay__day :global(.pay__cloud) {
    animation: pay-cloud var(--t) linear calc(var(--t) * var(--d, -0.3)) infinite;
  }
  .pay__day :global(.pay__cloud--2) { --d: -0.75; }
  .pay__day :global(.pay__cloud--3) { --d: -0.55; }
  .pay__day :global(.pay__cloud--4) { --d: -0.1; }
  .pay__day :global(.pay__cloud--5) { --d: -0.9; }
  /* the birds: three, crossing left to right and rising a little, every half minute or so */
  .pay__day :global(.pay__bird) {
    position: absolute;
    left: 0;
    top: 16%;
    width: clamp(1.1rem, 0.8rem + 1vw, 1.8rem);
    aspect-ratio: 48 / 22;
    color: var(--blue);
    opacity: 0;
  }
  .pay__day :global(.pay__bird svg) {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: 50% 68%;
  }
  .pay__day :global(.pay__bird--2) { top: 20%; width: clamp(0.9rem, 0.7rem + 0.8vw, 1.5rem); }
  .pay__day :global(.pay__bird--3) { top: 13%; width: clamp(0.8rem, 0.6rem + 0.7vw, 1.3rem); }
  @keyframes pay-bird {
    0% {
      transform: translate3d(-6vw, 4vh, 0);
      opacity: 1;
    }
    55% {
      transform: translate3d(106vw, -8vh, 0);
      opacity: 1;
    }
    56%,
    100% {
      transform: translate3d(106vw, -8vh, 0);
      opacity: 0;
    }
  }
  @keyframes pay-wing {
    from {
      transform: scaleY(1);
    }
    to {
      transform: scaleY(0.32);
    }
  }
  :global(html.motion) .pay__day :global(.pay__bird) {
    animation: pay-bird 34s linear 2s infinite backwards;
  }
  :global(html.motion) .pay__day :global(.pay__bird--2) {
    animation-delay: 3.1s;
  }
  :global(html.motion) .pay__day :global(.pay__bird--3) {
    animation-delay: 3.9s;
  }
  :global(html.motion) .pay__day :global(.pay__bird svg) {
    animation: pay-wing 0.44s ease-in-out infinite alternate;
  }
  :global(html.motion) .pay__day :global(.pay__bird--2 svg) {
    animation-duration: 0.38s;
  }
  .pay__layer {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    color: var(--blue);
  }
  .pay__layer :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .pay__layer--far {
    bottom: 16%;
  }
  .pay__layer--mid {
    bottom: 2.7%;
  }
  .pay__layer--near {
    bottom: -1px;
  }
  .pay__scene :global(.sky-day path),
  .pay__scene :global(.sky-moon path) {
    fill: var(--gold);
  }
  /* the owl's sparks are for a click in the footer; here they stay unseen */
  .pay__scene :global(.grove-sparks) {
    display: none;
  }
  /* no sun, moon or stars here: they would fall on the box */
  .pay__scene :global(.sky-night),
  .pay__scene :global(.sky-day) {
    display: none;
  }
  /* no blue band under the grove: its ground is the page's paper, only the ground line drawn (Maria) */
  .pay__layer--near :global(path[fill='currentColor']) {
    fill: var(--paper);
  }
  /* compact, and sized by the screen's height too, so it fits above the trees (Maria, 24 November 2026);
     its foot runs on behind the grove */
  .pay__sheet {
    max-width: 40rem;
    margin-bottom: calc(var(--sh) * -0.3);
    padding: clamp(1.3rem, 3.6svh, 2.6rem) clamp(1.5rem, 1rem + 3vw, 3.4rem) calc(var(--sh) * 0.3 + clamp(1rem, 2.4svh, 1.8rem));
    text-align: center;
    --leaf: var(--gold);
  }
  /* On arrival the card rises from behind the hills of the grove and fades in (Maria, 24 November 2026).
     The grove stands in front of it, so it seems to come up from behind the land. Translate and opacity only. */
  @keyframes pay-rise {
    from {
      translate: 0 calc(var(--sh) * 0.75);
      opacity: 0;
    }
    60% {
      opacity: 1;
    }
    to {
      translate: 0 0;
      opacity: 1;
    }
  }
  :global(html.motion) .pay__sheet {
    /* slow and calm (Maria, 24 November 2026): a long, soft settle */
    animation: pay-rise 3.2s cubic-bezier(0.22, 0.61, 0.18, 1) 0.3s both;
  }
  /* A faint gold halo around the card, like the sun's but softer still, breathing slowly (Maria, 24 November
     2026). It belongs to the card, so it rises with it. A gradient, never a blur. */
  .pay__sheet::after {
    content: '';
    position: absolute;
    inset: -22% -18%;
    z-index: -2;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--gold) 34%, transparent) 66%, color-mix(in srgb, var(--gold) 16%, transparent) 80%, color-mix(in srgb, var(--gold) 5%, transparent) 92%, transparent 100%);
    pointer-events: none;
  }
  @keyframes pay-aura {
    from {
      opacity: 0.55;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1.03);
    }
  }
  :global(html.motion) .pay__sheet::after {
    animation: pay-aura 7s ease-in-out infinite alternate;
  }
  .pay__laurel {
    width: clamp(3rem, 7svh, 5rem);
    margin: 0 auto clamp(0.3rem, 1svh, 0.8rem);
  }
  .pay__title {
    margin: 0.1rem 0 clamp(0.6rem, 2svh, 1.4rem);
    font-size: clamp(1.9rem, min(1.4rem + 2.4vw, 5.8svh), 3.3rem);
  }
  .pay__text {
    margin: 0 auto 0.5rem;
    max-width: 34ch;
    font-size: clamp(1.02rem, min(0.9rem + 0.5vw, 2.6svh), 1.3rem);
  }
  .pay__sheet :global(.pay__sign) {
    display: block;
    width: clamp(5.2rem, 10svh, 7.5rem);
    margin: clamp(0.4rem, 1.4svh, 1rem) auto 0;
  }
  .pay__ask {
    margin-top: clamp(0.6rem, 2svh, 1.4rem);
    font-size: 0.92rem;
    line-height: 1.3;
    opacity: 0.8;
  }
  .pay__ask a {
    /* the address on a line of its own (Maria, 24 November 2026) */
    display: block;
    width: fit-content;
    margin: 0 auto;
    color: inherit;
    overflow-wrap: anywhere;
  }
  .pay__go {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-top: clamp(0.5rem, 1.6svh, 1.2rem);
  }
</style>

<script>
  import { ambienceMuted, playSound } from '../../scripts/sound';

  // Stripe sends everyone back to the Greek page; whoever registered on the English (or Ancient Greek) pages
  // sees it in that language
  // (the form notes the language just before leaving for Stripe: RegisterDialog.astro)
  document.addEventListener('astro:page-load', () => {
    // (this listener outlives the page when the visitor moves on within the site: act on the payment pages only)
    if (!document.querySelector('.pay-stage')) return;
    let lang = '';
    try {
      lang = localStorage.getItem('ath-pay-lang') ?? '';
    } catch {}
    if ((lang === 'en' || lang === 'grc') && !location.pathname.startsWith(`/${lang}/`))
      return location.replace(`/${lang}` + location.pathname.replace(/^\/(en|grc)(?=\/)/, ''));
    // "Σας ευχαριστούμε, Μαρία": the first name they gave in the form (success page only)
    let name = '';
    try {
      name = (localStorage.getItem('ath-pay-name') ?? '').trim().split(/\s+/)[0] ?? '';
    } catch {}
    const kicker = document.querySelector<HTMLElement>('[data-kicker]');
    if (name && kicker && location.pathname.includes('/success')) kicker.textContent = `${kicker.textContent}, ${name}`;
    // "try again" leads back to the page they registered on (a course, or membership), at its prices
    let back = '';
    try {
      back = localStorage.getItem('ath-pay-back') ?? '';
    } catch {}
    const retry = document.querySelector<HTMLAnchorElement>('[data-retry]');
    if (retry && /^\/((en|grc)\/)?(courses\/[a-z0-9-]+|membership)\/$/.test(back)) retry.href = back + '#registration';
    // On the success page a soft rising phrase on the lyre as the card comes up (Maria, 24 November 2026;
    // scripts/audio/success.mjs). Most browsers hold sound back until the visitor presses something, so it
    // often stays silent; Chrome lets it play for someone who has played sound on the site before. Never
    // when the sound button in the corner is off.
    if (location.pathname.includes('/success') && !ambienceMuted()) window.setTimeout(() => playSound('/audio/success.mp3', 0.08), 700);
  });
</script>
