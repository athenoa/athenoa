---
// Nostos: the screen on entering (Maria, 21 November 2026). Arriving at the map or at Learn from outside
// Nostos (the NOSTOS item in the site header leads to Learn), the page waits behind a sheet of paper with
// the emblem at its centre, in the page's language, for a little over three seconds, then the sheet
// fades. A soft light breathes around the emblem and a few long wave lines, very faint, drift behind it
// like sound. With motion off: the emblem alone, then the fade.
// It is in every page's layout (Base.astro), kept across page changes (transition:persist) and still
// while the page beneath changes (a view transition of its own): open from the first paint on the map
// and Learn, hidden elsewhere, and brought up by src/scripts/nostos-entry.ts the moment a link into
// them is clicked, so the click answers at once however slow the connection. Its fade is in the CSS
// below, so it can never stay up. Not shown without JavaScript, nor inside a lesson's embedded map.
// The one word it adds for screen readers ("Loading") is the learning flow's own, from src/data/nostos/ui.ts.
import { Image } from 'astro:assets';
import emblemEl from '../../assets/media/emblem-el.png';
import emblemEn from '../../assets/media/emblem-en.png';
import { nostosUi } from '../../data/nostos/ui';
import { barePath, getLocale, mainLocale } from '../../lib/locale';

const locale = getLocale(Astro.url);
const loading = nostosUi[mainLocale(locale)].play.path.loading;
// up from the first paint on the map and on Learn
const open = ['/nostos/', '/nostos/play/'].includes(barePath(Astro.url.pathname).replace(/\/*$/, '/'));

// The wave lines: sines drawn as smooth curves, twice the width of the window, repeating exactly at
// half their length, so sliding a layer by half its width loops without a seam. Each layer is one SVG
// that moves whole, on an HTML layer of its own (never a shape inside it).
const LONG = 2400;
const wave = (period: number, amp: number, y: number, phase = 0) => {
  const k = (2 * Math.PI) / period;
  const f = (x: number) => y + amp * Math.sin(k * x + phase);
  const d = (x: number) => amp * k * Math.cos(k * x + phase);
  const n = (v: number) => v.toFixed(1);
  const step = period / 4;
  const h = step / 3;
  let path = `M0 ${n(f(0))}`;
  for (let x = 0; x < LONG; x += step) {
    const x1 = x + step;
    path += `C${n(x + h)} ${n(f(x) + d(x) * h)} ${n(x1 - h)} ${n(f(x1) - d(x1) * h)} ${n(x1)} ${n(f(x1))}`;
  }
  return path;
};
const layers = [
  // three close parallel lines, the long swell
  [wave(600, 22, 72), wave(600, 22, 80), wave(600, 22, 88)],
  // one quicker, smaller
  [wave(400, 12, 80, Math.PI / 3)],
  // one slow and wide
  [wave(1200, 40, 80, Math.PI)],
];
---

<div class="nentry" data-nentry role="status" hidden={!open} transition:persist="nostos-entry">
  <div class="nentry__waves" aria-hidden="true">
    {
      layers.map((paths, i) => (
        <div class={`nentry__wave nentry__wave--${i + 1}`}>
          <svg viewBox={`0 0 ${LONG} 160`} preserveAspectRatio="none" focusable="false">
            {paths.map((d) => (
              <path d={d} vector-effect="non-scaling-stroke" />
            ))}
          </svg>
        </div>
      ))
    }
  </div>
  <div class="nentry__mark">
    <span class="nentry__glow" aria-hidden="true"></span>
    <Image src={locale === 'en' ? emblemEn : emblemEl} alt="" width={214} height={272} densities={[1, 2]} loading="lazy" class="nentry__emblem" />
  </div>
  <p class="visually-hidden">{loading}</p>
</div>
{open && <script is:inline>if (new URLSearchParams(location.search).has('embed')) document.querySelector('[data-nentry]').hidden = true;</script>}
<noscript><style>.nentry { display: none; }</style></noscript>

<script>
  import '../../scripts/nostos-entry';
</script>

<style>
  .nentry {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    overflow: hidden;
    background-color: var(--paper);
    background-image: var(--grain);
    background-size: 400px 400px;
    /* held four seconds, while the emblem slowly comes and goes (Maria, 21 November 2026), then faded;
       held longer while the page it was brought up for is still on its way */
    animation: nentry-out 0.8s var(--ease-in-out) 4s forwards;
    view-transition-name: nostos-entry;
  }
  .nentry.is-waiting {
    animation-play-state: paused;
  }
  /* it stays exactly as it is while the page beneath it changes */
  :global(::view-transition-old(nostos-entry)) {
    display: none;
  }
  :global(::view-transition-group(nostos-entry)),
  :global(::view-transition-new(nostos-entry)) {
    animation: none;
  }
  .nentry[hidden],
  :global(html.nmap-embed) .nentry {
    display: none;
  }
  @keyframes nentry-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* the emblem, at the very centre of the window */
  .nentry__mark {
    position: relative;
    display: grid;
    place-items: center;
  }
  .nentry__emblem {
    position: relative;
    display: block;
    height: clamp(10rem, 36vmin, 19rem);
    width: auto;
  }
  /* its light: a still gradient on a layer of its own, only its opacity and scale move */
  .nentry__glow {
    position: absolute;
    inset: -38% -48%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--blue-light) 80%, transparent), transparent);
    opacity: 0.6;
  }

  /* the waves: a band across the middle of the window, behind the emblem */
  .nentry__waves {
    position: absolute;
    inset: 0;
    display: none;
    color: var(--blue);
    opacity: 0.2;
  }
  .nentry__wave {
    position: absolute;
    top: 50%;
    left: 0;
    width: 200%;
    height: clamp(7rem, 24vmin, 13rem);
    margin-top: calc(clamp(7rem, 24vmin, 13rem) / -2);
  }
  .nentry__wave svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  /* motion: the emblem slowly fades in and, before the screen lifts, slowly out again (Maria,
     21 November 2026); its light breathes, the waves drift and swell. While the page it was brought up
     for is still on its way, the emblem stays (its fading out waits, like the screen's). */
  :global(html.motion) .nentry__mark {
    animation:
      nentry-in 1.5s var(--ease-in-out) 0.1s backwards,
      nentry-mark-out 1.5s var(--ease-in-out) 2.4s forwards;
  }
  :global(html.motion) .nentry.is-waiting .nentry__mark {
    animation-play-state: running, paused;
  }
  :global(html.motion) .nentry__glow {
    animation: nentry-breathe 5s var(--ease-in-out) infinite;
  }
  :global(html.motion) .nentry__waves {
    display: block;
    animation: nentry-in 1.6s var(--ease-out) 0.3s backwards;
  }
  :global(html.motion) .nentry__wave--1 {
    animation:
      nentry-drift 64s linear infinite,
      nentry-swell 8s var(--ease-in-out) -2s infinite alternate;
  }
  :global(html.motion) .nentry__wave--2 {
    animation:
      nentry-drift 44s linear infinite reverse,
      nentry-swell 6s var(--ease-in-out) -4s infinite alternate;
  }
  :global(html.motion) .nentry__wave--3 {
    animation:
      nentry-drift 90s linear infinite,
      nentry-swell 11s var(--ease-in-out) infinite alternate;
  }
  @keyframes nentry-in {
    from {
      opacity: 0;
    }
  }
  @keyframes nentry-mark-out {
    to {
      opacity: 0;
    }
  }
  @keyframes nentry-breathe {
    50% {
      opacity: 1;
      transform: scale(1.06);
    }
  }
  @keyframes nentry-drift {
    to {
      translate: -50% 0;
    }
  }
  @keyframes nentry-swell {
    from {
      scale: 1 0.75;
    }
    to {
      scale: 1 1.15;
    }
  }
</style>
