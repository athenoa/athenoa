---
// A trial switch for the Greek handwriting (Maria, 22 November 2026: "too not serious"; she chooses from
// options shown on the page, never a list). Bottom right, on Greek pages only, and only on the preview
// (productnerd.github.io) and the dev server, never on athenoa.academy. It loads the candidates from
// Google Fonts for the trial alone; the chosen face will be shipped with the site and this file removed.
// The choice is kept in this browser (localStorage) so it follows from page to page.
---

<div class="hpick" data-hand-picker hidden>
  <button type="button" data-hand-prev aria-label="Previous handwriting">‹</button>
  <span data-hand-name></span>
  <button type="button" data-hand-next aria-label="Next handwriting">›</button>
</div>

<script>
  const FACES: [string, string][] = [
    ['Now (NF-Lolotte or the stand-in)', ''],
    ['Alegreya Italic', 'Alegreya'],
    ['Cardo Italic', 'Cardo'],
    ['Caudex Italic', 'Caudex'],
    ['Gentium Italic', 'Gentium Book Plus'],
    ['Libertinus Italic', 'Libertinus Serif'],
    ['Piazzolla Italic', 'Piazzolla'],
    ['Literata Italic', 'Literata'],
    ['Brygada 1918 Italic', 'Brygada 1918'],
    ['EB Garamond Italic', 'EB Garamond Variable'],
    ['Noto Serif Display Italic', 'Noto Serif Display Variable'],
  ];
  const KEY = 'ath-hand-trial';
  const trial = /(^|\.)productnerd\.github\.io$|^localhost$|^127\.0\.0\.1$/.test(location.hostname);

  function load() {
    if (document.getElementById('hand-trial-fonts')) return;
    const families = ['Alegreya', 'Cardo', 'Caudex', 'Gentium Book Plus', 'Libertinus Serif', 'Piazzolla', 'Literata', 'Brygada 1918']
      .map((f) => `family=${f.replace(/ /g, '+')}:ital@1`)
      .join('&');
    const link = Object.assign(document.createElement('link'), {
      id: 'hand-trial-fonts',
      rel: 'stylesheet',
      href: `https://fonts.googleapis.com/css2?${families}&display=swap`,
    });
    document.head.append(link);
  }

  function apply(i: number) {
    const [name, family] = FACES[i];
    const root = document.documentElement;
    if (family) root.style.setProperty('--font-hand', `'${family}', 'EB Garamond Variable', serif`);
    else root.style.removeProperty('--font-hand');
    // the italic faces are true italics: show them as such wherever the hand is used
    root.toggleAttribute('data-hand-trial', Boolean(family));
    const label = document.querySelector('[data-hand-name]');
    if (label) label.textContent = `${i + 1}/${FACES.length} ${name}`;
  }

  document.addEventListener('astro:page-load', () => {
    const box = document.querySelector<HTMLElement>('[data-hand-picker]');
    const greek = document.documentElement.lang === 'el';
    if (!box || !trial || !greek) {
      document.documentElement.style.removeProperty('--font-hand');
      return;
    }
    load();
    box.hidden = false;
    let i = 0;
    try {
      i = Math.max(0, Math.min(FACES.length - 1, Number(localStorage.getItem(KEY) ?? 0)));
    } catch {}
    apply(i);
    const go = (step: number) => {
      i = (i + step + FACES.length) % FACES.length;
      try {
        localStorage.setItem(KEY, String(i));
      } catch {}
      apply(i);
    };
    box.querySelector('[data-hand-prev]')?.addEventListener('click', () => go(-1));
    box.querySelector('[data-hand-next]')?.addEventListener('click', () => go(1));
  });
</script>

<style>
  .hpick {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    border-radius: 999px;
    background: var(--blue-deep);
    color: var(--creme-light, #f9f3e3);
    font: 500 0.85rem/1 system-ui, sans-serif;
    box-shadow: 0 0.3rem 1rem rgb(0 0 0 / 0.2);
  }
  .hpick[hidden] {
    display: none;
  }
  .hpick button {
    width: 1.9rem;
    height: 1.9rem;
    border: 0;
    border-radius: 50%;
    background: var(--blue-light);
    color: var(--blue-deep);
    font-size: 1.1rem;
    cursor: pointer;
  }
  .hpick span {
    min-width: 13rem;
    text-align: center;
    white-space: nowrap;
  }
  /* a trial face is a true italic */
  :global(html[data-hand-trial] .hand),
  :global(html[data-hand-trial] .t-sub) {
    font-style: italic;
  }
</style>
