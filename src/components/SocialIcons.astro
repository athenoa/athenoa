---
// Monochrome social marks in a plain row: no circles, no boxes. They take the current ink colour.
import { content } from '../data';
import { getLocale } from '../lib/locale';
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const { site, ui } = content(getLocale(Astro.url));
const icons: Record<string, string> = {
  facebook:
    'M14.2 21.5v-7.9h2.7l.4-3.3h-3.1V8.2c0-1 .3-1.6 1.7-1.6h1.5V3.7c-.3 0-1.2-.2-2.3-.2-2.4 0-4 1.5-4 4.1v2.7H8.4v3.3h2.7v7.9h3.1z',
  instagram:
    'M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM16.4 3H7.6A4.6 4.6 0 0 0 3 7.6v8.8A4.6 4.6 0 0 0 7.6 21h8.8a4.6 4.6 0 0 0 4.6-4.6V7.6A4.6 4.6 0 0 0 16.4 3zm2.9 13.4a2.9 2.9 0 0 1-2.9 2.9H7.6a2.9 2.9 0 0 1-2.9-2.9V7.6a2.9 2.9 0 0 1 2.9-2.9h8.8a2.9 2.9 0 0 1 2.9 2.9v8.8z',
  // WhatsApp (Simple Icons, CC0): opens a chat with the Academy's number (site.ts)
  whatsapp:
    'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z',
  youtube:
    'M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z',
};
---

<ul class:list={['social', className]}>
  {
    /* WhatsApp hidden for now (Maria, 23 November 2026); remove the filter to show it again */
    site.social.filter((item) => item.id !== 'whatsapp').map((item, i) => (
      <li style={`--i:${i}`}>
        <a href={item.url} rel="me noopener" target="_blank" aria-label={ui.socialOn(item.name)}>
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
            <path d={icons[item.id]} fill="currentColor" />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* A straight, even row: no tilt, no offsets */
  .social {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 0.7rem + 0.8vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .social a {
    display: block;
    padding: 0.3rem;
    color: var(--ink-strong);
    transition:
      color var(--dur-1) var(--hover-delay),
      opacity var(--dur-1) var(--hover-delay);
  }
  .social a:hover {
    opacity: 0.68;
  }
  .social svg {
    display: block;
    width: 1.6rem;
    height: 1.6rem;
  }
</style>
